namespace Whim\Math;

use Whim\Marker\NeverInline;
use Whim\Refine\Numeric;
use Whim\Unwind\InvalidArgumentException;
use Whim\_Private;
use Whim\Marker\Stub;
use Whim\Marker\TrackCaller;

/**
 * Computes a square root.
 *
 * @throws InvalidArgumentException when the number is negative.
 */
#[NeverInline]
#[TrackCaller]
function sqrt(float $number): float {
  if ($number < 0.0) {
    throw new InvalidArgumentException('$number must be non-negative');
  }

  return _Private\math_sqrt($number);
}

/** Raises Euler’s number to the given power. */
#[Stub]
#[TrackCaller]
function exp(float $number): float {}

/** Computes Euler's number raised to a power, minus one, with accuracy near zero. */
#[Stub]
#[TrackCaller]
function expm1(float $number): float {}

/** Computes a natural logarithm. */
#[Stub]
#[TrackCaller]
function ln(float $number): float {}

/** Computes the natural logarithm of one plus a number, with accuracy near zero. */
#[Stub]
#[TrackCaller]
function log1p(float $number): float {}

/**
 * Computes a logarithm in an explicit base.
 *
 * @throws InvalidArgumentException when the number is not positive, or the base is not positive or is 1.
 */
#[NeverInline]
#[TrackCaller]
function log_base(float $number, float $base): float {
  if ($number <= 0.0) {
    throw new InvalidArgumentException('$number must be positive');
  }

  if ($base <= 0.0 || 1.0 == $base) {
    throw new InvalidArgumentException('$base must be positive and not 1');
  }

  return _Private\math_log_base($number, $base);
}

/**
 * Computes a logarithm in the requested base.
 *
 * @throws InvalidArgumentException when the number is not positive, or the base is not positive or is 1.
 */
#[NeverInline]
#[TrackCaller]
function log(float $number, null|float $base = null): float {
  if ($number <= 0.0) {
    throw new InvalidArgumentException('$number must be positive');
  }

  if (null == $base) {
    return ln($number);
  }

  if ($base <= 0.0 || 1.0 == $base) {
    throw new InvalidArgumentException('$base must be positive and not 1');
  }

  return _Private\math_log_base($number, $base);
}

/** Rounds a number down to an integral value. */
#[Stub]
#[TrackCaller]
function floor(float $number): float {}

/** Rounds a number up to an integral value. */
#[Stub]
#[TrackCaller]
function ceil(float $number): float {}

/** Rounds a number to the requested precision. */
#[Stub]
#[TrackCaller]
function round(float $number, int $precision = 0): float {}

/** Computes an absolute value. */
#[TrackCaller]
function abs(Numeric $number): Numeric {
  if ($number < 0) {
    return -$number;
  }

  return $number;
}

/** Computes a sine. */
#[Stub]
#[TrackCaller]
function sin(float $number): float {}

/** Computes a cosine. */
#[Stub]
#[TrackCaller]
function cos(float $number): float {}

/** Computes a tangent. */
#[Stub]
#[TrackCaller]
function tan(float $number): float {}

/** Computes the hyperbolic tangent of a number. */
#[Stub]
#[TrackCaller]
function tanh(float $number): float {}

/** Computes an inverse sine. */
#[Stub]
#[TrackCaller]
function asin(float $number): float {}

/** Computes an inverse cosine. */
#[Stub]
#[TrackCaller]
function acos(float $number): float {}

/** Computes an inverse tangent. */
#[Stub]
#[TrackCaller]
function atan(float $number): float {}

/** Computes the angle of a Cartesian coordinate. */
#[Stub]
#[TrackCaller]
function atan2(float $y, float $x): float {}

/**
 * Parses a non-negative integer in the given base.
 *
 * @throws Whim\Unwind\InvalidArgumentException when the number contains a digit outside its base.
 * @throws Whim\Unwind\OverflowException when the converted integer does not fit in an integer.
 */
#[Stub]
#[TrackCaller]
function from_base((string&!'') $number, 2..=36 $base): (0..) {}

/**
 * Converts a number between textual bases.
 *
 * @throws Whim\Unwind\InvalidArgumentException when the number contains a digit outside its base.
 */
#[Stub]
#[TrackCaller]
function base_convert(
  (string&!'') $number,
  2..=36 $fromBase,
  2..=36 $toBase,
): (string&!'') {}
