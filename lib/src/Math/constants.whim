namespace Whim\Math;

use Whim\_Private;

/** The int max numeric constant. */
const INT_MAX = _Private\MATH_INT_MAX;

/** The int min numeric constant. */
const INT_MIN = _Private\MATH_INT_MIN;

/** The float max numeric constant. */
const FLOAT_MAX = _Private\MATH_FLOAT_MAX;

/** The float min numeric constant. */
const FLOAT_MIN = _Private\MATH_FLOAT_MIN;

/** The float epsilon numeric constant. */
const FLOAT_EPSILON = _Private\MATH_FLOAT_EPSILON;

/** The nan numeric constant. */
const NAN = _Private\MATH_NAN;

/** The inf numeric constant. */
const INF = _Private\MATH_INFINITY;

/** The infinity numeric constant. */
const INFINITY = _Private\MATH_INFINITY;

/** The e numeric constant. */
const E = _Private\MATH_E;

/** The pi numeric constant. */
const PI = _Private\MATH_PI;

/** The int64 max numeric constant. */
const INT64_MAX = INT_MAX;

/** The int64 min numeric constant. */
const INT64_MIN = INT_MIN;

/** The int53 max numeric constant. */
const INT53_MAX = 9_007_199_254_740_991;

/** The int53 min numeric constant. */
const INT53_MIN = -9_007_199_254_740_991;

/** The int32 max numeric constant. */
const INT32_MAX = 2_147_483_647;

/** The int32 min numeric constant. */
const INT32_MIN = -2_147_483_648;

/** The int16 max numeric constant. */
const INT16_MAX = 32_767;

/** The int16 min numeric constant. */
const INT16_MIN = -32_768;

/** The int8 max numeric constant. */
const INT8_MAX = 127;

/** The int8 min numeric constant. */
const INT8_MIN = -128;

/** The uint32 max numeric constant. */
const UINT32_MAX = 4_294_967_295;

/** The uint16 max numeric constant. */
const UINT16_MAX = 65_535;

/** The uint8 max numeric constant. */
const UINT8_MAX = 255;

/** The float32 max numeric constant. */
const FLOAT32_MAX = _Private\MATH_FLOAT32_MAX;

/** The float32 min numeric constant. */
const FLOAT32_MIN = _Private\MATH_FLOAT32_MIN;

/** The float64 max numeric constant. */
const FLOAT64_MAX = FLOAT_MAX;

/** The float64 min numeric constant. */
const FLOAT64_MIN = -FLOAT_MAX;
