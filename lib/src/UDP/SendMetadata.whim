namespace Whim\UDP;

use Whim\IP\Address;
use Whim\Marker\AlwaysInline;

/** Selects source-address and congestion metadata for an outgoing datagram. */
final readonly class SendMetadata {
  #[AlwaysInline]
  public function __construct(
    public Address $sourceAddress,
    public ExplicitCongestion $explicitCongestion = ExplicitCongestion::NotCapable,
    public uint $interfaceIndex = 0u,
  ) {}
}
