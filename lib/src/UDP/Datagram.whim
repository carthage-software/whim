namespace Whim\UDP;

use Whim\Marker\AlwaysInline;
use Whim\Network\InternetEndpoint;
use Whim\Refine\NonNegativeInt;

/** A received UDP datagram and its packet metadata. */
final readonly class Datagram {
  #[AlwaysInline]
  public function __construct(
    public string $bytes,
    public InternetEndpoint $peer,
    public InternetEndpoint $local,
    public ExplicitCongestion $explicitCongestion,
    public NonNegativeInt $interfaceIndex,
    public bool $truncated,
  ) {}
}
