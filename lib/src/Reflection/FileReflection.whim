namespace Whim\Reflection;

use Whim\Marker\MustUse;
use Whim\Marker\Stub;
use Whim\Reflection\Symbol\SymbolReflection;
use Whim\Symbol\SymbolKind;

/** Describes one loaded source file. */
#[Stub]
final class FileReflection implements DeclarationReflection {
  private function __construct() {}

  /** Returns the recorded source path, or null for an anonymous input. */
  #[MustUse]
  public function getPath(): null|string {}

  /** Returns where this file was loaded from. */
  #[MustUse]
  public function getOrigin(): DeclarationOrigin {}

  /** Returns the source span for a user file with a path, or null. */
  #[MustUse]
  public function getLocation(): null|SourceLocation {}

  /** Returns null; files do not have declaration documentation. */
  #[MustUse]
  public function getDocumentation(): null|string {}

  /** Returns file attributes whose instances fit the requested type. */
  #[MustUse]
  public function getAttributes<T: object = object>(
  ): vec<AttributeReflection<T>> {}

  /** Returns file attributes with the exact fully qualified class name. */
  #[MustUse]
  public function getAttributesByName(
    string $class,
  ): vec<AttributeReflection<object>> {}

  /** Returns symbols defined in this file, sorted by name. */
  #[MustUse]
  public function getSymbols(
    null|SymbolKind $kind = null,
  ): vec<SymbolReflection> {}

  /** Reports whether the source contains executable top-level statements. */
  #[MustUse]
  public function hasTopLevelCode(): bool {}
}
