namespace Whim\Reflection;

use Whim\Marker\MustUse;
use Whim\Marker\Stub;

/** Identifies the source span of a declaration. */
#[Stub]
final class SourceLocation {
  private function __construct() {}

  /** Returns the source file. */
  #[MustUse]
  public function getFile(): string {}

  /** Returns the zero-based byte offset at which the declaration starts. */
  #[MustUse]
  public function getStartOffset(): 0.. {}

  /** Returns the exclusive zero-based byte offset after the declaration. */
  #[MustUse]
  public function getEndOffset(): 0.. {}

  /** Returns the one-based line at which the declaration starts. */
  #[MustUse]
  public function getStartLine(): 1.. {}

  /** Returns the one-based column at which the declaration starts. */
  #[MustUse]
  public function getStartColumn(): 1.. {}

  /** Returns the one-based line at which the declaration ends. */
  #[MustUse]
  public function getEndLine(): 1.. {}

  /** Returns the exclusive one-based column after the declaration. */
  #[MustUse]
  public function getEndColumn(): 1.. {}
}
