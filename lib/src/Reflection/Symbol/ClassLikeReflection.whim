namespace Whim\Reflection\Symbol;

use Whim\Marker\MustUse;
use Whim\Marker\Stub;
use Whim\Reflection\Generic\GenericDeclarationReflection;
use Whim\Reflection\Member\ClassConstantReflection;
use Whim\Reflection\Member\MethodReflection;
use Whim\Reflection\Member\PropertyReflection;
use Whim\Reflection\Type\ClassTypeReflection;

/** Describes a class, interface, or enum declaration. */
#[Stub]
interface ClassLikeReflection extends
  SymbolReflection,
  GenericDeclarationReflection for
  ClassReflection,
  InterfaceReflection,
  EnumReflection {
  /** Returns this declaration applied to references to its own parameters. */
  #[MustUse]
  public function getType(): ClassTypeReflection;

  /** Returns directly declared parent and interface types. */
  #[MustUse]
  public function getDirectBaseTypes(): vec<ClassTypeReflection>;

  /** Returns every transitive parent and interface specialization. */
  #[MustUse]
  public function getBaseTypes(): vec<ClassTypeReflection>;

  /** Returns permitted direct subtype names, or null when not sealed. */
  #[MustUse]
  public function getPermittedSubtypeNames(): null|vec<string>;

  /** Returns methods declared directly by this class-like. */
  #[MustUse]
  public function getDeclaredMethods(): vec<MethodReflection>;

  /** Returns effective methods after inheritance and overriding. */
  #[MustUse]
  public function getMethods(): vec<MethodReflection>;

  /** Returns the effective method with the given name, when present. */
  #[MustUse]
  public function getMethod(string $name): null|MethodReflection;

  /** Returns properties declared directly by this class-like. */
  #[MustUse]
  public function getDeclaredProperties(): vec<PropertyReflection>;

  /** Returns the complete linked property layout. */
  #[MustUse]
  public function getProperties(): vec<PropertyReflection>;

  /** Returns the effective property with the given name, when present. */
  #[MustUse]
  public function getProperty(string $name): null|PropertyReflection;

  /** Returns constants declared directly by this class-like. */
  #[MustUse]
  public function getDeclaredConstants(): vec<ClassConstantReflection>;

  /** Returns effective constants after inheritance. */
  #[MustUse]
  public function getConstants(): vec<ClassConstantReflection>;

  /** Returns the effective constant with the given name, when present. */
  #[MustUse]
  public function getConstant(string $name): null|ClassConstantReflection;
}
