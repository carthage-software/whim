namespace Whim\Reflection\Generic;

use Whim\Marker\MustUse;
use Whim\Marker\Stub;
use Whim\Reflection\Callable\CallableReflection;
use Whim\Reflection\SourceLocation;
use Whim\Reflection\Type\TypeReflection;

/** Describes one upper bound in a callable's where clause. */
#[Stub]
final class WhereConstraintReflection {
  private function __construct() {}

  /** Returns the type parameter constrained by this clause entry. */
  #[MustUse]
  public function getParameter(): TypeParameterReflection {}

  /** Returns the upper bound with type parameters left unresolved. */
  #[MustUse]
  public function getBound(): TypeReflection {}

  /** Returns the callable that declares this constraint. */
  #[MustUse]
  public function getDeclaringCallable(): CallableReflection {}

  /** Returns the zero-based position in the callable's where clause. */
  #[MustUse]
  public function getPosition(): 0.. {}

  /** Returns the source span of this constraint, when available. */
  #[MustUse]
  public function getLocation(): null|SourceLocation {}
}
