namespace Whim\Reflection\Generic;

use Whim\Marker\MustUse;
use Whim\Marker\Stub;
use Whim\Reflection\ClosureReflection;
use Whim\Reflection\FunctionLikeReflection;
use Whim\Reflection\DeclarationReflection;
use Whim\Reflection\Member\MethodReflection;
use Whim\Reflection\ClassLikeReflection;
use Whim\Reflection\ClassReflection;
use Whim\Reflection\EnumReflection;
use Whim\Reflection\FunctionReflection;
use Whim\Reflection\InterfaceReflection;
use Whim\Reflection\NewtypeReflection;
use Whim\Reflection\TypeAliasReflection;

/** Describes a declaration that may introduce reified type parameters. */
#[Stub]
interface GenericDeclarationReflection extends
  DeclarationReflection for
  ClassLikeReflection,
  FunctionLikeReflection,
  ClassReflection,
  InterfaceReflection,
  EnumReflection,
  TypeAliasReflection,
  NewtypeReflection,
  FunctionReflection,
  MethodReflection,
  ClosureReflection {
  /** Returns the type parameters in declaration order. */
  #[MustUse]
  public function getTypeParameters(): vec<TypeParameterReflection>;

  /** Returns a type parameter by zero-based position or name, when present. */
  #[MustUse]
  public function getTypeParameter(
    int|string $parameter,
  ): null|TypeParameterReflection;
}
