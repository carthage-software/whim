namespace Whim\Reflection;

use Whim\Marker\MustUse;
use Whim\Marker\Stub;
use Whim\Reflection\Generic\GenericDeclarationReflection;
use Whim\Reflection\Generic\TypeEnvironmentReflection;
use Whim\Reflection\Generic\WhereConstraintReflection;
use Whim\Reflection\Member\MethodReflection;
use Whim\Reflection\Type\ClassTypeReflection;
use Whim\Reflection\Type\FunctionTypeReflection;
use Whim\Reflection\Type\TypeReflection;

/** Describes a function, method, or closure declaration. */
#[Stub]
interface FunctionLikeReflection extends
  GenericDeclarationReflection for
  FunctionReflection,
  MethodReflection,
  ClosureReflection {
  /** Returns the declared or synthesized name. */
  #[MustUse]
  public function getName(): string;

  /** Returns where constraints in source order, including repeated bounds. */
  #[MustUse]
  public function getWhereConstraints(): vec<WhereConstraintReflection>;

  /** Returns parameters in declaration order. */
  #[MustUse]
  public function getParameters(): vec<ParameterReflection>;

  /** Returns a parameter by zero-based position or name, when present. */
  #[MustUse]
  public function getParameter(int|string $parameter): null|ParameterReflection;

  /** Returns the number of parameters a caller must provide. */
  #[MustUse]
  public function getRequiredParameterCount(): uint;

  /** Returns the declared return type, or null when it was omitted. */
  #[MustUse]
  public function getReturnType(): null|TypeReflection;

  /** Returns the structural callable type, resolving known bindings. */
  #[MustUse]
  public function getCallableType(
    null|TypeEnvironmentReflection $environment = null,
    null|ClassTypeReflection $calledType = null,
  ): FunctionTypeReflection;
}
