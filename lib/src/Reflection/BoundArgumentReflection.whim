namespace Whim\Reflection;

use Whim\Marker\MustUse;
use Whim\Marker\Stub;
use Whim\Reflection\Type\TypeReflection;

/** Describes one argument fixed by partial function application. */
#[Stub]
final class BoundArgumentReflection {
  private function __construct() {}

  /** Returns the original parameter. */
  #[MustUse]
  public function getParameter(): ParameterReflection {}

  /** Returns the bound argument's runtime type. */
  #[MustUse]
  public function getType(): TypeReflection {}

  /** Returns the bound value. */
  #[MustUse]
  public function getValue(): mixed {}
}
