namespace Whim\Reflection\Member;

use Whim\Marker\MustUse;
use Whim\Marker\Stub;
use Whim\Reflection\AttributeReflection;
use Whim\Reflection\DeclarationOrigin;
use Whim\Reflection\SourceLocation;
use Whim\Reflection\Symbol\ClassLikeReflection;
use Whim\Reflection\Symbol\EnumReflection;
use Whim\Reflection\Type\MemberTypeReflection;

/** Describes one enum case declaration. */
#[Stub]
final class EnumCaseReflection implements MemberReflection {
  private function __construct() {}

  /** Returns where this enum case was defined. */
  #[MustUse]
  public function getOrigin(): DeclarationOrigin {}

  /** Returns this enum case's source span, when defined by user code. */
  #[MustUse]
  public function getLocation(): null|SourceLocation {}

  /** Returns this enum case's documentation text, when retained. */
  #[MustUse]
  public function getDocumentation(): null|string {}

  /** Returns attributes whose instances fit the requested type. */
  #[MustUse]
  public function getAttributes<T: object = object>(
  ): vec<AttributeReflection<T>> {}

  /** Returns attributes with the exact fully qualified class name. */
  #[MustUse]
  public function getAttributesByName(
    string $class,
  ): vec<AttributeReflection<object>> {}

  /** Returns the case name. */
  #[MustUse]
  public function getName(): string {}

  /** Returns the enum that declares this case. */
  #[MustUse]
  public function getDeclaringType(): ClassLikeReflection {}

  /** Returns the case visibility. */
  #[MustUse]
  public function getVisibility(): Visibility {}

  /** Returns the enum that declares this case. */
  #[MustUse]
  public function getEnum(): EnumReflection {}

  /** Returns the scalar backing value, when present. */
  #[MustUse]
  public function getBackingValue(): null|int|string {}

  /** Returns the shared enum-case object. */
  #[MustUse]
  public function getValue(): object {}

  /** Returns the case's member type. */
  #[MustUse]
  public function getType(): MemberTypeReflection {}
}
