namespace Whim\Enum;

use Whim\Marker\TrackCaller;
use Whim\Marker\Stub;

/** Describes an enum whose cases carry int or string values. */
#[Stub]
interface BackedEnum<T: int|string> extends UnitEnum {
  public readonly T $value;

  #[TrackCaller]
  public static function from(int|string $value): static;

  #[TrackCaller]
  public static function tryFrom(int|string $value): static|null;
}
