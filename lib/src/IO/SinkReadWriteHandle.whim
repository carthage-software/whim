namespace Whim\IO;

use Whim\Async\CancellationToken;
use Whim\Marker\AlwaysInline;
use Whim\Marker\Frameless;

/** Combines an exhausted source with a destination that discards bytes. */
final class SinkReadWriteHandle implements ReadHandle, WriteHandle {
  /** Completes immediately because the source is exhausted. */
  #[AlwaysInline]
  public function waitUntilReadable(
    null|CancellationToken $cancellation = null,
  ): void {}

  /** Always reports that the source is exhausted. */
  #[Frameless]
  public function reachedEndOfDataSource(): bool {
    return true;
  }

  /** Always returns an empty string. */
  #[AlwaysInline]
  public function tryRead(null|int $maxBytes = null): string[0] {
    return '';
  }

  /** Completes immediately because the destination is always writable. */
  #[AlwaysInline]
  public function waitUntilWritable(
    null|CancellationToken $cancellation = null,
  ): void {}

  /** Discards every byte and reports all of them accepted. */
  #[AlwaysInline]
  public function tryWrite(string $bytes): int {
    return length!($bytes);
  }

  /** Discards every byte and reports all of them written. */
  #[AlwaysInline]
  public function write(
    string $bytes,
    null|CancellationToken $cancellation = null,
  ): int {
    return length!($bytes);
  }
}
