namespace Whim\IO;

use Whim\Async\CancellationToken;
use Whim\Marker\AlwaysInline;
use Whim\Marker\Frameless;

/** Represents a source that is permanently at its end. */
final class SinkReadHandle implements ReadHandle {
  /** Completes immediately because the source is exhausted. */
  #[AlwaysInline]
  public function waitUntilReadable(
    null|CancellationToken $cancellation = null,
  ): void {}

  /** Always reports that the source is exhausted. */
  #[Frameless]
  public function reachedEndOfDataSource(): bool {
    return true;
  }

  /** Always returns an empty string. */
  #[AlwaysInline]
  public function tryRead(null|int $maxBytes = null): string {
    return '';
  }
}
