namespace Whim\Database\SQLite\_Private;

use Whim\Async\CancellationToken;
use Whim\Database\Column;
use Whim\Database\QueryException;
use Whim\Database\Result;
use Whim\Database\Row;
use Whim\Marker\MustUse;
use Whim\Marker\TrackCaller;
use Whim\Refine\NonEmptyString;
use Whim\Refine\NonNegativeInt;
use Whim\_Private\SQLiteResult;

/** Implements a database result over a SQLite row stream. */
final class ResultImpl implements Result {
  private vec<Column> $columns;

  /** Creates a result from a ready SQLite stream. */
  public function __construct(private SQLiteResult $result) {
    $columns = vec[];
    foreach ($result->columns() as $column) {
      if ($column[0] == '') {
        throw new QueryException(
          'the SQLite driver returned an empty column name',
        );
      }

      $typeName = $column[1];
      if ($typeName == '') {
        $typeName = null;
      }

      $columns[] = new Column(
        $column[0] as NonEmptyString,
        $typeName as null|NonEmptyString,
      );
    }

    $this->columns = $columns;
  }

  /** Returns column metadata in row order. */
  #[MustUse]
  public function getColumns(): vec<Column> {
    return $this->columns;
  }

  /** Returns the affected row count. */
  #[MustUse]
  public function getAffectedRows(): null|NonNegativeInt {
    return $this->result->affectedRows();
  }

  /** Fetches the next row. */
  #[MustUse]
  #[TrackCaller]
  public function fetch(null|CancellationToken $cancellation = null): null|Row {
    return fetch($this->result, $cancellation) as null|Row;
  }

  /** Reports whether this result is closed. */
  #[MustUse]
  public function isClosed(): bool {
    return $this->result->isClosed();
  }

  /** Discards unread rows and waits for the worker to retire. */
  public function close(): void {
    $this->result->close();
  }
}
