namespace Whim\Compression;

use Whim\Compression\_Private\Compressor;
use Whim\Compression\_Private\Decompressor;
use Whim\Marker\AlwaysInline;
use Whim\Marker\MustUse;
use Whim\Marker\NeverInline;
use Whim\Marker\TrackCaller;
use Whim\Marker\TraceBoundary;
use Whim\Refine\NonEmptyString;
use Whim\_Private\CompressionDecoder;
use Whim\_Private\CompressionEncoder;

/** Implements the deflate content coding with its zlib wrapper. */
final readonly class Deflate implements Codec {
  public function __construct(private 0..=9 $level = 6) {}

  #[AlwaysInline]
  #[MustUse]
  public function coding(): NonEmptyString {
    return 'deflate';
  }

  #[MustUse]
  #[NeverInline]
  #[TrackCaller]
  #[TraceBoundary]
  public function createCompressor(): Compressor {
    $encoder = CompressionEncoder::deflate($this->level);
    if ($encoder == null) {
      throw new Exception('failed to create a deflate compression stream');
    }

    return new Compressor($encoder);
  }

  #[MustUse]
  #[NeverInline]
  #[TrackCaller]
  #[TraceBoundary]
  public function createDecompressor(): Decompressor {
    $decoder = CompressionDecoder::deflate();
    if ($decoder == null) {
      throw new DecompressionException(
        'failed to create a deflate decompression stream',
      );
    }

    return new Decompressor($decoder);
  }
}
