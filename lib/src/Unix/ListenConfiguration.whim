namespace Whim\Unix;

use Whim\Default\Default;
use Whim\Marker\AlwaysInline;
use Whim\Marker\MustUse;
use Whim\Refine\PositiveInt;

/** Configures a Unix-domain listener. */
final readonly class ListenConfiguration implements Default {
  #[AlwaysInline]
  public function __construct(public PositiveInt $backlog = 512) {}

  #[AlwaysInline]
  #[MustUse]
  public static function default(): static {
    return new static();
  }

  #[AlwaysInline]
  #[MustUse]
  public function withBacklog(PositiveInt $backlog): ListenConfiguration {
    return clone!($this, backlog: $backlog);
  }
}
