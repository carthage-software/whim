namespace Whim\Unix;

use Whim\Default\Default;
use Whim\Marker\AlwaysInline;
use Whim\Marker\MustUse;
use Whim\Refine\NonZero;

/** Configures a Unix-domain listener. */
final readonly class ListenConfiguration implements Default {
  #[AlwaysInline]
  public function __construct(public NonZero<uint> $backlog = 512u) {}

  #[AlwaysInline]
  #[MustUse]
  public static function default(): self {
    return new self();
  }

  #[AlwaysInline]
  #[MustUse]
  public function withBacklog(NonZero<uint> $backlog): ListenConfiguration {
    return clone!($this, backlog: $backlog);
  }
}
