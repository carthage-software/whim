namespace Whim\Binary;

use Whim\Marker\MustUse;
use Whim\Marker\TrackCaller;

/** Reads values out of a byte string held in memory. */
interface BufferedReader extends Reader {
  /** How many bytes have been consumed. */
  #[MustUse]
  #[TrackCaller]
  public function cursor(): uint;

  /** How many bytes the buffer holds. */
  #[MustUse]
  #[TrackCaller]
  public function length(): uint;

  /** How many bytes remain unread. */
  #[MustUse]
  #[TrackCaller]
  public function remaining(): uint;
}
