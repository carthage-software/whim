namespace Whim\Message;

use Whim\Convert\ToString;
use Whim\Encoding\Hex;
use Whim\Marker\AlwaysInline;
use Whim\Marker\MustUse;
use Whim\Marker\NeverInline;
use Whim\Marker\TrackCaller;
use Whim\Refine\NonEmptyString;
use Whim\SecureRandom;
use Whim\Str;
use Whim\Unwind\InvalidArgumentException;

/** An RFC 5322 Message-ID. */
final readonly class MessageId implements ToString {
  #[AlwaysInline]
  private function __construct(public NonEmptyString $id) {}

  /** Parses a bare or bracketed Message-ID. */
  #[MustUse]
  #[TrackCaller]
  public static function parse(string $input): null|MessageId {
    $input = Str\trim($input);
    if (Str\starts_with($input, '<') && Str\ends_with($input, '>')) {
      $input = Str\slice($input, 1, length!($input) - 2);
    }

    if (
      $input == ''
      || Str\contains($input, "\r")
      || Str\contains($input, "\n")
    ) {
      return null;
    }

    return new MessageId($input as NonEmptyString);
  }

  /** Parses a Message-ID. */
  #[MustUse]
  #[NeverInline]
  #[TrackCaller]
  public static function from(string $input): MessageId {
    $id = MessageId::parse($input);
    if ($id == null) {
      throw new InvalidArgumentException('invalid Message-ID');
    }

    return $id;
  }

  /** Generates a random Message-ID. */
  #[MustUse]
  #[TrackCaller]
  public static function generate(
    NonEmptyString $domain = 'whim-lang.dev',
  ): MessageId {
    return new MessageId(
      (Hex\encode(SecureRandom\bytes(16)) . '@' . $domain) as NonEmptyString,
    );
  }

  /** Serializes the bracketed Message-ID. */
  #[AlwaysInline]
  #[MustUse]
  public function toString(): string {
    return '<' . $this->id . '>';
  }
}
