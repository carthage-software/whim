namespace Whim\Clock;

use Whim\Async\CancellationToken;
use Whim\Marker\TrackCaller;
use Whim\Time\Duration;

/** Pauses the current task for a duration. */
interface Sleeper {
  /**
   * Sleeps for a duration without blocking other tasks.
   *
   * Zero and negative durations add no delay.
   * @throws Whim\Async\CancelledException if cancellation is requested.
   */
  #[TrackCaller]
  public function sleep(
    Duration $duration,
    null|CancellationToken $cancellation = null,
  ): void;
}
