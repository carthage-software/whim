namespace Whim\IRI;

use Whim;
use Whim\Marker\AlwaysInline;
use Whim\Marker\MustUse;
use Whim\Marker\NeverInline;
use Whim\Marker\TrackCaller;
use Whim\Unwind\InvalidArgumentException;

/** Represents a bracketed IPvFuture host. */
final readonly class IPvFutureHost implements Host {
  #[AlwaysInline]
  private function __construct(public string $literal) {}

  /** Parses the text inside IPvFuture brackets, or returns null. */
  #[AlwaysInline]
  #[MustUse]
  public static function parse(string $literal): null|IPvFutureHost {
    $parts = Whim\_Private\iri_parse_authority('[' . $literal . ']');
    if (
      null == $parts
      || null != $parts[0]
      || 'future' != $parts[1]
      || $parts[2] != $literal
      || null != $parts[3]
    ) {
      return null;
    }

    return new IPvFutureHost($literal);
  }

  /** Parses the text inside IPvFuture brackets. */
  #[MustUse]
  #[NeverInline]
  #[TrackCaller]
  public static function from(string $literal): IPvFutureHost {
    $host = IPvFutureHost::parse($literal);
    if (null == $host) {
      throw new InvalidArgumentException(
        'invalid IPvFuture host: `' . $literal . '`',
      );
    }

    return $host;
  }

  /** Returns the bracketed host text. */
  #[AlwaysInline]
  #[MustUse]
  public function toString(): string {
    return '[' . $this->literal . ']';
  }
}
