namespace Whim\Process;

use Whim\Marker\AlwaysInline;
use Whim\Refine\NonNegativeInt;

/** The real and effective user identifiers of a process. */
final readonly class UserIdentity {
  #[AlwaysInline]
  public function __construct(
    public NonNegativeInt $real,
    public NonNegativeInt $effective,
  ) {}
}
