namespace Whim\Attribute;

use Whim\Marker\TrackCaller;
use Whim\Marker\Stub;

/** Returns whether an object's class carries a named attribute. */
#[Stub]
#[TrackCaller]
function has_attribute(object $object, string $attribute): bool {}

/** Returns attributes of a requested class from an object's class. */
#[Stub]
#[TrackCaller]
function get_attribute<T: object>(object $object): vec<T> {}

/** Returns every attribute attached to an object's class. */
#[Stub]
#[TrackCaller]
function get_attributes(object $object): vec<object> {}

/**
 * Returns attributes attached to a function.
 *
 * @throws Whim\Unwind\InvalidArgumentException when the named declaration does not exist.
 */
#[Stub]
#[TrackCaller]
function get_function_attributes(string $function): vec<object> {}

/**
 * Returns attributes attached to an object's method.
 *
 * @throws Whim\Unwind\InvalidArgumentException when the named declaration does not exist.
 */
#[Stub]
#[TrackCaller]
function get_method_attributes(object $object, string $method): vec<object> {}

/**
 * Returns attributes attached to an object's property.
 *
 * @throws Whim\Unwind\InvalidArgumentException when the named declaration does not exist.
 */
#[Stub]
#[TrackCaller]
function get_property_attributes(
  object $object,
  string $property,
): vec<object> {}

/**
 * Returns attributes attached to an object's class constant.
 *
 * @throws Whim\Unwind\InvalidArgumentException when the named declaration does not exist.
 */
#[Stub]
#[TrackCaller]
function get_constant_attributes(
  object $object,
  string $constant,
): vec<object> {}

/**
 * Returns attributes attached to an enum case.
 *
 * @throws Whim\Unwind\InvalidArgumentException when the named declaration does not exist.
 */
#[Stub]
#[TrackCaller]
function get_enum_case_attributes(object $case): vec<object> {}

/**
 * Returns attributes attached to a method parameter.
 *
 * @throws Whim\Unwind\InvalidArgumentException when the named declaration does not exist.
 */
#[Stub]
#[TrackCaller]
function get_parameter_attributes(
  object $object,
  string $method,
  int|string $parameter,
): vec<object> {}
