namespace Whim\BSON;

use Whim\Comparison\Equal;
use Whim\Marker\AlwaysInline;
use Whim\Marker\MustUse;
use Whim\Marker\Stub;
use Whim\Refine\Uint8;
use Whim\UUID\UUID;

/** A BSON binary value and its subtype. */
#[Stub]
final readonly class Binary implements Equal<Binary> {
  public const uint GENERIC = 0x00u;
  public const uint FUNCTION = 0x01u;
  public const uint OLD_BINARY = 0x02u;
  public const uint OLD_UUID = 0x03u;
  public const uint UUID = 0x04u;
  public const uint MD5 = 0x05u;
  public const uint ENCRYPTED = 0x06u;
  public const uint COLUMN = 0x07u;
  public const uint SENSITIVE = 0x08u;
  public const uint VECTOR = 0x09u;

  #[AlwaysInline]
  public function __construct(
    public string $bytes,
    public Uint8 $subtype = Binary::GENERIC,
  ) {}

  /** Builds standard UUID binary data. */
  #[AlwaysInline]
  #[MustUse]
  public static function fromUUID(UUID $uuid): Binary {}

  /** Returns the UUID carried by standard UUID binary data. */
  #[MustUse]
  public function toUUID(): null|UUID {}

  /** Reports whether two binary values have the same bytes and subtype. */
  #[AlwaysInline]
  #[MustUse]
  public function equals(Binary $other): bool {}
}
