namespace Whim\RandomSequence;

use Whim\Marker\MustUse;
use Whim\Marker\TrackCaller;
use Whim\Default\Default;
use Whim\SecureRandom;
use Whim\_Private;

/** Represents a secure sequence. */
final class SecureSequence implements Default, Sequence {
  /** Creates the canonical default value. */
  #[MustUse]
  #[TrackCaller]
  public static function default(): static {
    return new static();
  }

  /** Return the next value in the sequence. */
  #[TrackCaller]
  public function next(): int {
    return (
      _Private\random_int()
      ?? throw new SecureRandom\InsufficientEntropyException(
        'the operating system did not provide random bytes',
      )
    );
  }
}
