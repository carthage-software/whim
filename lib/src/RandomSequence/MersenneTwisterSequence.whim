namespace Whim\RandomSequence;

use Whim\Marker\TrackCaller;
use Whim\SecureRandom;
use Whim\Refine\Uint32;

/** Represents a mersenne twister sequence. */
final class MersenneTwisterSequence implements WordSequence {
  private vec<Uint32> $state = vec[];
  private uint $index = 624u;

  /** Creates a mersenne twister sequence. */
  #[TrackCaller]
  public function __construct(Uint32 $seed) {
    $state = vec[$seed; 624];
    $index = 1;
    while ($index < 624) {
      $previous = $state[$index - 1];
      $state[$index] =
        (1_812_433_253u * ($previous ^ ($previous >> 30)) + ($index as uint))
        & 0xff_ff_ff_ffu;

      $index++;
    }

    $this->state = $state;
  }

  /** Creates a mersenne twister sequence with a secure random seed. */
  #[TrackCaller]
  public static function fromSecureSeed(): self {
    return new MersenneTwisterSequence(
      SecureRandom\int(0, 0xff_ff_ff_ff) as uint,
    );
  }

  /** Return the next value in the sequence. */
  #[TrackCaller]
  public function nextWord(): Uint32 {
    if ($this->index >= 624) {
      $index = 0;
      while ($index < 227) {
        $this->state[$index] = $this->twist(
          $this->state[$index + 397],
          $this->state[$index],
          $this->state[$index + 1],
        );

        $index++;
      }

      while ($index < 623) {
        $this->state[$index] = $this->twist(
          $this->state[$index - 227],
          $this->state[$index],
          $this->state[$index + 1],
        );

        $index++;
      }

      $this->state[623] = $this->twist(
        $this->state[396],
        $this->state[623],
        $this->state[0],
      );

      $this->index = 0u;
    }

    $value = $this->state[$this->index as int];
    $this->index++;
    $value ^= ($value >> 11) & 0x00_1f_ff_ffu;
    $value ^= ($value << 7) & 0x9d_2c_56_80u;
    $value ^= ($value << 15) & 0xef_c6_00_00u;
    $value ^= ($value >> 18) & 0x00_00_3f_ffu;
    return $value;
  }

  #[TrackCaller]
  private function twist(Uint32 $middle, Uint32 $upper, Uint32 $lower): Uint32 {
    $parity = $lower & 1u;
    return (
      $middle
      ^ ((($upper & 0x80_00_00_00u) | ($lower & 0x7f_ff_ff_ffu)) >> 1)
      ^ (0x99_08_b0_dfu * $parity)
    );
  }
}
