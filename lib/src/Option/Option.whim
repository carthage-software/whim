namespace Whim\Option;

use Whim\Marker\TrackCaller;
use Whim\Marker\MustUse;
use Whim\Refine\Consumer;
use Whim\Refine\Predicate;
use Whim\Refine\Supplier;
use Whim\Refine\Transform;
use Whim\Result\Result;

/** Defines the behavior of option values. */
interface Option<out T> for Some, None {
  /** Reports whether the option contains a value. */
  #[MustUse]
  #[TrackCaller]
  public function isSome(): bool;

  /** Reports whether the option contains no value. */
  #[MustUse]
  #[TrackCaller]
  public function isNone(): bool;

  /** Returns the contained success value or fails. */
  #[MustUse]
  #[TrackCaller]
  public function unwrap(): T;

  /** Returns the contained value or the supplied default. */
  #[MustUse]
  #[TrackCaller]
  public function unwrapOr<D>(D $default): T|D;

  /** Returns the contained value or computes a fallback. */
  #[MustUse]
  #[TrackCaller]
  public function unwrapOrElse<D>(Supplier<D> $fallback): T|D;

  /** Transforms the contained success value. */
  #[MustUse]
  #[TrackCaller]
  public function map<U>(Transform<T, U> $function): Option<U>;

  /** Transforms the contained value or returns a default. */
  #[MustUse]
  #[TrackCaller]
  public function mapOr<U>(U $default, Transform<T, U> $function): U;

  /** Chains another operation after a successful value. */
  #[MustUse]
  #[TrackCaller]
  public function andThen<U>(Transform<T, Option<U>> $function): Option<U>;

  /** Recovers from an error or absent value. */
  #[MustUse]
  #[TrackCaller]
  public function orElse<V>(Supplier<Option<V>> $function): Option<T|V>;

  /** Retains a contained value only when it matches. */
  #[MustUse]
  #[TrackCaller]
  public function filter(Predicate<T> $predicate): Option<T>;

  /** Converts an option into a result. */
  #[MustUse]
  #[TrackCaller]
  public function okOr<E>(E $error): Result<T, E>;

  /** Observes a contained success value without changing it. */
  #[MustUse]
  #[TrackCaller]
  public function inspect(Consumer<T> $function): Option<T>;
}
