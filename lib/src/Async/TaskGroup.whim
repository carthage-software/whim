namespace Whim\Async;

use Whim\Marker\NeverInline;
use Whim\Marker\TrackCaller;
use Whim\Unwind\Throwable;
use Whim;

/** Represents a task group. */
final class TaskGroup {
  private int $pending = 0;
  private vec<Throwable> $errors = vec[];
  private vec<_Private\Waiter<null>> $waiters = vec[];

  /** Schedules a task and tracks its completion. */
  #[TrackCaller]
  public function defer(fn(): void $task): void {
    $this->pending++;
    Whim\_Private\defer_task(fn(): void {
      try {
        $task();
      } catch (Throwable $error) {
        $this->errors[] = $error;
      } finally {
        $this->pending--;
        if (0 == $this->pending) {
          $waiters = $this->waiters;
          $this->waiters = vec[];
          foreach ($waiters as $waiter) {
            if ($waiter->active) {
              $waiter->active = false;
              $waiter->suspension->resume(null);
            }
          }
        }
      }
    });
  }

  /**
   * Waits for every scheduled task and reports their failures.
   *
   * @throws CompositeException when more than one task fails; a single failure is rethrown as itself.
   * @throws CancelledException when the cancellation token is cancelled.
   */
  #[NeverInline]
  #[TrackCaller]
  public function awaitAll(null|CancellationToken $cancellation = null): void {
    if (null != $cancellation) {
      $cancellation->throwIfCancellationRequested();
    }

    if (0 != $this->pending) {
      $suspension = Whim\_Private\create_suspension::<null>();
      $waiter = new _Private\Waiter::<null>($suspension);
      $this->waiters[] = $waiter;
      $id = null;
      if (null != $cancellation) {
        $id = $cancellation->register(fn(): void {
          if (!$waiter->active) {
            return;
          }

          $waiter->active = false;
          try {
            $cancellation->throwIfCancellationRequested();
          } catch (Throwable $error) {
            $waiter->suspension->throw($error);
          }
        });
      }

      try {
        $suspension->suspend();
      } finally {
        $waiter->active = false;
        if (null != $cancellation && null != $id) {
          $cancellation->unregister($id);
        }
      }
    }

    $errors = $this->errors;
    $this->errors = vec[];
    if (length!($errors) == 1) {
      throw $errors[0];
    }

    if (length!($errors) > 1) {
      throw new CompositeException($errors);
    }
  }
}
