namespace Whim\Float;

use Whim\Binary\Endianness;
use Whim\Marker\AlwaysInline;
use Whim\Marker\MustUse;
use Whim\Marker\Stub;
use Whim\Math;
use Whim;

/** Parses a complete float string, or returns null. */
#[Stub]
#[MustUse]
function try_parse(string $value): null|float {}

/** Returns whether a float is not a number. */
#[AlwaysInline]
#[MustUse]
function is_nan(float $value): bool {
  return $value != $value;
}

/** Returns whether a float is finite. */
#[AlwaysInline]
#[MustUse]
function is_finite(float $value): bool {
  return $value >= Math\FLOAT_MIN && $value <= Math\FLOAT_MAX;
}

/** Returns whether a float is infinite. */
#[AlwaysInline]
#[MustUse]
function is_infinite(float $value): bool {
  return $value < Math\FLOAT_MIN || $value > Math\FLOAT_MAX;
}

/** Reinterprets an IEEE 754 bit pattern as a float. */
#[Stub]
#[MustUse]
function from_bits(int $bits): float {}

/** Returns the exact IEEE 754 representation as a signed integer. */
#[Stub]
#[MustUse]
function to_bits(float $value): int {}

/** Reinterprets eight bytes in the selected byte order as a float. */
#[AlwaysInline]
#[MustUse]
function from_bytes(string[8] $bytes, Endianness $endianness): float {
  return match ($endianness) {
    Endianness::Big => Whim\_Private\float_from_be_bytes($bytes),
    Endianness::Little => Whim\_Private\float_from_le_bytes($bytes),
  };
}

/** Returns the eight IEEE 754 bytes in the selected byte order. */
#[AlwaysInline]
#[MustUse]
function to_bytes(float $value, Endianness $endianness): string[8] {
  return match ($endianness) {
    Endianness::Big => Whim\_Private\float_to_be_bytes($value),
    Endianness::Little => Whim\_Private\float_to_le_bytes($value),
  };
}
