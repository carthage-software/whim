namespace Whim\MIME;

use Whim\Convert\ToString;
use Whim\Encoding\Hex;
use Whim\Marker\AlwaysInline;
use Whim\Marker\MustUse;
use Whim\Marker\NeverInline;
use Whim\Marker\TrackCaller;
use Whim\Refine\NonEmptyString;
use Whim\SecureRandom;
use Whim\Str;
use Whim\Unwind\InvalidArgumentException;

/** A MIME Content-ID and cid URI. */
final readonly class ContentId implements ToString {
  /** Creates a content ID from its bare value. */
  #[NeverInline]
  #[TrackCaller]
  public function __construct(public NonEmptyString $id) {}

  /** Parses a bare, bracketed, or cid URI value. */
  #[MustUse]
  #[TrackCaller]
  public static function parse(string $input): null|ContentId {
    $input = Str\trim($input);
    if (Str\starts_with($input, 'cid:')) {
      $input = Str\slice($input, 4);
    } else if (Str\starts_with($input, '<') && Str\ends_with($input, '>')) {
      $input = Str\slice($input, 1, length!($input) - 2);
    }

    if ($input == '') {
      return null;
    }

    return new ContentId($input as NonEmptyString);
  }

  /** Parses a content ID. */
  #[MustUse]
  #[NeverInline]
  #[TrackCaller]
  public static function from(string $input): ContentId {
    $id = ContentId::parse($input);
    if ($id == null) {
      throw new InvalidArgumentException('invalid MIME Content-ID');
    }

    return $id;
  }

  /** Generates a random content ID. */
  #[MustUse]
  #[TrackCaller]
  public static function generate(
    NonEmptyString $domain = 'whim-lang.dev',
  ): ContentId {
    return new ContentId(
      (Hex\encode(SecureRandom\bytes(16)) . '@' . $domain) as NonEmptyString,
    );
  }

  /** Serializes the bracketed header form. */
  #[AlwaysInline]
  #[MustUse]
  public function toString(): string {
    return '<' . $this->id . '>';
  }

  /** Serializes the cid URI form. */
  #[AlwaysInline]
  #[MustUse]
  public function toURI(): string {
    return 'cid:' . $this->id;
  }
}
