namespace Whim\DataStructure;

use Whim\DataStructure\_Private;
use Whim\Iterate\ToIterator;
use Whim\Iterate\ArrayIterator;
use Whim\Marker\AlwaysInline;
use Whim\Marker\TrackCaller;
use Whim\Option\Option;
use Whim\Refine\Iterable;
use Whim\Refine\NonNegativeInt;
use Whim\_Private\RingBuffer;

/** Stores values in first-in, first-out order. */
final class Queue<T> implements ToIterator<int, T> {
  private RingBuffer<T> $buffer;

  /** Creates a queue containing the yielded values. */
  #[TrackCaller]
  public function __construct(Iterable<_, T> $values = vec[]) {
    $this->buffer = new RingBuffer::<T>();
    foreach ($values as $value) {
      $this->buffer->pushBack($value);
    }
  }

  /** Adds a value to the back. */
  #[AlwaysInline]
  public function enqueue(T $value): void {
    $this->buffer->pushBack($value);
  }

  /** Removes and returns the front value. */
  #[AlwaysInline]
  public function dequeue(): Option<T> {
    return _Private\option::<T>($this->buffer->popFront());
  }

  /** Returns the front value without removing it. */
  #[AlwaysInline]
  public function peek(): Option<T> {
    return _Private\option::<T>($this->buffer->peekFront());
  }

  /** Returns the number of stored values. */
  #[AlwaysInline]
  public function count(): NonNegativeInt {
    return $this->buffer->count();
  }

  /** Reports whether the queue contains no values. */
  #[AlwaysInline]
  public function isEmpty(): bool {
    return $this->buffer->isEmpty();
  }

  /** Removes every stored value. */
  #[AlwaysInline]
  public function clear(): void {
    $this->buffer->clear();
  }

  /** Returns the values from front to back. */
  #[AlwaysInline]
  public function toVec(): vec<T> {
    return $this->buffer->toVec();
  }

  /** Creates a snapshot iterator from front to back. */
  public function toIterator(): ArrayIterator<int, T> {
    return new ArrayIterator::<int, T>($this->toVec());
  }
}
