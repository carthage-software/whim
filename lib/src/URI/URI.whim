namespace Whim\URI;

use Whim;
use Whim\Comparison\Equal;
use Whim\Convert\ToString;
use Whim\Marker\AlwaysInline;
use Whim\Marker\MustUse;
use Whim\Marker\NeverInline;
use Whim\Marker\TrackCaller;
use Whim\Unwind\InvalidArgumentException;

/** Represents an immutable RFC 3986 URI reference. */
final readonly class URI implements Equal<URI>, ToString {
  #[AlwaysInline]
  private function __construct(
    public null|string $scheme,
    public null|Authority $authority,
    public string $path,
    public null|string $query,
    public null|string $fragment,
  ) {}

  /** Parses an ASCII URI reference, or returns null when it is invalid. */
  #[AlwaysInline]
  #[MustUse]
  public static function parse(string $uri): null|URI {
    $components = Whim\_Private\uri_parse_reference($uri) ?? return null;

    $authority = match ($components[1]) {
      null => null,
      $value @ string => Authority::parse($value),
    };

    if ($components[1] != null && $authority == null) {
      return null;
    }

    return new URI(
      $components[0],
      $authority,
      $components[2],
      $components[3],
      $components[4],
    );
  }

  /** Parses an ASCII URI reference. */
  #[MustUse]
  #[NeverInline]
  #[TrackCaller]
  public static function from(string $uri): URI {
    $parsed = URI::parse($uri);
    if ($parsed == null) {
      throw new InvalidArgumentException(
        'invalid URI reference: `' . $uri . '`',
      );
    }

    return $parsed;
  }

  /** Creates a URI reference from encoded components. */
  #[MustUse]
  #[NeverInline]
  #[TrackCaller]
  public static function fromComponents(
    null|string $scheme,
    null|Authority $authority,
    string $path,
    null|string $query = null,
    null|string $fragment = null,
  ): URI {
    $authorityText = match ($authority) {
      null => null,
      $value @ Authority => $value->toString(),
    };

    if (
      !Whim\_Private\uri_valid_components(
        $scheme,
        $authorityText,
        $path,
        $query,
        $fragment,
      )
    ) {
      throw new InvalidArgumentException('invalid URI components');
    }

    return new URI($scheme, $authority, $path, $query, $fragment);
  }

  /** Returns a copy with a new scheme. */
  #[MustUse]
  #[TrackCaller]
  public function withScheme(null|string $scheme): URI {
    return URI::fromComponents(
      $scheme,
      $this->authority,
      $this->path,
      $this->query,
      $this->fragment,
    );
  }

  /** Returns a copy with a new authority. */
  #[MustUse]
  #[TrackCaller]
  public function withAuthority(null|Authority $authority): URI {
    return URI::fromComponents(
      $this->scheme,
      $authority,
      $this->path,
      $this->query,
      $this->fragment,
    );
  }

  /** Returns a copy with a new path. */
  #[MustUse]
  #[TrackCaller]
  public function withPath(string $path): URI {
    return URI::fromComponents(
      $this->scheme,
      $this->authority,
      $path,
      $this->query,
      $this->fragment,
    );
  }

  /** Returns a copy with a new query. */
  #[MustUse]
  #[TrackCaller]
  public function withQuery(null|string $query): URI {
    return URI::fromComponents(
      $this->scheme,
      $this->authority,
      $this->path,
      $query,
      $this->fragment,
    );
  }

  /** Returns a copy with a new fragment. */
  #[MustUse]
  #[TrackCaller]
  public function withFragment(null|string $fragment): URI {
    return URI::fromComponents(
      $this->scheme,
      $this->authority,
      $this->path,
      $this->query,
      $fragment,
    );
  }

  /** Returns the RFC-normalized URI reference. */
  #[AlwaysInline]
  #[MustUse]
  public function normalize(): URI {
    $normalized = Whim\_Private\uri_normalize($this->toString()) as string;
    return URI::parse($normalized) as URI;
  }

  /** Reports whether this is an absolute URI. */
  #[AlwaysInline]
  #[MustUse]
  public function isAbsolute(): bool {
    return $this->scheme != null;
  }

  /** Reports whether two URI references have the same components. */
  #[AlwaysInline]
  #[MustUse]
  public function equals(URI $other): bool {
    return $this->toString() == $other->toString();
  }

  /** Rebuilds the URI reference from its components. */
  #[AlwaysInline]
  #[MustUse]
  public function toString(): string {
    $result = match ($this->scheme) {
      null => '',
      $value @ string => $value . ':',
    };

    if ($this->authority != null) {
      $result .= '//' . $this->authority->toString();
    }

    $result .= $this->path;
    if ($this->query != null) {
      $result .= '?' . $this->query;
    }

    if ($this->fragment != null) {
      $result .= '#' . $this->fragment;
    }

    return $result;
  }
}
