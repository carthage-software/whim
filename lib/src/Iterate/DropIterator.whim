namespace Whim\Iterate;

use Whim\Refine\NonNegativeInt;

/** Lazily skips entries from another iterator. */
final class DropIterator<K, V> implements Iterator<K, V> {
  /** Creates an iterator that skips the first requested entries. */
  public function __construct(
    private Iterator<K, V> $iterator,
    private NonNegativeInt $remaining,
  ) {}

  /** Returns the next entry after the skipped prefix. */
  public function next(): null|(K, V) {
    while ($this->remaining > 0) {
      if ($this->iterator->next() == null) {
        $this->remaining = 0;
        return null;
      }

      $this->remaining--;
    }

    return $this->iterator->next();
  }
}
