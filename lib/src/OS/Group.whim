namespace Whim\OS;

use Whim\Marker\AlwaysInline;
use Whim\Refine\NonEmptyString;

/** A group record returned by the operating-system account directory. */
final readonly class Group {
  #[AlwaysInline]
  public function __construct(
    public uint $id,
    public NonEmptyString $name,
    /**
     * Names explicitly listed as members.
     *
     * Users whose primary group is this group may not appear here.
     */
    public vec<NonEmptyString> $memberNames,
  ) {}
}
