namespace Whim\OS;

use Whim\Marker\AlwaysInline;
use Whim\Refine\NonNegativeInt;

/** Total and currently available physical memory, in bytes. */
final readonly class MemoryInformation {
  #[AlwaysInline]
  public function __construct(
    public NonNegativeInt $total,
    public NonNegativeInt $available,
  ) {}
}
