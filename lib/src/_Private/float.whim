namespace Whim\_Private;

use Whim\Marker\Stub;
use Whim\Marker\TrackCaller;
use Whim\Marker\TraceBoundary;

/** Narrows a double to single precision and returns its 32 bits. */
#[Stub]
#[TrackCaller]
#[TraceBoundary]
function float_to_bits32(float $value): 0..=4_294_967_295 {}

/** Widens a single-precision value, given its 32 bits, to a double. */
#[Stub]
#[TrackCaller]
#[TraceBoundary]
function bits32_to_float(int $bits): float {}

/** Returns the big-endian IEEE 754 bytes of a float. */
#[Stub]
#[TrackCaller]
#[TraceBoundary]
function float_to_be_bytes(float $value): string[8] {}

/** Reinterprets eight big-endian IEEE 754 bytes as a float. */
#[Stub]
#[TrackCaller]
#[TraceBoundary]
function float_from_be_bytes(string[8] $bytes): float {}

/** Returns the little-endian IEEE 754 bytes of a float. */
#[Stub]
#[TrackCaller]
#[TraceBoundary]
function float_to_le_bytes(float $value): string[8] {}

/** Reinterprets eight little-endian IEEE 754 bytes as a float. */
#[Stub]
#[TrackCaller]
#[TraceBoundary]
function float_from_le_bytes(string[8] $bytes): float {}
