namespace Whim\_Private;

use Whim\Marker\MustUse;
use Whim\Marker\Stub;
use Whim\Marker\TrackCaller;
use Whim\Marker\TraceBoundary;

/** A Rust-backed HPACK encoder. */
#[Stub]
final class HpackEncoder {
  #[TrackCaller]
  #[TraceBoundary]
  private function __construct() {}

  #[MustUse]
  #[TrackCaller]
  #[TraceBoundary]
  public static function create(int $maximumTableCapacity): HpackEncoder {}

  #[TrackCaller]
  #[TraceBoundary]
  public function resize(int $capacity): void {}

  #[MustUse]
  #[TrackCaller]
  #[TraceBoundary]
  public function encode(vec<(string, string, bool)> $headers): string {}
}

/** A Rust-backed HPACK decoder. */
#[Stub]
final class HpackDecoder {
  #[TrackCaller]
  #[TraceBoundary]
  private function __construct() {}

  #[MustUse]
  #[TrackCaller]
  #[TraceBoundary]
  public static function create(int $maximumTableCapacity): HpackDecoder {}

  #[TrackCaller]
  #[TraceBoundary]
  public function resize(int $capacity): void {}

  #[MustUse]
  #[TrackCaller]
  #[TraceBoundary]
  public function decode(string $bytes): vec<(string, string, bool)> {}
}
