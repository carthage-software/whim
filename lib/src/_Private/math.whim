namespace Whim\_Private;

use Whim\Marker\TrackCaller;
use Whim\Marker\TraceBoundary;
use Whim\Marker\Stub;

/** Performs truncating integer division, or null when the quotient overflows. */
#[Stub]
#[TrackCaller]
#[TraceBoundary]
function math_div(int $numerator, int $denominator): null|int {}

/** Adds a vec of integers. */
#[Stub]
#[TrackCaller]
#[TraceBoundary]
function math_sum_ints(vec<int> $numbers): int {}

/** Adds a vec of floating-point numbers. */
#[Stub]
#[TrackCaller]
#[TraceBoundary]
function math_sum_floats(vec<float> $numbers): float {}

/** Compares two numeric values. */
#[Stub]
#[TrackCaller]
#[TraceBoundary]
function math_compare(int|float $left, int|float $right): int {}

/** Computes the square root of a float. */
#[Stub]
#[TrackCaller]
#[TraceBoundary]
function math_sqrt(float $number): float {}

/** Computes a logarithm using an explicit base. */
#[Stub]
#[TrackCaller]
#[TraceBoundary]
function math_log_base(float $number, float $base): float {}
