namespace Whim\_Private;

use Whim\Marker\TrackCaller;
use Whim\Marker\TraceBoundary;
use Whim\Marker\Stub;

/** Performs truncating integer division, or null when the quotient overflows. */
#[Stub]
#[TrackCaller]
#[TraceBoundary]
function math_div(int $numerator, int $denominator): null|int {}

/** Adds a vec of integers. */
#[Stub]
#[TrackCaller]
#[TraceBoundary]
function math_sum_ints(vec<int> $numbers): int {}

/** Adds a vec of floating-point numbers. */
#[Stub]
#[TrackCaller]
#[TraceBoundary]
function math_sum_floats(vec<float> $numbers): float {}

/** Formats a non-negative integer using a base from 2 through 36. */
#[Stub]
#[TrackCaller]
#[TraceBoundary]
function math_to_base(int $number, int $base): string&!'' {}

/** Compares two numeric values. */
#[Stub]
#[TrackCaller]
#[TraceBoundary]
function math_compare(int|float $left, int|float $right): int {}

/** Computes the square root of a float. */
#[Stub]
#[TrackCaller]
#[TraceBoundary]
function math_sqrt(float $number): float {}

/** Computes the exponential of a float. */
#[Stub]
#[TrackCaller]
#[TraceBoundary]
function math_exp(float $number): float {}

/** Computes the natural logarithm of a float. */
#[Stub]
#[TrackCaller]
#[TraceBoundary]
function math_ln(float $number): float {}

/** Rounds a float down to an integral float. */
#[Stub]
#[TrackCaller]
#[TraceBoundary]
function math_floor(float $number): float {}

/** Rounds a float up to an integral float. */
#[Stub]
#[TrackCaller]
#[TraceBoundary]
function math_ceil(float $number): float {}

/** Computes the sine of a float. */
#[Stub]
#[TrackCaller]
#[TraceBoundary]
function math_sin(float $number): float {}

/** Computes the cosine of a float. */
#[Stub]
#[TrackCaller]
#[TraceBoundary]
function math_cos(float $number): float {}

/** Computes the tangent of a float. */
#[Stub]
#[TrackCaller]
#[TraceBoundary]
function math_tan(float $number): float {}

/** Computes the inverse sine of a float. */
#[Stub]
#[TrackCaller]
#[TraceBoundary]
function math_asin(float $number): float {}

/** Computes the inverse cosine of a float. */
#[Stub]
#[TrackCaller]
#[TraceBoundary]
function math_acos(float $number): float {}

/** Computes the inverse tangent of a float. */
#[Stub]
#[TrackCaller]
#[TraceBoundary]
function math_atan(float $number): float {}

/** Computes a logarithm using an explicit base. */
#[Stub]
#[TrackCaller]
#[TraceBoundary]
function math_log_base(float $number, float $base): float {}

/** Computes the four-quadrant inverse tangent. */
#[Stub]
#[TrackCaller]
#[TraceBoundary]
function math_atan2(float $y, float $x): float {}

