namespace Whim\_Private;

use Whim\Marker\MustUse;
use Whim\Marker\Stub;
use Whim\Marker\TrackCaller;
use Whim\Marker\TraceBoundary;

/** A compiled byte-oriented regular expression. */
#[Stub]
final class Regex {
  #[TrackCaller]
  #[TraceBoundary]
  private function __construct() {}

  /** Compiles an expression, or returns null when it is invalid. */
  #[MustUse]
  #[TrackCaller]
  #[TraceBoundary]
  public static function compile(string $expression): null|Regex {}

  /** Returns the next match and its numbered and named captures. */
  #[MustUse]
  #[TrackCaller]
  #[TraceBoundary]
  public function find(
    string $subject,
    uint $offset = 0u,
  ): null|(uint, uint, dict<int|string, null|string>) {}

  /** Replaces matches with literal bytes. */
  #[MustUse]
  #[TrackCaller]
  #[TraceBoundary]
  public function replaceLiteral(
    string $subject,
    string $replacement,
    null|uint $limit = null,
  ): string {}

  /** Splits bytes around every match. */
  #[MustUse]
  #[TrackCaller]
  #[TraceBoundary]
  public function split(string $subject): vec<string> {}
}
