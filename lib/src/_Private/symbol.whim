namespace Whim\_Private;

use Whim\Marker\Stub;
use Whim\Marker\TrackCaller;
use Whim\Marker\TraceBoundary;

/** The engine's number for a class symbol. */
#[Stub]
const SYMBOL_KIND_CLASS = SYMBOL_KIND_CLASS;

/** The engine's number for an interface symbol. */
#[Stub]
const SYMBOL_KIND_INTERFACE = SYMBOL_KIND_INTERFACE;

/** The engine's number for an enum symbol. */
#[Stub]
const SYMBOL_KIND_ENUM = SYMBOL_KIND_ENUM;

/** The engine's number for a type alias. */
#[Stub]
const SYMBOL_KIND_TYPE_ALIAS = SYMBOL_KIND_TYPE_ALIAS;

/** The engine's number for a newtype. */
#[Stub]
const SYMBOL_KIND_NEWTYPE = SYMBOL_KIND_NEWTYPE;

/** The engine's number for a function symbol. */
#[Stub]
const SYMBOL_KIND_FUNCTION = SYMBOL_KIND_FUNCTION;

/** The engine's number for a namespace constant. */
#[Stub]
const SYMBOL_KIND_CONSTANT = SYMBOL_KIND_CONSTANT;

/** Installs the one callback the engine calls for a missing symbol. */
#[Stub]
#[TrackCaller]
#[TraceBoundary]
function register_symbol_autoloader(
  (fn(int, string): void) $autoloader,
): void {}

/** Asks the registered callback to load one symbol, guarded against recursion. */
#[Stub]
#[TrackCaller]
#[TraceBoundary]
function run_symbol_autoload(int $kind, string $name): void {}

/** The kind number of a declared symbol, or null when there is none. */
#[Stub]
#[TrackCaller]
#[TraceBoundary]
function get_symbol_kind(string $name): null|int {}
