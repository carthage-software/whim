namespace Whim\_Private;

use Whim\Marker\MustUse;
use Whim\Marker\Stub;

/** Stores callbacks under reusable opaque identifiers. */
#[Stub]
final class CallbackRegistry {
  public function __construct() {}

  #[MustUse]
  public function insert(fn(): void $callback): uint {}

  public function remove(uint $id): void {}

  #[MustUse]
  public function isEmpty(): bool {}

  #[MustUse]
  public function drain(): vec<fn(): void> {}
}
