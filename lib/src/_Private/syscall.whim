 * The accepted descriptor is close-on-exec and non-blocking. Wait with
 * `watch_readable` on the listening socket.
 */
#[Stub]
#[TrackCaller]
#[TraceBoundary]
function accept_socket(
  FileDescriptor $socket,
): null|(FileDescriptor, string, (0..)) {}

