/** The directory for temporary files. */
#[Stub]
#[TrackCaller]
#[TraceBoundary]
function temporary_directory(): (string&!'') {}

/**
 * Creates a new file with a generated name under `$directory` and returns
 * `(descriptor, path)`.
 *
 * One call, because the safe version is atomic: choosing a name, checking
 * that nothing holds it, and creating it are the same step. A caller that
 * builds a name first and opens it second has a window in which someone
 * else can put a symbolic link there.
 */
#[Stub]
#[TrackCaller]
#[TraceBoundary]
function create_temporary_file(
  (string&!'') $directory,
  string $prefix,
  0..=4294967295 $mode,
): (FileDescriptor, (string&!'')) {}

/** Creates a new directory with a generated name and returns its path. */
#[Stub]
#[TrackCaller]
#[TraceBoundary]
function create_temporary_directory(
  (string&!'') $directory,
  string $prefix,
): (string&!'') {}

