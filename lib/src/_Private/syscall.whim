#[TrackCaller]
#[TraceBoundary]
function read_descriptor(
  FileDescriptor $descriptor,
  (1..) $maxBytes,
): null|string {}

/** Writes as much of `$bytes` as the descriptor accepts. */
#[Stub]
#[TrackCaller]
#[TraceBoundary]
function write_descriptor(FileDescriptor $descriptor, string $bytes): (0..) {}

/** Flushes a standard stream's libc buffer; a no-op on other descriptors. */
#[Stub]
#[TrackCaller]
#[TraceBoundary]
function flush_descriptor(FileDescriptor $descriptor): void {}

/** Sets or clears non-blocking mode. */
#[Stub]
#[TrackCaller]
#[TraceBoundary]
function set_descriptor_non_blocking(
  FileDescriptor $descriptor,
  bool $enabled,
): void {}

/** Creates a pipe, readable end first. Both ends are close-on-exec. */
