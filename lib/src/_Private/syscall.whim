namespace Whim\_Private;

use Whim\Marker\Stub;
use Whim\Marker\TrackCaller;
use Whim\Marker\TraceBoundary;
use Whim\OS\FileDescriptor;
use Whim\Unwind\Error;

/**
 * A failed system call.
 *
 * `errno` is the raw platform code; compare it against the `ERRNO_*`
 * constants rather than against a literal.
 */
#[Stub]
final class SystemError extends Error {
  #[TrackCaller]
  #[TraceBoundary]
  private function __construct() {}

  /** The raw platform error number. */
  #[TrackCaller]
  #[TraceBoundary]
  public function errno(): int {}

  /** The system call that failed, such as `'openat'`. */
  #[TrackCaller]
  #[TraceBoundary]
  public function call(): (string&!'') {}
}

