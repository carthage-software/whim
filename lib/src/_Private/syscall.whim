/**
 * Replaces the running program. Returns only on failure.
 *
 * The engine has one thread, a scheduler, and live descriptors, so there is
 * no `fork`: a child is made by `spawn_process`, and this call is the one
 * way to leave the current image behind.
 */
#[Stub]
#[TrackCaller]
#[TraceBoundary]
function replace_process(
  (string&!'') $program,
  vec<string> $arguments,
  null|dict<(string&!''), string> $environment,
): never {}

/**
 * Sends a signal. A `$signal` of `0` performs the permission and existence
 * check without delivering anything.
 */
#[Stub]
#[TrackCaller]
#[TraceBoundary]
function send_signal(int $process, (0..) $signal): void {}

/** Reports whether a process identifier names a live process. */
#[Stub]
#[MustUse]
#[TrackCaller]
#[TraceBoundary]
function process_exists((1..) $process): bool {}

/**
 * Calls `$callback` each time a signal arrives.
 *
 * The engine masks the signal and delivers it through the event loop, so no
 * Whim code ever runs in handler context. `Kill` and `Stop` cannot be
 * watched and raise here. Cancel with `cancel_task`.
 */
#[Stub]
#[TrackCaller]
#[TraceBoundary]
function watch_signal((1..) $signal, (fn(): void) $callback): TaskId {}

/**
 * Starts a program and returns
 * `(processId, standardInput, standardOutput, standardError)`.
 *
 * Each element of `$streams` is `(disposition, descriptor)` for standard
 * input, output, and error in that order, using the `STREAM_DISPOSITION_*`
 * constants. A returned descriptor is present only where the disposition
 * was `STREAM_DISPOSITION_PIPE`.
 *
 * `$environment` of `null` inherits the caller's; a dict replaces it
 * entirely. `$directory` of `null` inherits the caller's.
 *
 * `$inherited` names descriptors the child keeps, each as
 * `(descriptor, childNumber)`; everything else is closed. This is how a
 * listening socket reaches a worker.
 *
 * `$processGroup` of `0` puts the child in its own group, which is what
 * lets a caller signal it and its descendants together; `-1` leaves it in
 * the caller's.
 *
 * There is no shell: `$program` is executed directly, and `$arguments` are
 * passed as written. A caller that wants a shell runs one as the program.
 */
#[Stub]
#[TrackCaller]
#[TraceBoundary]
function spawn_process(
  (string&!'') $program,
  vec<string> $arguments,
  null|dict<(string&!''), string> $environment,
  null|(string&!'') $directory,
  vec<(int, null|FileDescriptor)> $streams,
  vec<(FileDescriptor, (0..))> $inherited,
  int $processGroup,
): ((0..), null|FileDescriptor, null|FileDescriptor, null|FileDescriptor) {}

/**
 * Calls `$callback` with a child's raw wait status once it ends.
 *
 * The engine is the only party that reaps, so there is no `waitpid` here:
 * a second waiter would steal the status the first one needs. Decode the
 * status in Whim.
 */
#[Stub]
#[TrackCaller]
#[TraceBoundary]
function watch_process((0..) $process, (fn(int): void) $callback): TaskId {}

/**
 * The running system as
 * `(systemName, nodeName, release, version, machine)`.
