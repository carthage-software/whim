#[Stub]
#[TrackCaller]
#[TraceBoundary]
function system_information(): ((string&!''), string, string, string, string) {}

/** The system's uptime in milliseconds. */
#[Stub]
#[TrackCaller]
#[TraceBoundary]
function system_uptime(): (0..) {}

/** Load averages over one, five, and fifteen minutes. */
#[Stub]
#[TrackCaller]
#[TraceBoundary]
function load_averages(): (float, float, float) {}

/** Physical memory as `(total, available)` in bytes. */
#[Stub]
#[TrackCaller]
#[TraceBoundary]
function memory_information(): ((0..), (0..)) {}

/** Creates a socket. The descriptor is close-on-exec and non-blocking. */
#[Stub]
#[TrackCaller]
#[TraceBoundary]
function create_socket(int $family, int $kind): FileDescriptor {}

/** Binds a socket to a local address. */
#[Stub]
#[TrackCaller]
#[TraceBoundary]
function bind_socket(FileDescriptor $socket, string $host, (0..) $port): void {}

/** Marks a bound socket as accepting connections. */
#[Stub]
#[TrackCaller]
#[TraceBoundary]
function listen_socket(FileDescriptor $socket, (1..) $backlog): void {}

/**
 * Accepts one pending connection as `(socket, host, port)`, or `null` when
 * none is waiting.
