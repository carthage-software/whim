#[TrackCaller]
#[TraceBoundary]
function standard_descriptors(
): (FileDescriptor, FileDescriptor, FileDescriptor) {}

/** Arms the current coroutine to resume when the descriptor is readable. */
#[Stub]
#[TrackCaller]
#[TraceBoundary]
function arm_readable(FileDescriptor $descriptor): bool {}

/** Arms the current coroutine to resume when the descriptor is writable. */
#[Stub]
#[TrackCaller]
#[TraceBoundary]
function arm_writable(FileDescriptor $descriptor): bool {}

/** Parks the current coroutine until the descriptor is readable. */
#[Stub]
#[TrackCaller]
#[TraceBoundary]
function park_readable(FileDescriptor $descriptor): bool {}

/** Parks the current coroutine until the descriptor is writable. */
#[Stub]
#[TrackCaller]
#[TraceBoundary]
function park_writable(FileDescriptor $descriptor): bool {}

/** Calls `$callback` once the descriptor has bytes or reaches its end. */
#[Stub]
#[TrackCaller]
#[TraceBoundary]
function watch_readable(
  FileDescriptor $descriptor,
  (fn(): void) $callback,
): TaskId {}

/** Calls `$callback` once the descriptor can accept bytes. */
#[Stub]
#[TrackCaller]
#[TraceBoundary]
function watch_writable(
  FileDescriptor $descriptor,
  (fn(): void) $callback,
): TaskId {}

