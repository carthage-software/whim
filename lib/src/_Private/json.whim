namespace Whim\_Private;

use Whim\Marker\Stub;
use Whim\Marker\TrackCaller;
use Whim\Marker\TraceBoundary;
use Whim\Unwind\Error;

/** A failed JSON conversion; for decoding, the code is the byte offset. */
#[Stub]
final class JsonError extends Error {
  #[TrackCaller]
  #[TraceBoundary]
  private function __construct() {}
}

/** Encodes a value as JSON text; raises `JsonError` for a value JSON cannot carry. */
#[Stub]
#[TrackCaller]
#[TraceBoundary]
function json_encode(mixed $value, bool $pretty): (string&!'') {}

/** Decodes JSON text; raises `JsonError` carrying the byte offset as its code. */
#[Stub]
#[TrackCaller]
#[TraceBoundary]
function json_decode(string $json): mixed {}
