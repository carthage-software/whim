namespace Whim\_Private;

use Whim\Marker\Stub;
use Whim\Marker\TrackCaller;
use Whim\Marker\TraceBoundary;
use Whim\Refine\Uint16;

/** Parses and canonicalizes a strict network URL. */
#[Stub]
#[TrackCaller]
#[TraceBoundary]
function url_parse_reference(
  string $url,
): null|(string, string, string, null|string, null|string) {}

/** Parses a URL authority and narrows its port. */
#[Stub]
#[TrackCaller]
#[TraceBoundary]
function url_parse_authority(
  string $authority,
): null|(null|string, 'future'|'name'|'ipv4'|'ipv6', string, null|Uint16) {}
