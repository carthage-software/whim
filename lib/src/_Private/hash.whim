namespace Whim\_Private;

use Whim\Marker\SensitiveParameter;
use Whim\Marker\Stub;
use Whim\Marker\TrackCaller;
use Whim\Marker\TraceBoundary;

/** The engine's number for SHA-224. */
#[Stub]
const HASH_ALGORITHM_SHA2_224 = HASH_ALGORITHM_SHA2_224;

/** The engine's number for SHA-256. */
#[Stub]
const HASH_ALGORITHM_SHA2_256 = HASH_ALGORITHM_SHA2_256;

/** The engine's number for SHA-384. */
#[Stub]
const HASH_ALGORITHM_SHA2_384 = HASH_ALGORITHM_SHA2_384;

/** The engine's number for SHA-512. */
#[Stub]
const HASH_ALGORITHM_SHA2_512 = HASH_ALGORITHM_SHA2_512;

/** The engine's number for SHA-512/256. */
#[Stub]
const HASH_ALGORITHM_SHA2_512_256 = HASH_ALGORITHM_SHA2_512_256;

/** The engine's number for SHA3-224. */
#[Stub]
const HASH_ALGORITHM_SHA3_224 = HASH_ALGORITHM_SHA3_224;

/** The engine's number for SHA3-256. */
#[Stub]
const HASH_ALGORITHM_SHA3_256 = HASH_ALGORITHM_SHA3_256;

/** The engine's number for SHA3-384. */
#[Stub]
const HASH_ALGORITHM_SHA3_384 = HASH_ALGORITHM_SHA3_384;

/** The engine's number for SHA3-512. */
#[Stub]
const HASH_ALGORITHM_SHA3_512 = HASH_ALGORITHM_SHA3_512;

/** The engine's number for pre-standard Keccak-256. */
#[Stub]
const HASH_ALGORITHM_KECCAK_256 = HASH_ALGORITHM_KECCAK_256;

/** The engine's number for SHA-1. */
#[Stub]
const HASH_ALGORITHM_SHA1 = HASH_ALGORITHM_SHA1;

/** The engine's number for MD5. */
#[Stub]
const HASH_ALGORITHM_MD5 = HASH_ALGORITHM_MD5;

/** The engine's number for RIPEMD-160. */
#[Stub]
const HASH_ALGORITHM_RIPEMD160 = HASH_ALGORITHM_RIPEMD160;

/** The engine's number for BLAKE3. */
#[Stub]
const HASH_ALGORITHM_BLAKE3 = HASH_ALGORITHM_BLAKE3;

/** The engine's number for BLAKE2b-256. */
#[Stub]
const HASH_ALGORITHM_BLAKE2B_256 = HASH_ALGORITHM_BLAKE2B_256;

/** The engine's number for CRC-32. */
#[Stub]
const HASH_ALGORITHM_CRC32 = HASH_ALGORITHM_CRC32;

/** The engine's number for CRC-32C. */
#[Stub]
const HASH_ALGORITHM_CRC32C = HASH_ALGORITHM_CRC32C;

/** The engine's number for Adler-32. */
#[Stub]
const HASH_ALGORITHM_ADLER32 = HASH_ALGORITHM_ADLER32;

/** The engine's number for XXH64. */
#[Stub]
const HASH_ALGORITHM_XXHASH64 = HASH_ALGORITHM_XXHASH64;

/** The engine's number for XXH3-64. */
#[Stub]
const HASH_ALGORITHM_XXHASH3 = HASH_ALGORITHM_XXHASH3;

/** A running digest computation. */
#[Stub]
final class HashState {
  #[TrackCaller]
  #[TraceBoundary]
  private function __construct() {}
}

/** Digests one byte string in a single call. */
#[Stub]
#[TrackCaller]
#[TraceBoundary]
function hash_digest(
  int $algorithm,
  #[SensitiveParameter] string $bytes,
): string {}

/** Authenticates one message with a cryptographic digest. */
#[Stub]
#[TrackCaller]
#[TraceBoundary]
function hash_hmac(
  int $algorithm,
  #[SensitiveParameter] string $key,
  #[SensitiveParameter] string $message,
): string {}

/** Derives 32 bytes with PBKDF2-HMAC-SHA-256. */
#[Stub]
#[TrackCaller]
#[TraceBoundary]
function pbkdf2_sha256(
  #[SensitiveParameter] string $password,
  string $salt,
  1..=1000000 $iterations,
): string[32] {}

/** Begins an incremental digest. */
#[Stub]
#[TrackCaller]
#[TraceBoundary]
function create_hash_state(int $algorithm): HashState {}

/** Begins an incremental keyed authentication. */
#[Stub]
#[TrackCaller]
#[TraceBoundary]
function create_hmac_state(
  int $algorithm,
  #[SensitiveParameter] string $key,
): HashState {}

/** Feeds bytes into a running digest, or reports false once finished. */
#[Stub]
#[TrackCaller]
#[TraceBoundary]
function update_hash_state(
  HashState $state,
  #[SensitiveParameter] string $bytes,
): bool {}

/** Ends a digest and returns its bytes, or null once already finished. */
#[Stub]
#[TrackCaller]
#[TraceBoundary]
function finish_hash_state(HashState $state): null|string {}

/** Compares two byte strings in time independent of their contents. */
#[Stub]
#[TrackCaller]
#[TraceBoundary]
function constant_time_string_equals(
  #[SensitiveParameter] string $known,
  #[SensitiveParameter] string $given,
): bool {}
