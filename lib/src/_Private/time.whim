namespace Whim\_Private;

use Whim\Marker\Stub;
use Whim\Marker\TrackCaller;
use Whim\Marker\TraceBoundary;

/** Reads wall-clock time as seconds and nanoseconds. */
#[Stub]
#[TrackCaller]
#[TraceBoundary]
function get_system_time(): (int, uint) {}

/** Reads monotonic time as seconds and nanoseconds. */
#[Stub]
#[TrackCaller]
#[TraceBoundary]
function get_high_resolution_time(): (uint, uint) {}

/** Reads monotonic time as nanoseconds since the process clock origin. */
#[Stub]
#[TrackCaller]
#[TraceBoundary]
function get_high_resolution_nanoseconds(): uint {}
