namespace Whim\_Private;

use Whim\Marker\SensitiveParameter;
use Whim\Marker\Stub;
use Whim\Marker\TrackCaller;
use Whim\Marker\TraceBoundary;

/** Hashes a password with bcrypt, or null when the inputs are unusable. */
#[Stub]
#[TrackCaller]
#[TraceBoundary]
function password_hash_bcrypt(
  #[SensitiveParameter] string $password,
  int $cost,
  string $salt,
): null|string {}

/** Hashes a password with argon2i, or null when the inputs are unusable. */
#[Stub]
#[TrackCaller]
#[TraceBoundary]
function password_hash_argon2i(
  #[SensitiveParameter] string $password,
  int $memoryCost,
  int $timeCost,
  int $parallelism,
  string $salt,
): null|string {}

/** Hashes a password with argon2id, or null when the inputs are unusable. */
#[Stub]
#[TrackCaller]
#[TraceBoundary]
function password_hash_argon2id(
  #[SensitiveParameter] string $password,
  int $memoryCost,
  int $timeCost,
  int $parallelism,
  string $salt,
): null|string {}

/** Checks a password against a self-describing hash in constant time. */
#[Stub]
#[TrackCaller]
#[TraceBoundary]
function password_verify(
  #[SensitiveParameter] string $password,
  #[SensitiveParameter] string $hash,
): bool {}

/** Whether a hash was not made by bcrypt at exactly this cost. */
#[Stub]
#[TrackCaller]
#[TraceBoundary]
function password_needs_rehash_bcrypt(string $hash, int $cost): bool {}

/** Whether a hash was not made by argon2i at exactly these costs. */
#[Stub]
#[TrackCaller]
#[TraceBoundary]
function password_needs_rehash_argon2i(
  string $hash,
  int $memoryCost,
  int $timeCost,
  int $parallelism,
): bool {}

/** Whether a hash was not made by argon2id at exactly these costs. */
#[Stub]
#[TrackCaller]
#[TraceBoundary]
function password_needs_rehash_argon2id(
  string $hash,
  int $memoryCost,
  int $timeCost,
  int $parallelism,
): bool {}
