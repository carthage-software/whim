namespace Whim\_Private;

use Whim\Marker\Stub;
use Whim\Marker\TrackCaller;
use Whim\Marker\TraceBoundary;

/** Parses a strict RFC 3986 URI reference into its major components. */
#[Stub]
#[TrackCaller]
#[TraceBoundary]
function uri_parse_reference(
  string $uri,
): null|(null|string, null|string, string, null|string, null|string) {}

/** Parses an authority into user information, host kind, host data, and port. */
#[Stub]
#[TrackCaller]
#[TraceBoundary]
function uri_parse_authority(
  string $authority,
): null|(null|string, 'future'|'name'|'ipv4'|'ipv6', string, null|string) {}

/** Reports whether encoded URI components form one valid reference. */
#[Stub]
#[TrackCaller]
#[TraceBoundary]
function uri_valid_components(
  null|string $scheme,
  null|string $authority,
  string $path,
  null|string $query,
  null|string $fragment,
): bool {}

/** Returns RFC syntax normalization, or null when the reference is invalid. */
#[Stub]
#[TrackCaller]
#[TraceBoundary]
function uri_normalize(string $uri): null|string {}

/** Resolves a reference against an absolute base, or returns null. */
#[Stub]
#[TrackCaller]
#[TraceBoundary]
function uri_resolve(string $base, string $reference): null|string {}
