namespace Whim\_Private;

use Whim\Marker\Stub;
use Whim\Marker\TrackCaller;
use Whim\Marker\TraceBoundary;

/** Incrementally decodes strict CSV records. */
#[Stub]
final class CSVReader {
  #[TrackCaller]
  #[TraceBoundary]
  private function __construct() {}

  #[TrackCaller]
  #[TraceBoundary]
  public static function create(
    string[1] $delimiter,
    string[1] $enclosure,
  ): CSVReader {}

  #[TrackCaller]
  #[TraceBoundary]
  public function read(string $input): (uint, null|vec<string>, uint) {}
}

/** Encodes CSV records. */
#[Stub]
final class CSVWriter {
  #[TrackCaller]
  #[TraceBoundary]
  private function __construct() {}

  #[TrackCaller]
  #[TraceBoundary]
  public static function create(
    string[1] $delimiter,
    string[1] $enclosure,
    "\n"|"\r\n" $lineEnding,
  ): CSVWriter {}

  #[TrackCaller]
  #[TraceBoundary]
  public function encode(vec<string> $fields): string {}
}
