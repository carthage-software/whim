namespace Whim\HTTP\SSE\Source;

use Whim\Async\CancellationToken;
use Whim\HTTP\SSE\Event;
use Whim\Marker\MustUse;
use Whim\Marker\TrackCaller;

/** Adapts a polling function to a source with no natural end. */
final readonly class FunctionSource implements Source {
  public function __construct(
    private (fn(null|CancellationToken): vec<Event>) $poll,
  ) {}

  #[MustUse]
  #[TrackCaller]
  public function poll(
    null|CancellationToken $cancellation = null,
  ): vec<Event> {
    return ($this->poll)($cancellation);
  }

  #[MustUse]
  public function isFinished(): bool {
    return false;
  }
}
