namespace Whim\HTTP\Session\Storage;

use Whim\Async\CancellationToken;
use Whim\HTTP\Session\ConflictException;
use Whim\HTTP\Session\Data;
use Whim\HTTP\Session\Storage\_Private\Entry;
use Whim\Marker\MustUse;
use Whim\Marker\TrackCaller;
use Whim\Refine\NonEmptyString;
use Whim\Refine\NonNegativeInt;
use Whim\Time\Duration;
use Whim\Time\SystemTime;
use Whim\Unwind\InvalidArgumentException;

/** Stores sessions in the current process. */
final class MemoryStore implements Store {
  private dict<NonEmptyString, Entry> $entries = dict[];

  /** Loads an unexpired record, or null when none exists. */
  #[MustUse]
  #[TrackCaller]
  public function load(
    NonEmptyString $identifier,
    null|CancellationToken $cancellation = null,
  ): null|Record {
    $cancellation?->throwIfCancellationRequested();
    $entry = $this->getEntry($identifier);
    return match ($entry) {
      null => null,
      $entry @ Entry => $entry->record,
    };
  }

  /** Creates a record that does not already exist. */
  #[TrackCaller]
  public function create(
    NonEmptyString $identifier,
    Data $data,
    Duration $ttl,
    null|CancellationToken $cancellation = null,
  ): void {
    $cancellation?->throwIfCancellationRequested();
    $this->validateTtl($ttl);
    if ($this->getEntry($identifier) != null) {
      throw new ConflictException('the session record already exists');
    }

    $this->entries[$identifier] = new Entry(
      new Record($data, 0),
      SystemTime::now()->plus($ttl),
    );
  }

  /** Replaces a record only when its revision still matches. */
  #[TrackCaller]
  public function replace(
    NonEmptyString $identifier,
    NonNegativeInt $revision,
    Data $data,
    Duration $ttl,
    null|CancellationToken $cancellation = null,
  ): void {
    $cancellation?->throwIfCancellationRequested();
    $this->validateTtl($ttl);
    $entry = $this->getEntry($identifier);
    if ($entry == null || $entry->record->revision != $revision) {
      throw new ConflictException('the session record has changed');
    }

    $this->entries[$identifier] = new Entry(
      new Record($data, $revision + 1),
      SystemTime::now()->plus($ttl),
    );
  }

  /** Deletes a record when it exists. */
  #[TrackCaller]
  public function delete(
    NonEmptyString $identifier,
    null|CancellationToken $cancellation = null,
  ): void {
    $cancellation?->throwIfCancellationRequested();
    if (!contains_key!($this->entries, $identifier)) {
      return;
    }

    remove!($this->entries, $identifier);
  }

  /** Returns a live entry and removes expired state. */
  #[TrackCaller]
  private function getEntry(NonEmptyString $identifier): null|Entry {
    if (!contains_key!($this->entries, $identifier)) {
      return null;
    }

    $entry = $this->entries[$identifier];
    if (SystemTime::now()->compare($entry->expiresAt)->isLess()) {
      return $entry;
    }

    remove!($this->entries, $identifier);
    return null;
  }

  /** Rejects a non-positive expiry duration. */
  #[TrackCaller]
  private function validateTtl(Duration $ttl): void {
    if (!$ttl->isPositive()) {
      throw new InvalidArgumentException(
        'the session storage TTL must be positive',
      );
    }
  }
}
