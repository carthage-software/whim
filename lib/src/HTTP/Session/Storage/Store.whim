namespace Whim\HTTP\Session\Storage;

use Whim\Async\CancellationToken;
use Whim\HTTP\Session\Data;
use Whim\Marker\MustUse;
use Whim\Refine\NonEmptyString;
use Whim\Time\Duration;

/** Stores versioned server-side sessions. */
interface Store {
  /** Loads an unexpired record, or null when none exists. */
  #[MustUse]
  public function load(
    NonEmptyString $identifier,
    null|CancellationToken $cancellation = null,
  ): null|Record;

  /** Creates a record that does not already exist. */
  public function create(
    NonEmptyString $identifier,
    Data $data,
    Duration $ttl,
    null|CancellationToken $cancellation = null,
  ): void;

  /**
   * Replaces a record only when its revision still matches.
   *
   * @throws \Whim\HTTP\Session\ConflictException when the record is missing or has changed.
   */
  public function replace(
    NonEmptyString $identifier,
    uint $revision,
    Data $data,
    Duration $ttl,
    null|CancellationToken $cancellation = null,
  ): void;

  /**
   * Atomically moves an unexpired record to a new identifier at revision 0u.
   *
   * @throws \Whim\HTTP\Session\ConflictException when the old record is missing,
   * expired, or changed, or the new identifier already holds a live record.
   */
  public function rotate(
    NonEmptyString $identifier,
    uint $revision,
    NonEmptyString $newIdentifier,
    Data $data,
    Duration $ttl,
    null|CancellationToken $cancellation = null,
  ): void;

  /** Deletes a record when it exists. */
  public function delete(
    NonEmptyString $identifier,
    null|CancellationToken $cancellation = null,
  ): void;
}
