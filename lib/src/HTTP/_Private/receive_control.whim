namespace Whim\HTTP\_Private;

function receive_priority(
  State $state,
  Frame\PriorityFrame $frame,
): vec<Event\WeakendEvent> {
  if ($frame[1] == $frame[2]) {
    stream_error($frame[1], 'an HTTP/2 stream cannot depend on itself');
  }

  return vec[];
}

function receive_reset(
  State $state,
  Frame\RstStreamFrame $frame,
): vec<Event\WeakendEvent> {
  $streamState = stream_state($state, $frame[1]);
  if (StreamState::Idle == $streamState) {
    throw new ProtocolException('`RST_STREAM` cannot target an idle stream');
  }

  if (StreamState::Closed == $streamState) {
    return vec[];
  }

  close_stream($state, $frame[1]);
  return vec[(7, $frame[1], $frame[2]), (8, $frame[1])];
}

function receive_ping(
  State $state,
  Frame\PingFrame $frame,
): vec<Event\WeakendEvent> {
  if (!$frame[2]) {
    queue_frame($state, (6, $frame[1], true));
  }

  return vec[];
}

function receive_go_away(
  State $state,
  Frame\GoAwayFrame $frame,
): vec<Event\WeakendEvent> {
  if (null != $state->receivedGoAway && $frame[1] > $state->receivedGoAway) {
    throw new ProtocolException(
      'an HTTP/2 GOAWAY last stream identifier increased',
    );
  }

  $state->receivedGoAway = $frame[1];
  $state->connected = false;
  return vec[(6, $frame[1], $frame[2], $frame[3])];
}

function receive_window_update(
  State $state,
  Frame\WindowUpdateFrame $frame,
): vec<Event\WeakendEvent> {
  if (0 == $frame[1]) {
    $state->flow->updateConnectionSend($frame[2]);
  } else {
    $streamState = stream_state($state, $frame[1]);
    if (StreamState::Idle == $streamState) {
      throw new ProtocolException(
        '`WINDOW_UPDATE` cannot target an idle stream',
      );
    }

    if (StreamState::Closed == $streamState) {
      return vec[(10, $frame[1], $frame[2])];
    }

    $entry = $state->streams->get($frame[1]);
    if (null == $entry) {
      throw new ProtocolException('the HTTP/2 stream state was lost');
    }

    try {
      $state->flow->updateStreamSend($entry, $frame[2]);
    } catch (FlowControlException $error) {
      throw new StreamException(
        $error->getMessage(),
        $frame[1],
        ErrorCode::FlowControlError->value,
      );
    }
  }

  return vec[(10, $frame[1], $frame[2])];
}
