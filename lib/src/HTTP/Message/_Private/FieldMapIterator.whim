namespace Whim\HTTP\Message\_Private;

use Whim\HTTP\Message\Field;
use Whim\Iterate\Iterator;
use Whim\Marker\AlwaysInline;

/** Iterates over an HTTP field map in insertion order. */
final class FieldMapIterator implements Iterator<uint, Field> {
  private uint $index = 0u;

  /** Creates an iterator over ordered field entries. */
  #[AlwaysInline]
  public function __construct(private vec<Field> $fields) {}

  /** Returns the next field entry. */
  #[AlwaysInline]
  public function next(): null|(uint, Field) {
    if ($this->index >= length!($this->fields)) {
      return null;
    }

    $index = $this->index;
    $this->index++;

    return ($index, $this->fields[$index]);
  }
}
