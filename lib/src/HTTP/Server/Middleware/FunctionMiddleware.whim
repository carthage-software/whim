namespace Whim\HTTP\Server\Middleware;

use Whim\Async\CancellationToken;
use Whim\HTTP\Message\Request;
use Whim\HTTP\Message\Response;
use Whim\HTTP\Server\Context\Context;
use Whim\HTTP\Server\Handler\Handler;

/** Adapts a callable into a middleware. */
final readonly class FunctionMiddleware implements Middleware {
  public function __construct(
    private (fn(
      Context,
      Request,
      Handler,
      CancellationToken,
    ): Response) $handler,
  ) {}

  public function handle(
    Context $context,
    Request $request,
    Handler $next,
    CancellationToken $cancellation,
  ): Response {
    return ($this->handler)($context, $request, $next, $cancellation);
  }
}
