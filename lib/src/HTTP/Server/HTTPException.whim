namespace Whim\HTTP\Server;

use Whim\HTTP\Message\ErrorStatusCode;
use Whim\Marker\NeverInline;
use Whim\Marker\TrackCaller;
use Whim\Unwind\Throwable;

/** Carries the error status produced for a thrown request failure. */
class HTTPException extends Exception {
  #[NeverInline]
  #[TrackCaller]
  public function __construct(
    public ErrorStatusCode $status,
    string $message = '',
    int $code = 0,
    null|Throwable $previous = null,
  ) {
    parent::__construct($message, $code, $previous);
  }
}
