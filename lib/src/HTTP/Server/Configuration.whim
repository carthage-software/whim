namespace Whim\HTTP\Server;

use Whim\Default\Default;
use Whim\HTTP\_Private as H2;
use Whim\HTTP\Server\Responder\Bare;
use Whim\HTTP\Server\Responder\Responder;
use Whim\HTTP\Server\Middleware\Middleware;
use Whim\Marker\AlwaysInline;
use Whim\Marker\MustUse;
use Whim\Refine\NonZero;
use Whim\Time\Duration;

/** Configures protocol limits, timeouts, and error responses. */
final readonly class Configuration implements Default {
  #[AlwaysInline]
  public function __construct(
    public null|Duration $connectionIdleTimeout = new Duration(60, 0),
    public null|Duration $requestHeaderTimeout = new Duration(10, 0),
    public null|Duration $requestBodyTimeout = new Duration(30, 0),
    public null|Duration $responseWriteTimeout = new Duration(60, 0),
    public Duration $shutdownTimeout = new Duration(30, 0),
    public NonZero<uint> $maximumConnections = 1_000u,
    public null|NonZero<uint> $maximumConnectionsPerPeer = null,
    public NonZero<uint> $maximumConcurrentRequests = 10_000u,
    public null|uint $maximumServerPushes = 100u,
    public NonZero<uint> $maximumHeaderSize = 16_384u,
    public uint $maximumRequestBodySize = 10_485_760u,
    public NonZero<uint> $maximumRequestsPerConnection = 1_000u,
    public bool $keepAlive = true,
    public H2\Configuration $h2 = new H2\Configuration(
      rateLimiter: H2\RateLimiter::default(),
    ),
    public vec<Middleware> $middleware = vec[],
    public Responder $errorResponder = new Bare(),
  ) {}

  /** Returns the production defaults. */
  #[AlwaysInline]
  #[MustUse]
  public static function default(): self {
    return new self();
  }
}
