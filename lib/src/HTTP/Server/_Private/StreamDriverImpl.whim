namespace Whim\HTTP\Server\_Private;

use Whim\Async\CancellationToken;
use Whim\Async\CancelledException;
use Whim\Async\LinkedCancellationToken;
use Whim\HTTP\_Private as H2;
use Whim\HTTP\Server\Configuration;
use Whim\HTTP\Server\Handler\Handler;
use Whim\IO\ConcatReadHandle;
use Whim\IO\MemoryHandle;
use Whim\Marker\NeverInline;
use Whim\Marker\TraceBoundary;
use Whim\Marker\TrackCaller;
use Whim\Network\Stream;
use Whim\Str;
use Whim\TLS\Stream as TLSStream;

/** Selects HTTP/1 or HTTP/2 for one byte stream. */
final class StreamDriverImpl implements StreamDriver {
  #[NeverInline]
  #[TrackCaller]
  #[TraceBoundary]
  public function serve(
    Stream<_> $stream,
    bool $enableH2c,
    Handler $handler,
    Configuration $configuration,
    CancellationToken $draining,
    CancellationToken $forced,
  ): void {
    if ($stream is TLSStream<_>) {
      if ($stream->getConnectionState()->alpnProtocol == 'h2') {
        new H2Driver()->serve(
          $stream,
          false,
          $handler,
          $configuration,
          $draining,
          $forced,
        );
      } else {
        new H1Driver()->serve(
          $stream,
          false,
          $handler,
          $configuration,
          $draining,
          $forced,
        );
      }

      return;
    }

    if (!$enableH2c) {
      new H1Driver()->serve(
        $stream,
        false,
        $handler,
        $configuration,
        $draining,
        $forced,
      );

      return;
    }

    $prefix = '';
    $cancellation = h1_cancellation(
      new LinkedCancellationToken(vec[$draining, $forced]),
      $configuration->requestHeaderTimeout,
    );

    try {
      while (
        length!($prefix) < length!(H2\CLIENT_PREFACE)
        && Str\starts_with(H2\CLIENT_PREFACE, $prefix)
      ) {
        $bytes = match (
          $stream->read(
            length!(H2\CLIENT_PREFACE) - length!($prefix),
            $cancellation,
          )
        ) {
          '' => break,
          $bytes => $bytes,
        };

        $prefix .= $bytes;
      }
    } catch (CancelledException $error) {
      if (
        $draining->isCancellationRequested()
        || $forced->isCancellationRequested()
      ) {
        return;
      }

      throw $error;
    }

    if ($prefix == H2\CLIENT_PREFACE) {
      new H2Driver()->serveFrom(
        $stream,
        $prefix,
        $handler,
        $configuration,
        $draining,
        $forced,
      );

      return;
    }

    new H1Driver()->serveFrom(
      $stream,
      new ConcatReadHandle(new MemoryHandle($prefix), $stream),
      true,
      $handler,
      $configuration,
      $draining,
      $forced,
    );
  }
}
