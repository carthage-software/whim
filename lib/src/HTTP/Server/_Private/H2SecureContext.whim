namespace Whim\HTTP\Server\_Private;

use Whim\Async\CancellationToken;
use Whim\HTTP\_Private\StreamId;
use Whim\HTTP\Message\ProtocolVersion;
use Whim\HTTP\Server\Context\Secure;
use Whim\HTTP\Server\Context\Security;
use Whim\Network\Endpoint;

/** Adds TLS metadata to an HTTP/2 request context. */
final class H2SecureContext extends H2Context implements Secure {
  public function __construct(
    ProtocolVersion $protocolVersion,
    Endpoint $localEndpoint,
    Endpoint $peerEndpoint,
    H2Session $session,
    StreamId $streamId,
    CancellationToken $cancellation,
    public readonly Security $security,
  ) {
    parent::__construct(
      $protocolVersion,
      $localEndpoint,
      $peerEndpoint,
      $session,
      $streamId,
      $cancellation,
    );
  }
}
