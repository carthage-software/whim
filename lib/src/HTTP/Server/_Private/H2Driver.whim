namespace Whim\HTTP\Server\_Private;

use Whim\Async\CancellationToken;
use Whim\HTTP\_Private\SettingId;
use Whim\HTTP\_Private\SettingValue;
use Whim\HTTP\Message\Request;
use Whim\HTTP\Server\Configuration;
use Whim\HTTP\Server\Handler\Handler;
use Whim\HTTP\Server\Middleware\wrap;
use Whim\IO\ReadHandle;
use Whim\Marker\NeverInline;
use Whim\Marker\TraceBoundary;
use Whim\Marker\TrackCaller;
use Whim\Network\Stream;
use Whim\Unwind\Throwable;

/** Serves HTTP/2 requests over one byte stream. */
final class H2Driver implements StreamDriver {
  #[NeverInline]
  #[TrackCaller]
  #[TraceBoundary]
  public function serve(
    Stream<_> $stream,
    bool $enableH2c,
    Handler $handler,
    Configuration $configuration,
    CancellationToken $draining,
    CancellationToken $forced,
  ): void {
    $this->serveFrom($stream, '', $handler, $configuration, $draining, $forced);
  }

  /** Serves a connection after bytes have already been read from it. */
  #[NeverInline]
  #[TrackCaller]
  #[TraceBoundary]
  public function serveFrom(
    Stream<_> $stream,
    string $initialBytes,
    Handler $handler,
    Configuration $configuration,
    CancellationToken $draining,
    CancellationToken $forced,
  ): void {
    $handler = wrap($handler, $configuration->middleware);
    try {
      new H2Session(
        $stream,
        $stream,
        $handler,
        $configuration,
        $draining,
        $forced,
      )->run($initialBytes);
    } catch (Throwable $_) {
    }
  }

  /** Serves a request upgraded from HTTP/1.1 to stream one. */
  #[NeverInline]
  #[TrackCaller]
  #[TraceBoundary]
  public function serveUpgrade(
    Stream<_> $stream,
    ReadHandle $read,
    Request $request,
    dict<SettingId, SettingValue> $settings,
    Handler $handler,
    Configuration $configuration,
    CancellationToken $draining,
    CancellationToken $forced,
  ): void {
    try {
      new H2Session(
        $stream,
        $read,
        $handler,
        $configuration,
        $draining,
        $forced,
      )->runUpgrade($request, $settings);
    } catch (Throwable $_) {
    }
  }
}
