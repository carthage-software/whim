namespace Whim\SOCKS;

use Whim\Marker\AlwaysInline;
use Whim\Marker\MustUse;
use Whim\Marker\SensitiveParameter;
use Whim\Marker\TrackCaller;
use Whim\Network\Host;
use Whim\Network\Port;
use Whim\Unwind\InvalidArgumentException;

/** Configures a SOCKS5 proxy. */
final readonly class Configuration {
  #[TrackCaller]
  public function __construct(
    public Host $host,
    public Port $port = 1080,
    public null|string[1..=255] $username = null,
    #[SensitiveParameter] public null|string[1..=255] $password = null,
  ) {
    if (($username == null) != ($password == null)) {
      throw new InvalidArgumentException(
        'a SOCKS username and password must be configured together',
      );
    }
  }

  #[AlwaysInline]
  #[MustUse]
  public function withHost(Host $host): Configuration {
    return clone!($this, host: $host);
  }

  #[AlwaysInline]
  #[MustUse]
  public function withPort(Port $port): Configuration {
    return clone!($this, port: $port);
  }

  #[MustUse]
  #[TrackCaller]
  public function withCredentials(
    null|string[1..=255] $username,
    #[SensitiveParameter] null|string[1..=255] $password,
  ): Configuration {
    return new Configuration($this->host, $this->port, $username, $password);
  }
}
