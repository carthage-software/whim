class Counter {
  private int $value = 0;

  public function incrementer(): mixed {
    return fn(): int => $this->value + 1;
  }

  public function set(int $value): void {
    $this->value = $value;
  }
}

$counter = new Counter();
$increment = $counter->incrementer();
$counter->set(41);
assert!($increment() == 42);

function make(): fn(): string {
  return fn() => 1;
}

$assertion_value_40 = function(): void {
  $_ = make();
};

$assertion_error_40 = null;
try {
  $assertion_value_40();
} catch (TypeError $assertion_caught_40) {
  $assertion_error_40 = $assertion_caught_40;
  assert!(
    Whim\Str\contains(
      $assertion_caught_40->getMessage(),
      'make must return fn(): string, fn(): mixed returned',
    ),
  );
}

assert!($assertion_error_40 is TypeError);

$float = 1.5;
$float++;
assert!($float == 2.5);
$grid = vec[10];
$grid[0]++;
assert!($grid[0] == 11);

class StepCounter {
  public static int $count = 5;
}

StepCounter::$count--;
assert!(StepCounter::$count == 4);
$assertion_value_44 = function(): void {
  $letter = 'x';
  $letter++;
};

$assertion_error_44 = null;
try {
  $assertion_value_44();
} catch (IncompatibleOperandsError $assertion_caught_44) {
  $assertion_error_44 = $assertion_caught_44;
}

assert!($assertion_error_44 is IncompatibleOperandsError);

assert!(
  Str\replace_every('hello world', dict['hello' => 'world', 'world' => 'hello'])
  == 'world hello',
);

assert!(Str\replace_every('abab', dict['a' => 'b', 'b' => 'a']) == 'baba');

assert!(Str\replace_every_ci('AbAB', dict['ab' => 'x']) == 'xx');

assert!(Str\join(', ', vec['Ada', 'Grace']) == 'Ada, Grace');
assert!(Str\join(', ', dict['a' => 'Ada', 'b' => 'Grace']) == 'Ada, Grace');

assert!(Str\join(', ', vec[]) == '');

$assertion_value_51 = function(): void {
  $_ = Str\chr(256);
};

$assertion_error_51 = null;
try {
  $assertion_value_51();
} catch (TypeError $assertion_caught_51) {
  $assertion_error_51 = $assertion_caught_51;
}

assert!($assertion_error_51 is TypeError);

$assertion_value_52 = function(): void {
  $_ = Str\ord('');
};

$assertion_error_52 = null;
try {
  $assertion_value_52();
} catch (TypeError $assertion_caught_52) {
  $assertion_error_52 = $assertion_caught_52;
}

assert!($assertion_error_52 is TypeError);

assert!(Str\contains('abc', ''));
assert!(Str\starts_with('abc', ''));
assert!(Str\starts_with('', ''));
assert!(Str\ends_with('abc', ''));
assert!(Str\ends_with('', ''));
assert!(Str\starts_with_ci('abc', ''));
assert!(Str\ends_with_ci('abc', ''));
assert!(Str\search('abc', '') == 0);
assert!(Str\search_ci('abc', '') == 0);
assert!(Str\search_last('abc', '') == 3);
assert!(Str\search_last_ci('abc', '') == 3);

$assertion_value_64 = function(): void {
