$orderRecorder = new LoadingRecorder();
$firstOrderLoader = new Autoload\Autoloader()->withFallback(
  function(SymbolKind $kind, string $name) use ($orderRecorder): bool {
    $orderRecorder->seen[] = 'first asked';
    return false;
  },
);

$secondOrderLoader = new Autoload\Autoloader()->withFallback(
  function(SymbolKind $kind, string $name) use ($orderRecorder): bool {
    $orderRecorder->seen[] = 'second asked';
    return false;
  },
);

Autoload\register($firstOrderLoader);
Autoload\register($secondOrderLoader);
assert!(length!(Autoload\get_autoloaders()) == 2);
assert!(!(Autoload\load_symbol(SymbolKind::Class, 'Nowhere')));
Autoload\unregister($firstOrderLoader);
assert!(length!(Autoload\get_autoloaders()) == 1);
assert!(!(Autoload\load_symbol(SymbolKind::Class, 'Nowhere')));
assert!(
  $orderRecorder->seen == vec['first asked', 'second asked', 'second asked'],
);

Autoload\unregister($secondOrderLoader);

