  . "\n"
  . '    public const VALUE = 42;'
  . "\n"
  . '}'
  . "\n",
);

$memberTypeProbeLoader = new Autoload\Autoloader()->withSymbolFile(
  'TypeProbedMembers',
  $work . '/type-probed-members.whim',
);

Autoload\register($memberTypeProbeLoader);
assert!(!(42 is TypeProbedMembers::VALUE<int>));
