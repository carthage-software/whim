File\write(
  $work . '/reified-deep-types.whim',
  'namespace Autoloaded\\Deep\\Log;'
  . ' type Datum = null|int|vec<Datum>|dict<string, Datum>;'
  . ' type Data = dict<string, Datum>;'
  . "\n",
);

File\write(
  $work . '/reified-deep-holder.whim',
  'namespace Autoloaded\\Deep\\Log;'
  . ' use Autoloaded\\Deep\\Log\\_Private;'
  . ' use Whim\\Async\\TaskLocal;'
  . ' final readonly class Holder {'
  . ' public TaskLocal<Data> $cell;'
  . ' public function __construct() {'
  . ' $this->cell = new TaskLocal::<Data>();'
  . ' }'
  . ' public function remember(int $value): void {'
  . ' _Private\\remember($this->cell, $value);'
  . ' }'
  . ' }'
  . "\n",
);

File\write(
  $work . '/reified-deep-functions.whim',
  'namespace Autoloaded\\Deep\\Log\\_Private;'
  . ' use Autoloaded\\Deep\\Log\\Data;'
  . ' use Whim\\Async\\TaskLocal;'
  . ' function remember(TaskLocal<Data> $cell, int $value): void {'
  . ' $data = $cell->get() ?? dict[];'
  . ' $data[\'value\'] = $value;'
  . ' $cell->set($data);'
  . ' }'
  . "\n",
);

File\write(
  $work . '/reified-delayed-types.whim',
  'namespace Autoloaded\\Delayed\\Nested; type Item = int;' . "\n",
);

File\write(
  $work . '/reified-delayed-holder.whim',
  'namespace Autoloaded\\Delayed\\Nested;'
  . ' use Whim\\Async\\TaskLocal;'
  . ' final readonly class Holder {'
  . ' public TaskLocal<vec<Item>> $cell;'
  . ' public function __construct() {'
  . ' $this->cell = new TaskLocal::<vec<Item>>();'
  . ' }'
  . ' }'
  . "\n",
);

function weigh_autoloaded_deep_data(Autoloaded\Deep\Log\Data $data): int {
  return length!($data);
}

function make_autoloaded_deep_cell<T>(): Whim\Async\TaskLocal<T> {
  return new Whim\Async\TaskLocal::<T>();
}

$reifiedAliasLoader = new Autoload\Autoloader()->withSymbolFiles(dict[
  'AutoloadedReifiedClass' => $work . '/reified-class.whim',
  'AutoloadedReifiedClassHolder' => $work . '/reified-class-holder.whim',
  'AutoloadedLocalBag' => $work . '/reified-local-alias-holder.whim',
  'AutoloadedLocalAliasHolder' => $work . '/reified-local-alias-holder.whim',
  'AutoloadedCrossBag' => $work . '/reified-cross-alias.whim',
  'AutoloadedCrossEntries' => $work . '/reified-cross-entries.whim',
  'AutoloadedCrossAliasHolder' => $work . '/reified-cross-alias-holder.whim',
  'Autoloaded\\Deep\\Log\\Datum' => $work . '/reified-deep-types.whim',
  'Autoloaded\\Deep\\Log\\Data' => $work . '/reified-deep-types.whim',
  'Autoloaded\\Deep\\Log\\Holder' => $work . '/reified-deep-holder.whim',
  'Autoloaded\\Deep\\Log\\_Private\\remember' => $work
  . '/reified-deep-functions.whim',
  'Autoloaded\\Delayed\\Nested\\Item' => $work . '/reified-delayed-types.whim',
  'Autoloaded\\Delayed\\Nested\\Holder' => $work
  . '/reified-delayed-holder.whim',
]);

Autoload\register($reifiedAliasLoader);
discard!(new AutoloadedReifiedClassHolder());
discard!(new AutoloadedLocalAliasHolder());
discard!(new AutoloadedCrossAliasHolder());
discard!(new Autoloaded\Delayed\Nested\Holder());
assert!(weigh_autoloaded_deep_data(dict[]) == 0);
$deepGenericCell = make_autoloaded_deep_cell::<Autoloaded\Deep\Log\Data>();
$deepGenericCell->set(dict[]);
assert!($deepGenericCell->get() == dict[]);
$deepHolder = new Autoloaded\Deep\Log\Holder();
$deepHolder->remember(42);
assert!($deepHolder->cell->get() == dict['value' => 42]);
Autoload\unregister($reifiedAliasLoader);

