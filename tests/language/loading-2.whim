Autoload\unregister($memberTypeProbeLoader);

File\write(
  $work . '/loaded-cell.whim',
  'final readonly class LoadedCell<T> {'
  . "\n"
  . '    public function __construct(public T $value) {}'
  . "\n"
  . '}'
  . "\n",
);

File\write(
  $work . '/loaded-identity.whim',
  'function loaded_identity<T>(T $value): T { return $value; }' . "\n",
);

$genericCachesLoader = new Autoload\Autoloader()->withSymbolFiles(dict[
  'LoadedCell' => $work . '/loaded-cell.whim',
  'loaded_identity' => $work . '/loaded-identity.whim',
]);

Autoload\register($genericCachesLoader);

function wrap_loaded<T>(T $value): LoadedCell<T> {
  return new LoadedCell::<T>(loaded_identity::<T>($value));
}

$wrappedInteger = wrap_loaded::<int>(42);
$wrappedString = wrap_loaded::<string>('loaded');
$wrappedIntegerSatisfied = $wrappedInteger is LoadedCell<int>;
assert!($wrappedIntegerSatisfied);
assert!($wrappedInteger->value == 42);
$wrappedStringSatisfied = $wrappedString is LoadedCell<string>;
assert!($wrappedStringSatisfied);
assert!($wrappedString->value == 'loaded');
Autoload\unregister($genericCachesLoader);

