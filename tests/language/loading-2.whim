use Whim\Autoload;
use Whim\File;
use Whim\Filesystem;
use Whim\Symbol;
use Whim\Symbol\SymbolKind;
use Whim\Unwind\TypeError;
use Whim\Unwind\UndefinedSymbolError;

final class LoadingRecorder {
  public vec<string> $seen = vec[];
}

$work = Filesystem\canonicalize(
  Filesystem\create_temporary_directory(null, 'whim-test-'),
);

File\write(
  $work . '/map-widget.whim',
  'class MapWidget { public function id(): int { return 7; } }' . "\n",
);

File\write(
  $work . '/map-make.whim',
  'function map_make_widget(): string { return \'made\'; }' . "\n",
);

File\write($work . '/map-limit.whim', 'const MAP_WIDGET_LIMIT = 9;' . "\n");
File\write($work . '/map-kind.whim', 'type MapWidgetKind = int|string;' . "\n");
$mapKindsLoader = new Autoload\Autoloader()->withSymbolFiles(dict[
  'MapWidget' => $work . '/map-widget.whim',
  'map_make_widget' => $work . '/map-make.whim',
  'MAP_WIDGET_LIMIT' => $work . '/map-limit.whim',
  'MapWidgetKind' => $work . '/map-kind.whim',
]);

Autoload\register($mapKindsLoader);
$mapWidget = new MapWidget();
assert!($mapWidget->id() == 7);
assert!(map_make_widget() == 'made');
assert!(MAP_WIDGET_LIMIT == 9);
$mapAliasSatisfied = 5 is MapWidgetKind;
assert!($mapAliasSatisfied);
Autoload\unregister($mapKindsLoader);

File\write(
  $work . '/type-probed-function.whim',
  'function TypeProbedFunction(): void {}' . "\n",
);

File\write(
  $work . '/type-probed-constant.whim',
  'const TYPE_PROBED_CONSTANT = 42;' . "\n",
);

$typeProbeLoader = new Autoload\Autoloader()->withSymbolFiles(dict[
  'TypeProbedFunction' => $work . '/type-probed-function.whim',
  'TYPE_PROBED_CONSTANT' => $work . '/type-probed-constant.whim',
]);

Autoload\register($typeProbeLoader);
$identityFunction = fn(mixed $value): mixed => $value;
assert!(!($identityFunction is TypeProbedFunction));
assert!(Symbol\get_kind('TypeProbedFunction') == SymbolKind::Function);

assert!(42 is TYPE_PROBED_CONSTANT);
assert!(Symbol\get_kind('TYPE_PROBED_CONSTANT') == SymbolKind::Constant);

Autoload\unregister($typeProbeLoader);

File\write(
  $work . '/type-probed-members.whim',
