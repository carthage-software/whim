$chainRecorder = new LoadingRecorder();
$firstChainLoader = new Autoload\Autoloader()->withFallback(
  function(SymbolKind $kind, string $name) use ($chainRecorder): bool {
    $chainRecorder->seen[] = 'first:' . $kind->name . ':' . $name;
    return false;
  },
);

$secondChainLoader = new Autoload\Autoloader()->withFallback(
  function(SymbolKind $kind, string $name) use ($chainRecorder): bool {
    $chainRecorder->seen[] = 'second:' . $kind->name . ':' . $name;
    return true;
  },
);

$thirdChainLoader = new Autoload\Autoloader()->withFallback(
  function(SymbolKind $kind, string $name) use ($chainRecorder): bool {
    $chainRecorder->seen[] = 'third: never';
    return true;
  },
);

Autoload\register($firstChainLoader);
Autoload\register($secondChainLoader);
Autoload\register($thirdChainLoader);
$assertion_value_20 = function(): void {
  missing_function();
};

$assertion_error_20 = null;
try {
  $assertion_value_20();
} catch (UndefinedSymbolError $assertion_caught_20) {
  $assertion_error_20 = $assertion_caught_20;
  assert!(
    Whim\Str\contains($assertion_caught_20->getMessage(), 'missing_function'),
  );
}

assert!($assertion_error_20 is UndefinedSymbolError);

assert!(
  $chainRecorder->seen == vec[
    'first:Function:missing_function',
    'second:Function:missing_function',
    'first:Newtype:missing_function',
    'second:Newtype:missing_function',
  ],
);

Autoload\unregister($firstChainLoader);
Autoload\unregister($secondChainLoader);
Autoload\unregister($thirdChainLoader);

File\write($work . '/hollow.whim', '$unused = 1;' . "\n");
