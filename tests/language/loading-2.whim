const KIND_LIMIT = 1;

function kind_helper(): void {}

class KindShape {}

enum KindSuit {
  case Hearts;
}

interface KindCountable {}

type KindScalar = int|string;

newtype KindUserId = int;

assert!(Symbol\get_kind('KIND_LIMIT')->name == 'Constant');
assert!(Symbol\get_kind('kind_helper')->name == 'Function');
assert!(Symbol\get_kind('KindShape')->name == 'Class');
assert!(Symbol\get_kind('KindSuit')->name == 'Enum');
assert!(Symbol\get_kind('KindCountable')->name == 'Interface');
assert!(Symbol\get_kind('\\KindScalar')->name == 'TypeAlias');
assert!(Symbol\get_kind('KindUserId')->name == 'Newtype');
