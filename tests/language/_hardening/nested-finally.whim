                                                                                                                  try {
                                                                                                                    try {
                                                                                                                      try {
                                                                                                                        try {
                                                                                                                          return 42;
                                                                                                                        } finally {
                                                                                                                          Order::$trace .= 'f0 ';
                                                                                                                        }
                                                                                                                      } finally {
                                                                                                                        Order::$trace .= 'f1 ';
                                                                                                                      }
                                                                                                                    } finally {
                                                                                                                      Order::$trace .= 'f2 ';
                                                                                                                    }
                                                                                                                  } finally {
                                                                                                                    Order::$trace .= 'f3 ';
                                                                                                                  }
                                                                                                                } finally {
                                                                                                                  Order::$trace .= 'f4 ';
                                                                                                                }
                                                                                                              } finally {
                                                                                                                Order::$trace .= 'f5 ';
                                                                                                              }
                                                                                                            } finally {
                                                                                                              Order::$trace .= 'f6 ';
                                                                                                            }
                                                                                                          } finally {
                                                                                                            Order::$trace .= 'f7 ';
                                                                                                          }
                                                                                                        } finally {
                                                                                                          Order::$trace .= 'f8 ';
                                                                                                        }
                                                                                                      } finally {
                                                                                                        Order::$trace .= 'f9 ';
                                                                                                      }
                                                                                                    } finally {
                                                                                                      Order::$trace .= 'f10 ';
                                                                                                    }
                                                                                                  } finally {
                                                                                                    Order::$trace .= 'f11 ';
