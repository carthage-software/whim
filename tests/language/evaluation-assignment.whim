$long = vec[];
$index = 0;
while ($index < 300) {
  $long[] = $index;
  $index = $index + 1;
}

($leader, ...$remainder) = $long;
assert!($leader == 0);
assert!(length!($remainder) == 299);
assert!($remainder[298] == 299);

$tupleSource = (1, 2, 3);
($tupleSource, $selfSecond, $selfThird) = $tupleSource;
assert!(($tupleSource, $selfSecond, $selfThird) == (1, 2, 3));

$list = vec[10, 20, 30];
($list, ...$listTail) = $list;
assert!($list == 10);
assert!($listTail == vec[20, 30]);

$again = vec[4, 5, 6];
($againHead, $again, ...$againRest) = $again;
assert!($againHead == 4);
assert!($again == 5);
assert!(length!($againRest) == 1);

$outerSource = (vec[7, 8], 9);
(($outerSource, $outerSecond), $outerThird) = $outerSource;
assert!(($outerSource, $outerSecond, $outerThird) == (7, 8, 9));

($a, $b) = vec[1, 2];
assert!(($a, $b) == (1, 2));
($c, $d) = (1, 2);
assert!(($c, $d) == (1, 2));
(($e, $f), $g) = (vec[1, 2], 3);
assert!(($e, $f, $g) == (1, 2, 3));
(($h, $i), $j) = vec[(4, 5), 6];
assert!(($h, $i, $j) == (4, 5, 6));

$pairs = vec[];
foreach (vec[vec[1, 2], vec[3, 4]] as ($pairFirst, $pairSecond)) {
  $pairs[] = $pairFirst . '-' . $pairSecond;
}

assert!($pairs == vec['1-2', '3-4']);

final class AssignmentPropertyBuffer {
  public vec<int> $items = vec[];

  public function push(mixed $value): void {
    $this->items[] = $value;
  }

  public function set(int $index, mixed $value): void {
    $this->items[$index] = $value;
  }
}

$propertyBuffer = new AssignmentPropertyBuffer();
$propertyBuffer->push(1);
$propertySnapshot = $propertyBuffer->items;
$propertyBuffer->push(2);
assert!($propertySnapshot == vec[1]);
assert!($propertyBuffer->items == vec[1, 2]);
$assertion_value_99 = function() use ($propertyBuffer): void {
  $propertyBuffer->push('bad');
};

$assertion_error_99 = null;
try {
  $assertion_value_99();
} catch (TypeError $assertion_caught_99) {
  $assertion_error_99 = $assertion_caught_99;
}

assert!($assertion_error_99 is TypeError);

assert!($propertyBuffer->items == vec[1, 2]);

$propertyIndexSnapshot = $propertyBuffer->items;
$propertyBuffer->set(0, 3);
assert!($propertyIndexSnapshot == vec[1, 2]);
assert!($propertyBuffer->items == vec[3, 2]);
$assertion_value_103 = function() use ($propertyBuffer): void {
  $propertyBuffer->set(0, 'bad');
};

$assertion_error_103 = null;
try {
  $assertion_value_103();
} catch (TypeError $assertion_caught_103) {
  $assertion_error_103 = $assertion_caught_103;
}

assert!($assertion_error_103 is TypeError);

assert!($propertyBuffer->items == vec[3, 2]);

final class AssignmentPropertyDictionary {
  public dict<string, int> $items = dict['first' => 1];

  public function set(mixed $key, mixed $value): void {
    $this->items[$key] = $value;
  }

  public function setComputed(int $key, int $value): void {
    $this->items['key-' . $key] = $value;
  }

  public function setWith(fn(): string $key, int $value): void {
    $this->items[$key()] = $value;
  }
}

$propertyDictionary = new AssignmentPropertyDictionary();
$propertyDictionary->set('second', 2);
assert!($propertyDictionary->items == dict['first' => 1, 'second' => 2]);

$assertion_value_106 = function() use ($propertyDictionary): void {
  $propertyDictionary->set(3, 3);
};

$assertion_error_106 = null;
try {
  $assertion_value_106();
} catch (TypeError $assertion_caught_106) {
  $assertion_error_106 = $assertion_caught_106;
}

assert!($assertion_error_106 is TypeError);

$assertion_value_107 = function() use ($propertyDictionary): void {
  $propertyDictionary->set('first', 'bad');
};

$assertion_error_107 = null;
try {
  $assertion_value_107();
} catch (TypeError $assertion_caught_107) {
  $assertion_error_107 = $assertion_caught_107;
}

assert!($assertion_error_107 is TypeError);

assert!($propertyDictionary->items == dict['first' => 1, 'second' => 2]);

$assertion_value_109 = function() use ($propertyDictionary): void {
  $propertyDictionary->setWith(function(): string {
    throw new TypeError('computed key failed');
  }, 3);
};

$assertion_error_109 = null;
try {
  $assertion_value_109();
} catch (TypeError $assertion_caught_109) {
  $assertion_error_109 = $assertion_caught_109;
}

assert!($assertion_error_109 is TypeError);

assert!($propertyDictionary->items == dict['first' => 1, 'second' => 2]);

$propertyDictionarySnapshot = $propertyDictionary->items;
for ($index = 0; $index < 2000; $index++) {
  $propertyDictionary->setComputed($index, $index);
}

assert!($propertyDictionarySnapshot == dict['first' => 1, 'second' => 2]);
assert!(length!($propertyDictionary->items) == 2002);

$propertyAppendScale = new AssignmentPropertyBuffer();
for ($index = 0; $index < 50000; $index++) {
  $propertyAppendScale->push($index);
}

assert!(length!($propertyAppendScale->items) == 50000);
