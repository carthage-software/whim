$selected = match (dict['id' => 7, 'label' => 'seven']) {
  dict['id' => $matchedIdentifier, 'label' => $matchedLabel] @ dict<
    string,
    mixed,
  > => ($matchedIdentifier, $matchedLabel),
  $_ => null,
};

assert!($selected == (7, 'seven'));

$vector = vec[1, 2, 3, 4];
($a, $b, ...$rest) = $vector;
assert!(($a, $b) == (1, 2));
assert!($rest == vec[3, 4]);

$triple = (9, 8, 7);
($first, ...$tail) = $triple;
assert!($first == 9);
assert!(length!($tail) == 2);
assert!($tail[0] == 8);
assert!($tail[1] == 7);

($a, $b, ...$emptyRest) = vec[1, 2];
assert!(length!($emptyRest) == 0);

($only, ...) = $vector;
assert!($only == 1);

(($head, ...$innerRest), $label) = (vec[1, 2, 3], 'end');
assert!($head == 1);
assert!(length!($innerRest) == 2);
assert!($label == 'end');

$assertion_value_76 = function(): void {
  ($p, $q) = vec[1, 2, 3];
};

$assertion_error_76 = null;
try {
  $assertion_value_76();
} catch (TypeError $assertion_caught_76) {
  $assertion_error_76 = $assertion_caught_76;
  assert!(
    Whim\Str\contains(
      $assertion_caught_76->getMessage(),
      'destructuring requires a vec or tuple of 2 elements, a vec of 3 given',
    ),
  );
}

assert!($assertion_error_76 is TypeError);

