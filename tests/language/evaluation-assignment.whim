use Whim\File;
use Whim\Filesystem;
use Whim\Unwind\CompilerError;
use Whim\Unwind\OutOfBoundsError;
use Whim\Unwind\TypeError;

$number = 10;
$number += 5;
assert!($number == 15);
$number -= 3;
assert!($number == 12);
$number *= 2;
assert!($number == 24);
$number /= 6;
assert!($number == 4.0);
$remainder = 7;
$remainder %= 4;
assert!($remainder == 3);
$text = 'a';
$text .= 'b';
assert!($text == 'ab');
$bits = 6;
$bits &= 3;
assert!($bits == 2);
$bits |= 8;
assert!($bits == 10);
$bits ^= 2;
assert!($bits == 8);
$bits <<= 2;
assert!($bits == 32);
$bits >>= 1;
assert!($bits == 16);

final class TickLog {
  public static int $count = 0;
}

function tick(): int {
  TickLog::$count++;
  return 0;
}

$container = vec[10];
$container[tick()] += 1;
assert!(TickLog::$count == 1);
assert!($container[0] == 11);

$target = 0;
$assigned = ($target = 5);
assert!($assigned == 5);
assert!($target == 5);
$slots = vec[0];
assert!(($slots[0] = 9) == 9);
assert!($slots[0] == 9);

final class NullSafeAssignmentSource {
  public function value(): int {
    return 42;
  }
}

function assign_nullsafe(null|NullSafeAssignmentSource $source): null|int {
  $value = $source?->value();
  return $value;
}

assert!(assign_nullsafe(new NullSafeAssignmentSource()) == 42);
assert!(assign_nullsafe(null) == null);

final class BoomLog {
  public static int $count = 0;
}

function boom(): bool {
  BoomLog::$count++;
  return true;
}

$conjunction = false;
$conjunction &&= boom();
assert!(!($conjunction));
$disjunction = true;
$disjunction ||= boom();
assert!($disjunction);
$kept = 'kept';
$kept ??= 'replacement' . boom();
assert!($kept == 'kept');
$empty = null;
$empty ??= 'filled';
assert!($empty == 'filled');
assert!(BoomLog::$count == 0);

($a, $b) = (1, 2);
assert!(($a, $b) == (1, 2));
($x, ($y, $z)) = ('p', ('q', 'r'));
assert!($x . $y . $z == 'pqr');
($v, $w) = vec[3, 4];
assert!(($v, $w) == (3, 4));
$assertion_value_26 = function(): void {
  ($u, $t) = (1, 2, 3);
};

$assertion_error_26 = null;
try {
  $assertion_value_26();
} catch (TypeError $assertion_caught_26) {
  $assertion_error_26 = $assertion_caught_26;
}

assert!($assertion_error_26 is TypeError);

$assertion_value_27 = function(): void {
  ($u, $t) = dict['a' => 1, 'b' => 2];
};

$assertion_error_27 = null;
try {
  $assertion_value_27();
} catch (TypeError $assertion_caught_27) {
  $assertion_error_27 = $assertion_caught_27;
}

assert!($assertion_error_27 is TypeError);

final class FallbackCalls {
  public int $count = 0;
}

function fallback(FallbackCalls $calls, mixed $value): mixed {
  $calls->count++;
  return $value;
}

$calls = new FallbackCalls();
($given, $family = fallback($calls, $given . '-family')) = vec['Ada'];
assert!($given == 'Ada');
assert!($family == 'Ada-family');
assert!($calls->count == 1);

($given, $family = fallback($calls, 'unused')) = vec['Grace', 'Hopper'];
assert!($given == 'Grace');
assert!($family == 'Hopper');
assert!($calls->count == 1);

($presentNull, $nullable = fallback($calls, 'not null')) = vec[1, null];
assert!($presentNull == 1);
assert!($nullable == null);
assert!($calls->count == 1);

($only = 5,) = vec[];
assert!($only == 5);

(
  $first,
  $second = fallback($calls, 2),
  $third = fallback($calls, $second + 1),
) = vec[1];

assert!(($first, $second, $third) == (1, 2, 3));
assert!($calls->count == 3);

($outer, ($inner, $nested = 9)) = vec[1, vec[2]];
assert!(($outer, $inner, $nested) == (1, 2, 9));

($head, $optional = 2, ...$tail) = vec[1, 3, 4, 5];
assert!($head == 1);
assert!($optional == 3);
assert!($tail == vec[4, 5]);

$rows = vec[];
foreach (vec[vec[1], vec[2, 3]] as ($left, $right = 10)) {
  $rows[] = ($left, $right);
}

assert!($rows == vec[(1, 10), (2, 3)]);

$assertion_value_45 = function(): void {
  ($required, $alsoRequired, $optional = 3) = vec[1];
};

$assertion_error_45 = null;
try {
  $assertion_value_45();
} catch (TypeError $assertion_caught_45) {
  $assertion_error_45 = $assertion_caught_45;
}

assert!($assertion_error_45 is TypeError);

$assertion_value_46 = function(): void {
  ($required, $optional = 2) = vec[1, 2, 3];
};

$assertion_error_46 = null;
try {
  $assertion_value_46();
} catch (TypeError $assertion_caught_46) {
  $assertion_error_46 = $assertion_caught_46;
}

assert!($assertion_error_46 is TypeError);

$work = Filesystem\create_temporary_directory(null, 'whim-test-');
File\write(
  $work . '/required-after-default.whim',
  '($first, $optional = 2, $required) = vec[1, 2, 3];' . "\n",
);

$requiredAfterDefault = $work . '/required-after-default.whim';
$assertion_value_47 = function() use ($requiredAfterDefault): void {
  require!($requiredAfterDefault);
};

$assertion_error_47 = null;
try {
  $assertion_value_47();
} catch (CompilerError $assertion_caught_47) {
  $assertion_error_47 = $assertion_caught_47;
}

assert!($assertion_error_47 is CompilerError);

Filesystem\delete_directory($work, true);

$values = vec[];
($values[], $values[]) = (1, 2);
assert!($values == vec[1, 2]);

$appended = vec[];
((($a, $b), ($c, $d)), $appended[]) = (((3, 4), (5, 6)), 7);
assert!(($a, $b, $c, $d) == (3, 4, 5, 6));
assert!($appended == vec[7]);

($duplicated, $duplicated) = ('a', 'b');
assert!($duplicated == 'b');

($front, $_, $_, $back) = (1, 2, 3, 4);
assert!($front == 1);
assert!($back == 4);
assert!($_ == 3);

(($_, $keptSkip), $_) = ((1, 2), 3);
assert!($keptSkip == 2);
($_, ...$rest) = vec[1, 2, 3];
assert!(length!($rest) == 2);

final class KeyTrace {
  public vec<string> $events = vec[];
}

function trace_key(KeyTrace $trace, string $name): string {
  $trace->events[] = 'key:' . $name;
  return $name;
}

function trace_source(KeyTrace $trace): dict<string, mixed> {
  $trace->events[] = 'source';
  return dict[
    'id' => 42,
    'profile' => dict['name' => 'Ada'],
    'pair' => ('left', 'right'),
  ];
}

$trace = new KeyTrace();
dict[
  trace_key($trace, 'id') => $identifier,
  trace_key($trace, 'profile') => dict['name' => $profileName],
  trace_key($trace, 'pair') => ($pairLeft, $pairRight),
] = trace_source($trace);

assert!($trace->events == vec['key:id', 'key:profile', 'key:pair', 'source']);

assert!($identifier == 42);
assert!($profileName == 'Ada');
assert!($pairLeft == 'left');
assert!($pairRight == 'right');

