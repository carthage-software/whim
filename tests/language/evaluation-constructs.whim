use Whim\Command;
use Whim\Env;
use Whim\File;
use Whim\Filesystem;
use Whim\Path;
use Whim\Reference\WeakMap;
use Whim\Unwind\AssertionError;
use Whim\Unwind\OutOfBoundsError;
use Whim\Unwind\ReadonlyError;
use Whim\Unwind\TypeError;
use Whim\Unwind\VisibilityError;

require!('_reject.whim');
require!('_process.whim');

const LIMIT = 7;

class Bucket {
  public const int SIZE = LIMIT;

  public function capacity(): int {
    return Bucket::SIZE;
  }
}

assert!(Bucket::SIZE == 7);
assert!(new Bucket()->capacity() == 7);

const READY = 'value';

class Holder {
  public const string LABEL = READY;
}

assert!(READY == 'value');
assert!(Holder::LABEL == 'value');

assert!(length!('hello') == 5);
assert!(vec[1, 2, 3][1] + dict['a' => 2]['a'] + (1,)[0] == 5);
assert!((7 * 6) - (8 / 2) == 38.0);
assert!((1 << 5) | 3 == 35);
assert!(17 % 5 == 2);
assert!(2 ** 10 == 1024);
assert!('P6' . "\n" . 1400 . ' ' . 900 . "\n255\n" == "P6\n1400 900\n255\n");

const BASE = 40;

enum Priority: int {
  case Low = BASE;
  case High = BASE + 10;
}

class Config {
  public const int LIMIT = BASE * 2;
}

const MAX = Config::LIMIT;

class Uses {
  public const int DERIVED = Later::SEED + 1;
}

class Later {
  public const int SEED = 5;
}

assert!(Priority::Low->value == 40);
assert!(Priority::High->value == 50);
assert!(Config::LIMIT == 80);
assert!(MAX == 80);
assert!(Uses::DERIVED == 6);
assert!(Later::SEED == 5);

