assert!(length!(file!()) > length!(directory!()));
assert!(
  file!() == directory!() . Path\SEPARATOR . 'evaluation-constructs.whim',
);

$work = Filesystem\create_temporary_directory(null, 'whim-test-');
$binary = Env\current_binary();
assert!($binary is string);

prints('write-rendering', 'a12.5' . "\n" . 'xy' . "\n");

$assertion_value_74 = function(): void {
  write!(true);
};

$assertion_error_74 = null;
try {
  $assertion_value_74();
} catch (TypeError $assertion_caught_74) {
  $assertion_error_74 = $assertion_caught_74;
}

assert!($assertion_error_74 is TypeError);

$assertion_value_75 = function(): void {
  write_line!(vec[]);
};

$assertion_error_75 = null;
try {
  $assertion_value_75();
} catch (TypeError $assertion_caught_75) {
  $assertion_error_75 = $assertion_caught_75;
}

assert!($assertion_error_75 is TypeError);

File\write(
  $work . '/write-error.whim',
  'write_error!(\'e1\');'
  . "\n"
  . 'write_error_line!(\'e2\');'
  . "\n"
  . 'write_line!(\'stdout untouched\');'
  . "\n",
);

$writeError = Command\run($binary, vec[$work . '/write-error.whim']);
assert!($writeError->isSuccess());
assert!($writeError->standardOutput == 'stdout untouched' . "\n");
assert!($writeError->standardError == 'e1e2' . "\n");

File\write(
  $work . '/debug.whim',
  'debug!(vec[1, 2], dict[\'k\' => (1, \'x\')], null, true);'
  . "\n"
  . 'write_line!(\'after debug\');'
  . "\n",
);

$debug = Command\run($binary, vec[$work . '/debug.whim']);
assert!($debug->isSuccess());
assert!($debug->standardOutput == 'after debug' . "\n");
assert!(
  $debug->standardError
  == '['
  . Filesystem\canonicalize($work . '/debug.whim')
  . ':1:1] vec(2) ['
  . "\n"
  . '  1,'
  . "\n"
  . '  2,'
  . "\n"
  . '],'
  . "\n"
  . 'dict(1) ['
  . "\n"
  . '  string(1) "k" => tuple(2) ['
  . "\n"
  . '    1,'
  . "\n"
  . '    string(1) "x",'
  . "\n"
  . '  ],'
  . "\n"
  . '],'
  . "\n"
  . 'null,'
  . "\n"
  . 'true'
  . "\n",
);

File\write($work . '/exit-default.whim', 'exit!();' . "\n");
$exitDefault = Command\run($binary, vec[$work . '/exit-default.whim']);
assert!($exitDefault->isSuccess());
assert!(length!($exitDefault->standardOutput) == 0);
assert!(length!($exitDefault->standardError) == 0);

File\write(
  $work . '/exit-terminates.whim',
  'write_line!(\'before\');'
  . "\n"
  . 'try {'
  . "\n"
  . '    exit!(7);'
  . "\n"
  . '} catch (Whim\Unwind\Error $e) {'
  . "\n"
  . '    write_line!(\'caught exit\');'
  . "\n"
  . '} finally {'
  . "\n"
  . '    write_line!(\'finally ran\');'
  . "\n"
  . '}'
  . "\n"
  . 'write_line!(\'after\');'
  . "\n",
);

$exitTerminates = Command\run($binary, vec[$work . '/exit-terminates.whim']);
assert!($exitTerminates->status is Command\Exited);
assert!(($exitTerminates->status as Command\Exited)->code == 7);
assert!($exitTerminates->standardOutput == 'before' . "\n");
assert!(length!($exitTerminates->standardError) == 0);

Filesystem\delete_directory($work, true);
