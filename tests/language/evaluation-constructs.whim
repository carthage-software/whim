}

assert!($negated is AssertionError);

assert!($negated->getMessage() == 'assertion failed: !true');

final class AssertionCounter {
  public int $calls = 0;

  public function next(): int {
    $this->calls++;
    return $this->calls;
  }
}

$counter = new AssertionCounter();
$evaluatedOnce = null;
$assertion_callable_36 = function() use ($counter): void {
  assert!($counter->next() == 2);
};

try {
  $assertion_callable_36();
} catch (AssertionError $assertion_caught_36) {
  $evaluatedOnce = $assertion_caught_36;
}

assert!($evaluatedOnce is AssertionError);

assert!(
  $evaluatedOnce->getMessage()
  == 'assertion failed: $counter->next() == 2'
  . "\n"
  . '  left:  1'
  . "\n"
  . '  right: 2',
);

assert!($counter->calls == 1);

readonly class ImmutablePoint {
  public function __construct(public int $x, public int $y) {}

  public function withY(int $y): static {
    return clone!($this, y: $y);
  }
}

$point = new ImmutablePoint(1, 2);
$moved = $point->withY(9);
assert!(($moved->x, $moved->y) == (1, 9));
assert!(($point->x, $point->y) == (1, 2));
assert!($point != $moved);
$assertion_value_42 = fn(): ImmutablePoint => clone!($point, ghost: 1);
$assertion_error_42 = null;
try {
  $assertion_value_42();
} catch (TypeError $assertion_caught_42) {
  $assertion_error_42 = $assertion_caught_42;
}

assert!($assertion_error_42 is TypeError);

$assertion_value_43 = fn(): ImmutablePoint => clone!($point, y: 10);
$assertion_error_43 = null;
try {
  $assertion_value_43();
} catch (ReadonlyError $assertion_caught_43) {
  $assertion_error_43 = $assertion_caught_43;
}

assert!($assertion_error_43 is ReadonlyError);

readonly class ProtectedPoint {
  public function __construct(protected int $value) {}

  public function value(): int {
    return $this->value;
  }
}

readonly class AdjustablePoint extends ProtectedPoint {
  public function withValue(int $value): static {
    return clone!($this, value: $value);
  }
}

assert!(new AdjustablePoint(1)->withValue(2)->value() == 2);

readonly class PrivatePoint {
  public function __construct(private int $value) {}

  public function withValue(int $value): static {
    return clone!($this, value: $value);
  }
}

$assertion_value_45 = fn(): PrivatePoint => new PrivatePoint(1)->withValue(2);
$assertion_error_45 = null;
try {
  $assertion_value_45();
} catch (ReadonlyError $assertion_caught_45) {
  $assertion_error_45 = $assertion_caught_45;
}

assert!($assertion_error_45 is ReadonlyError);

class MutablePoint {
  public function __construct(public readonly int $value) {}

  public function withValue(int $value): static {
    return clone!($this, value: $value);
  }
}

$assertion_value_46 = fn(): MutablePoint => new MutablePoint(1)->withValue(2);
$assertion_error_46 = null;
try {
  $assertion_value_46();
} catch (ReadonlyError $assertion_caught_46) {
  $assertion_error_46 = $assertion_caught_46;
}

assert!($assertion_error_46 is ReadonlyError);

class PayloadPoint {
  public function __construct(public int $x, public int $y) {}
}

$payload = new PayloadPoint(1, 2);
$movedPayload = clone!($payload, y: 9);
assert!(($movedPayload->x, $movedPayload->y) == (1, 9));
assert!(($payload->x, $payload->y) == (1, 2));

$weakMap = new WeakMap::<object, mixed>();
$assertion_value_49 = fn(): mixed => clone!($weakMap);
$assertion_error_49 = null;
try {
  $assertion_value_49();
} catch (TypeError $assertion_caught_49) {
  $assertion_error_49 = $assertion_caught_49;
  assert!(
    Whim\Str\contains(
      $assertion_caught_49->getMessage(),
      'cannot clone an instance of the built-in class Whim\Reference\WeakMap',
    ),
  );
}

assert!($assertion_error_49 is TypeError);

class PrivateCloneState {
  public function __construct(private readonly string $name) {}

  public function name(): string {
    return $this->name;
  }
}

$state = new PrivateCloneState('Ada');
$assertion_value_50 = fn(): PrivateCloneState => clone!($state, name: 'Grace');
$assertion_error_50 = null;
try {
  $assertion_value_50();
} catch (VisibilityError $assertion_caught_50) {
  $assertion_error_50 = $assertion_caught_50;
}

assert!($assertion_error_50 is VisibilityError);

assert!($state->name() == 'Ada');

