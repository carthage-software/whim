assert!(remove!($items, 1) == 'b');
assert!($items[1] == 'c');
assert!(length!($items) == 2);
$mapping = dict['x' => 1, 'y' => 2];
assert!(remove!($mapping, 'x') == 1);
assert!(length!($mapping) == 1);
