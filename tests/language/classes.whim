class SharedCounter {
  public int $count = 0;

  public function bump(): void {
    $this->count = $this->count + 1;
  }
}

$first_counter = new SharedCounter();
$second_counter = $first_counter;
$second_counter->bump();
$first_counter->bump();
assert!($first_counter->count == 2);
assert!($second_counter->count == 2);

