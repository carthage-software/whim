class ClonePoint {
  public function __construct(public int $x, public int $y) {}
}

$clone_source = new ClonePoint(1, 2);
$clone_copy = clone!($clone_source, y: 9);
$clone_source->x = 100;
assert!(($clone_source->x, $clone_source->y) == (100, 2));
assert!(($clone_copy->x, $clone_copy->y) == (1, 9));

