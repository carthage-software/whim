class StaticModel {
  public static function create(): static {
    return new static();
  }

  public function name(): string {
    return 'model';
  }
}

class StaticPost extends StaticModel {
  public function name(): string {
    return 'post';
  }
}

assert!(StaticModel::create()->name() == 'model');
assert!(StaticPost::create()->name() == 'post');

class ForwardingModel {
  public static function create(): static {
    return static::make();
  }

  public static function make(): static {
    return new static();
  }

  public function name(): string {
    return 'model';
  }
}

class ForwardingPost extends ForwardingModel {
  public function name(): string {
    return 'post';
  }
}

assert!(ForwardingPost::create()->name() == 'post');

class Animal {
  public function speak(): string {
    return 'generic';
  }

  public function describe(): string {
    return 'a ' . $this->kind();
  }

  public function kind(): string {
    return 'animal';
  }
}

class Dog extends Animal {
  public function speak(): string {
    return 'woof and ' . parent::speak();
  }

  public function kind(): string {
    return 'dog';
  }
}

$dog = new Dog();
assert!($dog->speak() == 'woof and generic');
assert!($dog->describe() == 'a dog');

class ChainedEntity {
  public readonly int $id;

  public function __construct(int $id) {
    $this->id = $id;
  }
}

class ChainedUser extends ChainedEntity {
  public string $name = '';

  public function __construct(int $id, string $name) {
    parent::__construct($id);
    $this->name = $name;
  }
}

$chained_user = new ChainedUser(7, 'ada');
assert!($chained_user->id == 7);
assert!($chained_user->name == 'ada');

final class ResurrectingResource {
  public static vec<string> $events = vec[];
  public static null|ResurrectingResource $kept = null;

  public function __construct(public string $name) {}

  public function __destruct(): void {
    self::$events[] = 'destruct ' . $this->name;
    self::$kept = $this;
  }
}

$resurrecting = new ResurrectingResource('socket');
$resurrecting = null;
ResurrectingResource::$events[] = 'after';
assert!(ResurrectingResource::$kept is ResurrectingResource);

ResurrectingResource::$kept = null;
assert!(ResurrectingResource::$events == vec['destruct socket', 'after']);

final class DestructorLog {
  public static vec<string> $events = vec[];
}

class ParentResource {
  public function __destruct(): void {
    DestructorLog::$events[] = 'parent';
  }
}

class InheritedResource extends ParentResource {}

class ReplacingResource extends ParentResource {
  public function __destruct(): void {
    DestructorLog::$events[] = 'child';
  }
}

class ChainedResource extends ParentResource {
  public function __destruct(): void {
    DestructorLog::$events[] = 'chained';
    parent::__destruct();
  }
}

$inherited = new InheritedResource();
$inherited = null;
$replacing = new ReplacingResource();
$replacing = null;
$chained_resource = new ChainedResource();
$chained_resource = null;
assert!(DestructorLog::$events == vec['parent', 'child', 'chained', 'parent']);

final class ReentrantDestructorLog {
  public static vec<string> $events = vec[];
  public static null|ReentrantDestructorLeaf $leaf = null;
}

final class ReentrantDestructorLeaf {
  public function __destruct(): void {
    ReentrantDestructorLog::$events[] = 'leaf';
  }
}

function clear_reentrant_destructor_leaf(): void {
  ReentrantDestructorLog::$leaf = null;
}

final class ReentrantDestructorRoot {
  public function __destruct(): void {
    ReentrantDestructorLog::$events[] = 'root-start';
    clear_reentrant_destructor_leaf();
    ReentrantDestructorLog::$events[] = 'root-end';
  }
}

ReentrantDestructorLog::$leaf = new ReentrantDestructorLeaf();
$reentrant_destructor = new ReentrantDestructorRoot();
$reentrant_destructor = null;
GC\collect_cycles();
assert!(
  ReentrantDestructorLog::$events == vec['root-start', 'root-end', 'leaf'],
);

class ThrowingResource {
  public function __destruct(): void {
    throw new RuntimeException('released');
  }
}

function release_resource(): void {
  $resource = new ThrowingResource();
}

$assertion_value_37 = function(): void {
  release_resource();
};

$assertion_error_37 = null;
try {
  $assertion_value_37();
} catch (RuntimeException $assertion_caught_37) {
  $assertion_error_37 = $assertion_caught_37;
  assert!(Whim\Str\contains($assertion_caught_37->getMessage(), 'released'));
}

assert!($assertion_error_37 is RuntimeException);

$work = Filesystem\create_temporary_directory(null, 'whim-test-');
$binary = Env\current_binary();
assert!($binary is string);

prints('shutdown-destructor', 'shutdown' . "\n");

fails('destructor-throw-during-shutdown', 'shutdown failed');

$stop_file = $work . '/exit-in-destructor.whim';
File\write(
  $stop_file,
  'class StopsShutdown {'
  . "\n"
  . '    public function __destruct(): void {'
  . "\n"
  . '        write_line!(\'stop\');'
  . "\n"
  . '        exit!(7);'
  . "\n"
  . '    }'
  . "\n"
  . '}'
  . "\n"
  . 'class MustNotRun {'
  . "\n"
  . '    public function __destruct(): void { write_line!(\'late\'); }'
  . "\n"
  . '}'
  . "\n"
  . '$first = new StopsShutdown();'
  . "\n"
  . '$second = new MustNotRun();'
  . "\n"
  . 'exit!(3);'
  . "\n",
);

$stopped = Command\run($binary, vec[$stop_file]);
assert!($stopped->status is Command\Exited);
assert!(($stopped->status as Command\Exited)->code == 7);
assert!($stopped->standardOutput == 'stop' . "\n");
assert!(length!($stopped->standardError) == 0);

$cycle_file = $work . '/cycle-destructors.whim';
File\write(
  $cycle_file,
  'class Node {'
  . "\n"
  . '    public null|Node $next = null;'
  . "\n"
  . '    public function __construct(public string $name) {}'
  . "\n"
  . '    public function __destruct(): void {'
  . "\n"
  . '        write_line!($this->name . \':\' . ($this->next ?as Node)->name);'
  . "\n"
  . '    }'
  . "\n"
  . '}'
  . "\n"
  . 'function make_cycle(): void {'
  . "\n"
  . '    $left = new Node(\'left\');'
  . "\n"
  . '    $right = new Node(\'right\');'
  . "\n"
  . '    $left->next = $right;'
  . "\n"
  . '    $right->next = $left;'
  . "\n"
  . '}'
  . "\n"
  . 'make_cycle();'
  . "\n"
  . '$collected = Whim\GC\collect_cycles();'
  . "\n"
  . 'assert!($collected is int);'
  . "\n"
  . 'write_line!(\'collected\');'
  . "\n",
);

$cycle_run = Command\Command::create($binary)
  ->withArgument($cycle_file)
  ->withVariable('WHIM_CYCLE_THRESHOLD', '8')
  ->run();

assert!(length!($cycle_run->standardError) == 0);
assert!($cycle_run->isSuccess());
assert!(
  $cycle_run->standardOutput
  == 'left:right' . "\n" . 'right:left' . "\n" . 'collected' . "\n",
);

$async_cycle_file = $work . '/async-cycle-destructors.whim';
File\write(
  $async_cycle_file,
  'class AsyncNode {'
  . "\n"
  . '    public null|AsyncNode $next = null;'
  . "\n"
  . '    public function __construct(public string $name) {}'
  . "\n"
  . '    public function __destruct(): void {'
  . "\n"
  . '        write_line!(\'start \' . $this->name);'
  . "\n"
  . '        Whim\Async\later();'
  . "\n"
  . '        write_line!(\'end \' . $this->name);'
  . "\n"
  . '    }'
  . "\n"
  . '}'
  . "\n"
  . 'function make_async_cycle(): void {'
  . "\n"
  . '    $left = new AsyncNode(\'left\');'
  . "\n"
  . '    $right = new AsyncNode(\'right\');'
  . "\n"
  . '    $left->next = $right;'
  . "\n"
  . '    $right->next = $left;'
  . "\n"
  . '}'
  . "\n"
  . '$future = Whim\Async\spawn::<null>(function (): null {'
  . "\n"
  . '    make_async_cycle();'
  . "\n"
  . '    Whim\GC\collect_cycles();'
  . "\n"
  . '    return null;'
  . "\n"
  . '});'
  . "\n"
  . '$future->await();'
  . "\n"
  . 'Whim\Async\drain();'
  . "\n",
);

$async_cycle_run = Command\Command::create($binary)
  ->withArgument($async_cycle_file)
  ->withVariable('WHIM_CYCLE_THRESHOLD', '8')
  ->run();

assert!(length!($async_cycle_run->standardError) == 0);
assert!($async_cycle_run->isSuccess());
assert!(
  $async_cycle_run->standardOutput
  == 'start left'
  . "\n"
  . 'start right'
  . "\n"
  . 'end left'
  . "\n"
  . 'end right'
  . "\n",
);

class ThrowingCycle {
  public null|PlainCycle $next = null;

  public function __destruct(): void {
    throw new RuntimeException('cycle failed');
  }
}

class PlainCycle {
  public null|ThrowingCycle $next = null;
}

function make_throwing_cycle(): void {
  $throwing = new ThrowingCycle();
  $plain = new PlainCycle();
  $throwing->next = $plain;
  $plain->next = $throwing;
}

$assertion_value_49 = function(): void {
  $future = Async\spawn::<null>(function(): null {
    make_throwing_cycle();
    GC\collect_cycles();
    return null;
  });

  $future->await();
};

$assertion_error_49 = null;
try {
  $assertion_value_49();
} catch (RuntimeException $assertion_caught_49) {
  $assertion_error_49 = $assertion_caught_49;
  assert!(
    Whim\Str\contains($assertion_caught_49->getMessage(), 'cycle failed'),
  );
}

assert!($assertion_error_49 is RuntimeException);

Async\drain();

Filesystem\delete_directory($work, true);
