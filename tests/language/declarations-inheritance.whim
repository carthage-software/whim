class BroadConstant {
  public const int|string VALUE = 1;
}

class NarrowConstant extends BroadConstant {
  public const int VALUE = 2;
}

assert!(NarrowConstant::VALUE == 2);

class ExemptBase {
  public function __construct(public int $id) {}
}

class ExemptUser extends ExemptBase {
  public function __construct(int $id, public string $name) {
    parent::__construct($id);
  }
}

$user = new ExemptUser(7, 'ada');
assert!($user->id == 7);
assert!($user->name == 'ada');

class ScopedBase {
  private string $x = 'A';

  public function fromBase(): string {
    return $this->x;
  }
}

class ScopedChild extends ScopedBase {
  private string $x = 'B';

  public function fromChild(): string {
    return $this->x;
  }
}

$scoped = new ScopedChild();
assert!($scoped->fromBase() == 'A');
assert!($scoped->fromChild() == 'B');

abstract class ParentFactory {
  abstract public static function make(): static;
}

final class ChildFactory extends ParentFactory {
  public static function make(): self {
    return new self();
  }
}

assert!(ChildFactory::make() is ChildFactory);

abstract class ProtectedDispatchParent {
  public function value(): int {
    return $this->implementation();
  }

  protected function implementation(): int {
    return 1;
  }
}

final class InheritedProtectedDispatch extends ProtectedDispatchParent {}

final class OverriddenProtectedDispatch extends ProtectedDispatchParent {
  protected function implementation(): int {
    return 2;
  }
}

assert!(new InheritedProtectedDispatch()->value() == 1);
assert!(new OverriddenProtectedDispatch()->value() == 2);

class ShadowMethodParent {
  private function value(): int {
    return 1;
  }

  public function parentValue(): int {
    return $this->value();
  }
}

class ShadowMethodChild extends ShadowMethodParent {
  private function value(): int {
    return 2;
  }

  public function childValue(): int {
    return $this->value();
  }
}

class ShadowMethodPublicChild extends ShadowMethodParent {
  public function value(string $value): string {
    return $value;
  }
}

$shadowChild = new ShadowMethodChild();
assert!($shadowChild->parentValue() == 1);
assert!($shadowChild->childValue() == 2);

$shadowPublic = new ShadowMethodPublicChild();
assert!($shadowPublic->parentValue() == 1);
assert!($shadowPublic->value('child') == 'child');

class ShadowPropertyParent {
  private int $value = 10;

  public function value(): int {
    return $this->value;
  }
}

class ShadowPropertyChild extends ShadowPropertyParent {
  public string $value = 'child';
}

$shadowProperty = new ShadowPropertyChild();
assert!($shadowProperty->value == 'child');
assert!($shadowProperty->value() == 10);

$shadowProperty->value = 'updated';
assert!($shadowProperty->value == 'updated');
assert!($shadowProperty->value() == 10);

class RedeclaredBase {
  public readonly int $id;

  public function __construct(int $id) {
    $this->id = $id;
  }
}

class RedeclaredChild extends RedeclaredBase {
  public readonly int $id;
}

$redeclared = new RedeclaredChild(5);
assert!($redeclared->id == 5);

class PromotedBase {
  public function __construct(public readonly int $id) {}
}

class PromotedChild extends PromotedBase {
  public readonly int $id;
}

$promoted = new PromotedChild(6);
assert!($promoted->id == 6);

abstract class SealedEvent for SealedLogin {}

class SealedLogin extends SealedEvent {}

class SealedDetailedLogin extends SealedLogin {}

assert!(new SealedLogin() is SealedEvent);
assert!(new SealedDetailedLogin() is SealedEvent);

