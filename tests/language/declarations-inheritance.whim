interface SealedShape for SealedPolygon {}

abstract class SealedPolygon implements SealedShape for SealedQuad {}

final class SealedQuad extends SealedPolygon {}

assert!(new SealedQuad() is SealedPolygon);
assert!(new SealedQuad() is SealedShape);

