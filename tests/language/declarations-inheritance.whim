use Whim\Unwind\CompilerError;
use Whim\Unwind\LinkerError;

require_once!('_diagnostics.whim');

raises(
  '_declarations-inheritance/mutable-extends-readonly.whim',
  'so it must be readonly too',
);

raises(
  '_declarations-inheritance/readonly-extends-mutable.whim',
  'cannot extend A, which is not readonly',
);

raises(
  '_declarations-inheritance/readonly-property-write.whim',
  'readonly property',
);

raises(
  '_declarations-inheritance/added-required-parameter.whim',
  'may not demand more',
);

raises(
  '_declarations-inheritance/narrow-visibility.whim',
  'may only widen visibility',
);

raises(
  '_declarations-inheritance/override-final.whim',
  'final and cannot be overridden',
);

raises(
  '_declarations-inheritance/static-mismatch.whim',
  'is static and the inherited method is not',
);

raises(
  '_declarations-inheritance/abstract-method-in-a-concrete-class.whim',
  'an abstract method may appear only in an abstract class',
);

raises(
  '_declarations-inheritance/concrete-inherits-abstract.whim',
  'is not abstract and does not implement m',
);

raises(
  '_declarations-inheritance/extends-a-final-class.whim',
  'cannot extend the final class',
);

raises(
  '_declarations-inheritance/instantiate-an-abstract-class.whim',
  'cannot instantiate Shape',
);

raises(
  '_declarations-inheritance/two-base-classes.whim',
  'a class extends at most one base class',
);

raises(
  '_declarations-inheritance/base-arguments-on-non-generic.whim',
  'to I, which is not generic',
);

raises(
  '_declarations-inheritance/base-type-argument-arity.whim',
  'supplies 2 type argument(s) to Box, which takes exactly 1',
);

raises(
  '_declarations-inheritance/property-type-invariance.whim',
  'property types are invariant',
);

raises(
  '_declarations-inheritance/readonly-property-cannot-become-writable.whim',
  'cannot redeclare readonly inherited property',
);

raises(
  '_declarations-inheritance/writable-property-cannot-become-readonly.whim',
  'cannot redeclare writable inherited property',
);

raises(
  '_declarations-inheritance/constant-over-inherited-method.whim',
  'declares the constant value, but already has a method of that name',
);

raises(
  '_declarations-inheritance/method-over-inherited-constant.whim',
  'declares the method value, but already has a constant of that name',
);

raises(
  '_declarations-inheritance/interface-member-kind-conflict.whim',
  'inherits a constant named value, but also inherits a method of that name',
);

$assertion_value_1 = function(): void {
  require!('_declarations-inheritance/incompatible-constant.whim');
};

$assertion_error_1 = null;
try {
  $assertion_value_1();
} catch (LinkerError $assertion_caught_1) {
  $assertion_error_1 = $assertion_caught_1;
}

assert!($assertion_error_1 is LinkerError);

$assertion_value_2 = function(): void {
  require!('_declarations-inheritance/cyclic-interfaces.whim');
};

$assertion_error_2 = null;
try {
  $assertion_value_2();
} catch (LinkerError $assertion_caught_2) {
  $assertion_error_2 = $assertion_caught_2;
  assert!(
    Whim\Str\contains(
      $assertion_caught_2->getMessage(),
      'the interface Left participates in cyclic inheritance',
    ),
  );
}

assert!($assertion_error_2 is LinkerError);

