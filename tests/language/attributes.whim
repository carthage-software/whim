use Whim\Attribute\Attribute;
use Whim\Filesystem;
use Whim\Marker\ConsistentConstructor;
use Whim\Marker\ConsistentGenerics;
use Whim\Reflection;
use Whim\Unwind\Error;
use Whim\Unwind\Exception;

require!('_reject.whim');

$work = Filesystem\create_temporary_directory(null, 'whim-test-');

rejects(
  $work,
  'class-is-not-an-attribute',
  'final class Plain {}'
  . "\n\n"
  . '#[Plain]'
  . "\n"
  . 'function target(): void {}'
  . "\n",
  'does not carry #[Whim\Attribute\Attribute]',
);

rejects(
  $work,
  'target-flags-are-enforced',
  'use Whim\Attribute\Attribute;'
  . "\n\n"
  . '#[Attribute(Attribute::TARGET_CLASS)]'
  . "\n"
  . 'final class ClassOnly {}'
  . "\n\n"
  . '#[ClassOnly]'
  . "\n"
  . 'function wrongly_accepted(): string { return \'ran\'; }'
  . "\n\n"
  . 'write_line!(wrongly_accepted());'
  . "\n",
  'does not target functions',
);

rejects(
  $work,
  'arguments-are-constant',
  'use Whim\Attribute\Attribute;'
  . "\n\n"
  . '#[Attribute]'
  . "\n"
  . 'final class Capture {'
  . "\n"
  . '  public function __construct(public readonly int $value) {}'
  . "\n"
  . '}'
  . "\n\n"
  . '#[Capture($value)]'
  . "\n"
  . 'class Target {}'
  . "\n",
  'an attribute argument is a constant expression',
);

rejects(
  $work,
  'constructor-arity',
  'use Whim\Attribute\Attribute;'
  . "\n\n"
  . '#[Attribute]'
  . "\n"
  . 'final class Two {'
  . "\n"
  . '  public function __construct(public readonly int $a, public readonly int $b) {}'
  . "\n"
  . '}'
  . "\n\n"
  . '#[Two(1)]'
  . "\n"
  . 'class C {}'
  . "\n",
  'its constructor takes exactly 2',
);

rejects(
  $work,
  'repeatability',
  'use Whim\Attribute\Attribute;'
  . "\n\n"
  . '#[Attribute(Attribute::TARGET_CLASS)]'
  . "\n"
  . 'final class Once {}'
  . "\n\n"
  . '#[Once]'
  . "\n"
  . '#[Once]'
  . "\n"
  . 'class C {}'
  . "\n",
  'is not repeatable',
);

rejects(
  $work,
  'type-alias-wrong-target',
  'use Whim\Attribute\Attribute;'
  . "\n\n"
  . '#[Attribute(Attribute::TARGET_CLASS)]'
  . "\n"
  . 'final class ClassOnly {}'
  . "\n\n"
  . '#[ClassOnly]'
  . "\n"
  . 'type Number = int;'
  . "\n",
  'does not target type aliases',
);

rejects(
  $work,
  'consistent-constructor-narrowing',
  'use Whim\Marker\ConsistentConstructor;'
  . "\n\n"
  . '#[ConsistentConstructor]'
  . "\n"
  . 'class Base {'
  . "\n"
  . '  public function __construct(int|string $value) {}'
  . "\n"
  . '}'
  . "\n\n"
  . 'final class Child extends Base {'
  . "\n"
  . '  public function __construct(int $value) {}'
  . "\n"
  . '}'
  . "\n",
  'Child::__construct is not compatible with the method it overrides: parameter 1 is not contravariant with the inherited method',
);

rejects(
  $work,
  'consistent-generics-narrowing',
  'use Whim\Marker\ConsistentGenerics;'
  . "\n\n"
  . '#[ConsistentGenerics]'
  . "\n"
  . 'class Base<T: int|string> {}'
  . "\n\n"
  . 'final class Narrow<T: int> extends Base<T> {}'
  . "\n",
  'type parameter 1 on Narrow must preserve the generic contract of Base',
);

Filesystem\delete_directory($work, true);

#[ConsistentConstructor]
class WideningBase {
  public function __construct(int $value) {}
}

final class WideningChild extends WideningBase {
  public function __construct(int|float $value, string $label = '') {}
}

assert!(new WideningChild(1) is WideningBase);

class PermissiveBase {
  public function __construct() {}
}

final class PermissiveChild extends PermissiveBase {
  public function __construct(int $required) {}
}

assert!(new PermissiveChild(1) is PermissiveBase);

#[ConsistentGenerics]
class GenericBase<T: int|string> {}

final class GenericSame<T: int|string> extends GenericBase<T> {}

assert!(new GenericSame::<int>() is GenericBase<int>);

#[Attribute(Attribute::TARGET_CLASS | Attribute::IS_REPEATABLE)]
final class Meta {
  public function __construct(public readonly mixed $value = null) {}
}

#[Meta(2 + 3 * 4)]
#[Meta('a' . 'b')]
#[Meta(Later::LIMIT)]
#[Meta(vec[1, 2, Later::LIMIT])]
#[Meta(dict['k' => Suit::Hearts])]
class Described {}

class Later {
  public const int LIMIT = 7;
}

enum Suit: string {
  case Hearts = 'H';
}

$describedClass = Reflection\reflect_class(new Described());
assert!($describedClass != null);
$found = $describedClass->getAttributes::<Meta>();

assert!(length!($found) == 5);
assert!($found[0]->getArguments()[0] == 14);
assert!($found[1]->getArguments()[0] == 'ab');
assert!($found[2]->getArguments()[0] == 7);
assert!($found[3]->getArguments()[0][2] == 7);
$suit = $found[4]->getArguments()[0]['k'];
assert!($suit is Suit);
assert!($suit->value == 'H');

#[Attribute(Attribute::TARGET_TYPE_ALIAS)]
final class TypeMetadata {}

#[TypeMetadata]
type Number = int;

assert!(1 is Number);

function sensitive_login(
  string $user,
  #[Whim\Marker\SensitiveParameter] string $password,
): void {
  throw new Error('denied', 0);
}

$denied = null;
$assertion_callable_39 = function(): void {
  sensitive_login('ada', 'hunter2');
};

try {
  $assertion_callable_39();
} catch (Error $assertion_caught_39) {
  $denied = $assertion_caught_39;
  assert!(Whim\Str\contains($assertion_caught_39->getMessage(), 'denied'));
}

assert!($denied is Error);

$denied_arguments = $denied->getTrace()[0]->arguments;
assert!($denied_arguments[0] == 'ada');
$wrapped_password = $denied_arguments[1];
assert!($wrapped_password is Whim\Marker\SensitiveParameterValue);

assert!($wrapped_password->getValue() == 'hunter2');

function sensitive_never_login(
  string $user,
  #[Whim\Marker\SensitiveParameter] string $password,
): never {
  throw new Exception('denied');
}

$sensitive_rendering = null;
$assertion_callable_43 = function(): void {
  sensitive_never_login('alice-username-marker', 'super-secret-pw-marker');
};

try {
  $assertion_callable_43();
} catch (Exception $assertion_caught_43) {
  $sensitive_rendering = $assertion_caught_43;
}

assert!($sensitive_rendering is Exception);
$sensitive_rendering = $sensitive_rendering->toString();

assert!(Whim\Str\contains($sensitive_rendering, 'alice-username-marker'));
assert!(
  Whim\Str\contains(
    $sensitive_rendering,
    'Whim\Marker\SensitiveParameterValue',
  ),
);

assert!(!Whim\Str\contains($sensitive_rendering, 'super-secret-pw-marker'));
