class LateSlot {
  public int $slot;
}

$late = new LateSlot();
$assertion_value_39 = function() use ($late): void {
  $x = $late->slot;
};

$assertion_error_39 = null;
try {
  $assertion_value_39();
} catch (UninitializedPropertyError $assertion_caught_39) {
  $assertion_error_39 = $assertion_caught_39;
}

assert!($assertion_error_39 is UninitializedPropertyError);

$late->slot = 5;
assert!($late->slot == 5);

class SealedBox {
  private int $secret = 1;
  protected int $level = 2;

  public function reveal(): int {
    return $this->secret + $this->level;
  }
}

$sealed = new SealedBox();
assert!($sealed->reveal() == 3);
$assertion_value_42 = function() use ($sealed): void {
  $x = $sealed->secret;
};

$assertion_error_42 = null;
try {
  $assertion_value_42();
} catch (VisibilityError $assertion_caught_42) {
  $assertion_error_42 = $assertion_caught_42;
}

assert!($assertion_error_42 is VisibilityError);

$assertion_value_43 = function() use ($sealed): void {
  $x = $sealed->level;
};

$assertion_error_43 = null;
try {
  $assertion_value_43();
} catch (VisibilityError $assertion_caught_43) {
  $assertion_error_43 = $assertion_caught_43;
}

assert!($assertion_error_43 is VisibilityError);

Filesystem\delete_directory($work, true);
