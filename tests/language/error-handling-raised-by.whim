use Whim\File;
use Whim\Filesystem;
use Whim\Unwind\ArgumentCountError;
use Whim\Unwind\ArithmeticError;
use Whim\Unwind\AssertionError;
use Whim\Unwind\DivisionByZeroError;
use Whim\Unwind\IncompatibleOperandsError;
use Whim\Unwind\InstantiationError;
use Whim\Unwind\LinkerError;
use Whim\Unwind\OutOfBoundsError;
use Whim\Unwind\OverflowError;
use Whim\Unwind\ReadonlyError;
use Whim\Unwind\RequireError;
use Whim\Unwind\StackOverflowError;
use Whim\Unwind\TypeError;
use Whim\Unwind\UndefinedSymbolError;
use Whim\Unwind\UndefinedVariableError;
use Whim\Unwind\UnderflowError;
use Whim\Unwind\UnhandledMatchError;
use Whim\Unwind\UninitializedPropertyError;
use Whim\Unwind\VisibilityError;

require!('_reject.whim');

$work = Filesystem\create_temporary_directory(null, 'whim-test-');

function needs_two(int $a, int $b): int {
  return $a + $b;
}

$assertion_value_1 = function(): void {
  needs_two(1);
};

$assertion_error_1 = null;
try {
  $assertion_value_1();
} catch (ArgumentCountError $assertion_caught_1) {
  $assertion_error_1 = $assertion_caught_1;
}

assert!($assertion_error_1 is ArgumentCountError);

$assertion_value_2 = function(): void {
  needs_two(1, 2, 3);
};

$assertion_error_2 = null;
try {
  $assertion_value_2();
} catch (ArgumentCountError $assertion_caught_2) {
  $assertion_error_2 = $assertion_caught_2;
}

assert!($assertion_error_2 is ArgumentCountError);

$assertion_value_3 = function(): void {
  needs_two(
    a: 1,
    ghost: 2,
  );
};

$assertion_error_3 = null;
try {
  $assertion_value_3();
} catch (ArgumentCountError $assertion_caught_3) {
  $assertion_error_3 = $assertion_caught_3;
}

assert!($assertion_error_3 is ArgumentCountError);

$assertion_value_4 = function(): void {
  $x = 1 << 64;
};

$assertion_error_4 = null;
try {
  $assertion_value_4();
} catch (ArithmeticError $assertion_caught_4) {
  $assertion_error_4 = $assertion_caught_4;
}

assert!($assertion_error_4 is ArithmeticError);

$assertion = null;
$assertion_callable_5 = function(): void {
  assert!(false, 'invariant broken');
};

try {
  $assertion_callable_5();
} catch (AssertionError $assertion_caught_5) {
  $assertion = $assertion_caught_5;
  assert!(
    Whim\Str\contains(
      $assertion_caught_5->getMessage(),
      'assertion failed: false',
    ),
  );
}

assert!($assertion is AssertionError);

assert!(Whim\Str\contains($assertion->getMessage(), 'invariant broken'));

$assertion_value_7 = function(): void {
  $x = 1 / 0;
};

$assertion_error_7 = null;
try {
  $assertion_value_7();
} catch (DivisionByZeroError $assertion_caught_7) {
  $assertion_error_7 = $assertion_caught_7;
}

assert!($assertion_error_7 is DivisionByZeroError);

$assertion_value_8 = function(): void {
  $x = 1 % 0;
};

$assertion_error_8 = null;
try {
  $assertion_value_8();
} catch (DivisionByZeroError $assertion_caught_8) {
  $assertion_error_8 = $assertion_caught_8;
}

assert!($assertion_error_8 is DivisionByZeroError);

$assertion_value_9 = function(): void {
  $x = 1.0 / 0.0;
};

$assertion_error_9 = null;
try {
  $assertion_value_9();
} catch (DivisionByZeroError $assertion_caught_9) {
  $assertion_error_9 = $assertion_caught_9;
}

assert!($assertion_error_9 is DivisionByZeroError);

$assertion_value_10 = function(): void {
  $x = '5' + 5;
};

$assertion_error_10 = null;
try {
  $assertion_value_10();
} catch (IncompatibleOperandsError $assertion_caught_10) {
  $assertion_error_10 = $assertion_caught_10;
}

assert!($assertion_error_10 is IncompatibleOperandsError);

$assertion_value_11 = function(): void {
  $x = 'a' . true;
};

$assertion_error_11 = null;
try {
  $assertion_value_11();
} catch (IncompatibleOperandsError $assertion_caught_11) {
  $assertion_error_11 = $assertion_caught_11;
}

assert!($assertion_error_11 is IncompatibleOperandsError);

$assertion_value_12 = function(): void {
  $x = 1 < 'a';
};

$assertion_error_12 = null;
try {
  $assertion_value_12();
} catch (IncompatibleOperandsError $assertion_caught_12) {
  $assertion_error_12 = $assertion_caught_12;
}

assert!($assertion_error_12 is IncompatibleOperandsError);

$assertion_value_13 = function(): void {
  $x = vec[1] < vec[2];
};

$assertion_error_13 = null;
try {
  $assertion_value_13();
} catch (IncompatibleOperandsError $assertion_caught_13) {
  $assertion_error_13 = $assertion_caught_13;
}

assert!($assertion_error_13 is IncompatibleOperandsError);

