class FixedCell {
  public function __construct(public readonly int $n) {}
}

$fixed = new FixedCell(1);
$assertion_value_22 = function() use ($fixed): void {
  $fixed->n = 2;
};

$assertion_error_22 = null;
try {
  $assertion_value_22();
} catch (ReadonlyError $assertion_caught_22) {
  $assertion_error_22 = $assertion_caught_22;
}

assert!($assertion_error_22 is ReadonlyError);

class WrittenTwice {
  public readonly int $n;

  public function __construct() {
    $this->n = 1;
    $this->n = 2;
  }
}

$assertion_value_23 = function(): void {
  $x = new WrittenTwice();
};

$assertion_error_23 = null;
try {
  $assertion_value_23();
} catch (ReadonlyError $assertion_caught_23) {
  $assertion_error_23 = $assertion_caught_23;
}

assert!($assertion_error_23 is ReadonlyError);

const TAKEN = 1;

$taken = $work . '/taken.whim';
File\write($taken, 'function TAKEN(): void {}' . "\n");
$assertion_value_24 = function() use ($taken): void {
  require!($taken);
};

$assertion_error_24 = null;
try {
  $assertion_value_24();
} catch (LinkerError $assertion_caught_24) {
  $assertion_error_24 = $assertion_caught_24;
}

assert!($assertion_error_24 is LinkerError);

$nowhere = $work . '/nowhere.whim';
$assertion_value_25 = function() use ($nowhere): void {
  require!($nowhere);
};

$assertion_error_25 = null;
try {
  $assertion_value_25();
} catch (RequireError $assertion_caught_25) {
  $assertion_error_25 = $assertion_caught_25;
}

assert!($assertion_error_25 is RequireError);

rejects(
  $work,
  'self-referential-constant',
  'const SELF = SELF + 1;' . "\n" . 'write_line!(\'never reached\');' . "\n",
  'refers to itself',
);

function dive(int $n): int {
  return dive($n + 1);
}

$assertion_value_26 = function(): void {
  dive(0);
};

$assertion_error_26 = null;
