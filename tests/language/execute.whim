assert!($handmade is Error);

assert!($handmade->getCode() == 7);

const GREETING = 'hi ' . 'there';

assert!(GREETING == 'hi there');

rejects(
  $work,
  'redeclared-name',
  'function twice(): void {}' . "\n" . 'const twice = 1;' . "\n",
  'the name twice is already declared',
);

/** Regression: a conditionally assigned addend must not hoist out of the loop. */
function conditional_sum(int $count): int {
  $total = 0;
  $i = 0;
  while ($i < $count) {
    if ($i > 0) {
      $x = 10;
    } else {
      $x = 20;
    }

    $total = $total + $x;
    $i = $i + 1;
  }

  return $total;
}

assert!(conditional_sum(1) == 20);
assert!(conditional_sum(2) == 30);
assert!(conditional_sum(3) == 40);
assert!(conditional_sum(4) == 50);

/** Accumulates through a method whose inlining once dropped the write. */
final class Accumulator {
  public int $value = 0;

  /** Adds an amount to the accumulated value. */
  public function add(int $amount): void {
    $this->value = $this->value + $amount;
  }
}

/** Drives the accumulator through a branching loop. */
function accumulate(int $count): int {
  $accumulator = new Accumulator();
  $i = 0;
  while ($i < $count) {
    if ($i > 0) {
      $accumulator->add(2);
    } else {
      $accumulator->add(5);
    }

    $i = $i + 1;
  }

  return $accumulator->value;
}

assert!(accumulate(5) == 13);

$never = $work . '/never-frame.whim';
File\write($never, 'function stop(): never {}' . "\n" . 'stop();' . "\n");
$run = Command\run($binary, vec[$never]);
assert!($run->status is Command\Exited);
assert!(($run->status as Command\Exited)->code == 255);
assert!(length!($run->standardOutput) == 0);
$assertion_value_58 = $run->standardError;
assert!(
  Whim\Str\contains(
    $assertion_value_58,
    "\n" . ' 0  stop' . "\n" . '    ' . $never . ':1',
  ),
);

assert!(
  !Whim\Str\contains(
    $assertion_value_58,
    "\n" . ' 0  stop' . "\n" . '    ' . $never . ':0',
  ),
);

Filesystem\delete_directory($work, true);
