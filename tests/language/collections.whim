function string_pair(string $left, string $right): (string, string) {
  return ($left, $right);
}

$paired = string_pair('left', 'right');
assert!($paired[0] == 'left');
assert!($paired[1] == 'right');

$removal_probe = vec['a', 'b', 'c'];
assert!(remove!($removal_probe, 1) == 'b');
assert!($removal_probe[1] == 'c');
assert!(length!($removal_probe) == 2);
assert!(remove_first!($removal_probe) == 'a');
assert!(remove_last!($removal_probe) == 'c');
assert!(length!($removal_probe) == 0);

$unordered = vec['a', 'b', 'c', 'd'];
assert!(swap_remove!($unordered, 1) == 'b');
assert!($unordered == vec['a', 'd', 'c']);
assert!(swap_remove!($unordered, 2) == 'c');
assert!($unordered == vec['a', 'd']);

$shared = vec[1, 2, 3];
$changed = $shared;
assert!(swap_remove!($changed, 0) == 1);
assert!($changed == vec[3, 2]);
assert!($shared == vec[1, 2, 3]);

final class RemovalHolder {
  public dict<string, string> $entries = dict['key' => 'value'];
  public vec<string> $items = vec['first', 'middle', 'last'];
  public dict<string, dict<string, string>> $nested = dict[
    'outer' => dict['inner' => 'nested'],
  ];

  public function removeEntry(string $key): void {
    remove!($this->entries, $key);
  }

  public function removeEntryGuarded(string $key): void {
    if (contains_key!($this->entries, $key)) {
      remove!($this->entries, $key);
    }
  }

  public function removeFirstItem(): void {
    remove_first!($this->items);
  }

  public function removeLastItem(): void {
    remove_last!($this->items);
  }

  public function swapRemoveItem(int $index): string {
    return swap_remove!($this->items, $index);
  }
}

final class RemovalOrderProbe {
  public vec<string> $events = vec[];
}

function removal_target(
  RemovalOrderProbe $probe,
  RemovalHolder $holder,
): RemovalHolder {
  $probe->events[] = 'target';
  return $holder;
}

function removal_index(RemovalOrderProbe $probe): int {
  $probe->events[] = 'index';
  return 1;
}

$removal_holder = new RemovalHolder();
assert!(remove!($removal_holder->entries, 'key') == 'value');
assert!($removal_holder->entries == dict[]);
assert!(remove_first!($removal_holder->items) == 'first');
assert!(remove_last!($removal_holder->items) == 'last');
assert!($removal_holder->items == vec['middle']);
assert!(remove!($removal_holder->nested['outer'], 'inner') == 'nested');
assert!($removal_holder->nested == dict['outer' => dict[]]);

$swap_removal_holder = new RemovalHolder();
assert!($swap_removal_holder->swapRemoveItem(0) == 'first');
assert!($swap_removal_holder->items == vec['last', 'middle']);

$removal_order_probe = new RemovalOrderProbe();
$removal_order_holder = new RemovalHolder();
assert!(
  swap_remove!(
    removal_target($removal_order_probe, $removal_order_holder)->items,
    removal_index($removal_order_probe),
  )
  == 'middle',
);

assert!($removal_order_probe->events == vec['target', 'index']);
assert!($removal_order_holder->items == vec['first', 'last']);

$discarded_removal_holder = new RemovalHolder();
$discarded_removal_holder->removeEntry('key');
$discarded_removal_holder->removeEntryGuarded('missing');
$discarded_removal_holder->removeFirstItem();
$discarded_removal_holder->removeLastItem();
assert!($discarded_removal_holder->entries == dict[]);
assert!($discarded_removal_holder->items == vec['middle']);

