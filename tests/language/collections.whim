use Whim\Command;
use Whim\Env;
use Whim\File;
use Whim\Filesystem;
use Whim\Unwind\AssertionError;
use Whim\Unwind\OutOfBoundsError;
use Whim\Unwind\TypeError;

$copied_left = vec[1, 2];
$copied_right = $copied_left;
$copied_right[] = 3;
$assertion_value_1 = $copied_left;
assert!(length!($assertion_value_1) == 2);
assert!($assertion_value_1 == vec[1, 2]);
$assertion_value_2 = $copied_right;
assert!(length!($assertion_value_2) == 3);
assert!($assertion_value_2 == vec[1, 2, 3]);

$work = Filesystem\create_temporary_directory(null, 'whim-test-');
$binary = Env\current_binary();
assert!($binary is string);

$debug_copies_file = $work . '/debug-vec-copies.whim';
File\write(
  $debug_copies_file,
  '$a = vec[1, 2];'
  . "\n"
  . '$b = $a;'
  . "\n"
  . '$b[] = 3;'
  . "\n"
  . 'debug!($a, $b);'
  . "\n",
);

$debug_copies = Command\run($binary, vec[$debug_copies_file]);
assert!($debug_copies->isSuccess());
assert!(length!($debug_copies->standardOutput) == 0);
assert!(
  $debug_copies->standardError
  == '['
  . Filesystem\canonicalize($debug_copies_file)
  . ':4:1] vec(2) ['
  . "\n"
  . '  1,'
  . "\n"
  . '  2,'
  . "\n"
  . '],'
  . "\n"
  . 'vec(3) ['
  . "\n"
  . '  1,'
  . "\n"
  . '  2,'
  . "\n"
  . '  3,'
  . "\n"
  . ']'
  . "\n",
);

$debug_tuple_file = $work . '/debug-single-tuple.whim';
File\write($debug_tuple_file, 'debug!((1,), vec[(2,)]);' . "\n");
$debug_tuple = Command\run($binary, vec[$debug_tuple_file]);
assert!($debug_tuple->isSuccess());
assert!(length!($debug_tuple->standardOutput) == 0);
$assertion_value_9 = $debug_tuple->standardError;
assert!(Whim\Str\contains($assertion_value_9, 'tuple(1) ['));
assert!(Whim\Str\contains($assertion_value_9, 'vec(1) ['));

$tuple_assertion = null;
$assertion_callable_10 = function(): void {
  assert!((1,) == (2,));
};

try {
  $assertion_callable_10();
} catch (AssertionError $assertion_caught_10) {
  $tuple_assertion = $assertion_caught_10;
}

assert!($tuple_assertion is AssertionError);

$assertion_value_11 = $tuple_assertion->getMessage();
assert!(Whim\Str\contains($assertion_value_11, 'left:  (1,)'));
assert!(Whim\Str\contains($assertion_value_11, 'right: (2,)'));

$written_left = vec[1];
$written_right = $written_left;
$written_right[0] = 9;
assert!($written_left[0] == 1);
assert!($written_right[0] == 9);

$ordered = dict['a' => 1, 'b' => 2, 'c' => 3];
$ordered['a'] = 10;
remove!($ordered, 'b');
$ordered['b'] = 20;
$ordered_keys = vec[];
$ordered_values = vec[];
foreach ($ordered as $key => $value) {
  $ordered_keys[] = $key;
  $ordered_values[] = $value;
}

assert!($ordered_keys == vec['a', 'c', 'b']);
assert!($ordered_values == vec[10, 3, 20]);

