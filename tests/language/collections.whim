class AppendBag {
  public vec<int> $items = vec[];
}

$append_bag = new AppendBag();
($append_bag->items[], $append_bag->items[]) = (10, 20);
assert!(length!($append_bag->items) == 2);
assert!($append_bag->items[0] == 10);
assert!($append_bag->items[1] == 20);

