$int_keyed = dict[5 => 'int'];
assert!($int_keyed[5] == 'int');
$string_keyed = dict['5' => 'string'];
assert!($string_keyed['5'] == 'string');

$mixed_keys = dict[5 => 'int'];
$mixed_keys['5'] = 'string';
assert!(length!($mixed_keys) == 2);
assert!($mixed_keys[5] == 'int');
assert!($mixed_keys['5'] == 'string');

$indexed_tuple = (10, 'x');
$indexed_text = 'abc';
assert!($indexed_tuple[0] == 10);
assert!($indexed_tuple[1] == 'x');
assert!($indexed_text[1] == 'b');
