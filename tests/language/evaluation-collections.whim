assert!($assertion_error_38 is IncompatibleOperandsError);

$assertion_value_39 = fn(): mixed => 'a' . (1, 2);
$assertion_error_39 = null;
try {
  $assertion_value_39();
} catch (IncompatibleOperandsError $assertion_caught_39) {
  $assertion_error_39 = $assertion_caught_39;
}

assert!($assertion_error_39 is IncompatibleOperandsError);

$assertion_value_40 = fn(): mixed => 'a' . new Widget();
$assertion_error_40 = null;
try {
  $assertion_value_40();
} catch (IncompatibleOperandsError $assertion_caught_40) {
  $assertion_error_40 = $assertion_caught_40;
}

assert!($assertion_error_40 is IncompatibleOperandsError);

assert!('n=' . 42 == 'n=42');
assert!('n=' . -7 == 'n=-7');
assert!('f=' . 5.0 == 'f=5.0');
assert!('f=' . 0.1 == 'f=0.1');
assert!('f=' . 1e100 == 'f=1e100');
$infinity = 1e308 * 10.0;
assert!('f=' . $infinity == 'f=INF');
assert!('f=' . -$infinity == 'f=-INF');
assert!('f=' . ($infinity - $infinity) == 'f=NAN');
assert!('a' . 'b' . 'c' == 'abc');
