use Whim\Autoload;
use Whim\File;
use Whim\Filesystem;
use Whim\Symbol;

function matches_scalar_vector(mixed $value): bool {
  return match ($value) {
    vec<int|string> => true,
    $_ => false,
  };
}

function matches_nested_dictionary<T>(mixed $value): bool {
  return match ($value) {
    dict<int|string, vec<(T, T)>> => true,
    $_ => false,
  };
}

assert!(matches_scalar_vector(vec[1, 'two', 3]));
assert!(!matches_scalar_vector(vec[1, 'two', false]));
assert!(!matches_scalar_vector((1, 'two', 3)));
assert!(matches_scalar_vector(vec[]));

assert!(matches_nested_dictionary::<int>(dict[1 => vec[(2, 3)]]));
assert!(matches_nested_dictionary::<string>(dict['pair' => vec[('a', 'b')]]));
assert!(!matches_nested_dictionary::<int>(dict['pair' => vec[(2, 'three')]]));
assert!(!matches_nested_dictionary::<int>(dict[true => vec[(2, 3)]]));
assert!(matches_nested_dictionary::<int>(dict[]));

function match_boolean_keys(mixed $value): mixed {
  return match ($value) {
    dict[true => $yes @ int, false => $no @ string] => ($yes, $no),
    dict[1 => $yes @ int, 0 => $no @ string] => 'integer keys',
    $_ => null,
  };
}

function match_boolean_rest(mixed $value): mixed {
  return match ($value) {
    dict[true => $yes, ...$rest @ string] => ($yes, $rest),
    $_ => null,
  };
}

assert!(match_boolean_keys(dict[false => 'no', true => 7]) == (7, 'no'));
assert!(match_boolean_keys(dict[0 => 'no', 1 => 7]) == 'integer keys');
assert!(match_boolean_keys(dict[true => 'wrong', false => 'no']) == null);
assert!(match_boolean_keys(dict[true => 7, false => 'no', 1 => 8]) == null);
assert!(
  match_boolean_rest(dict[true => 7, false => 'no', 1 => 'one']) == (
    7,
    dict[false => 'no', 1 => 'one'],
  ),
);

assert!(match_boolean_rest(dict[true => 7]) == (7, dict[]));
assert!(match_boolean_rest(dict[true => 7, false => 8]) == null);
assert!(
  match (dict[true => 1, 1 => 2, '1' => 3]) {
    dict[true => $boolean, 1 => $integer, '1' => $string] => (
      $boolean,
      $integer,
      $string,
    ),
  } == (1, 2, 3),
);

class BooleanPatternValue {
  public int $value = 42;
}

assert!(
  match (dict[false => new BooleanPatternValue()]) {
    dict[false => #{ $value }] => $value,
  }
  == 42,
);

function capture_vector_rest(mixed $value): mixed {
  return match ($value) {
    vec[$head, ...$rest @ int | string] => ($head, $rest),
    $_ => null,
  };
}

function capture_positional_rest(mixed $value): mixed {
  return match ($value) {
    ($head, ...(($rest) @ (int | string))) => ($head, $rest),
    $_ => null,
  };
}

function capture_dictionary_rest(mixed $value): mixed {
  return match ($value) {
    dict['head' => $head, ...$rest @ int | string] => ($head, $rest),
    $_ => null,
  };
}

assert!(capture_vector_rest(vec[true, 1, 'two']) == (true, vec[1, 'two']));
assert!(capture_vector_rest(vec[true]) == (true, vec[]));
assert!(capture_vector_rest(vec[true, false]) == null);
assert!(capture_positional_rest((true, 1, 'two')) == (true, vec[1, 'two']));
assert!(capture_positional_rest((true,)) == (true, vec[]));
assert!(capture_positional_rest((true, false)) == null);
assert!(
  capture_dictionary_rest(dict['head' => true, 7 => 1, 'other' => 'two']) == (
    true,
    dict[7 => 1, 'other' => 'two'],
  ),
);

assert!(capture_dictionary_rest(dict['head' => true]) == (true, dict[]));
assert!(
  capture_dictionary_rest(dict['head' => true, 'other' => false]) == null,
);

assert!(
  match (vec[1, 'two']) {
    vec[...($rest)] => $rest,
  } == vec[1, 'two'],
);

assert!(
  match ((1, 'two')) {
    (...$rest) => $rest,
  } == vec[1, 'two'],
);

assert!(
  match (dict[7 => 1]) {
    dict[...$rest] => $rest,
  } == dict[7 => 1],
);

$rows = vec[(1, 'one'), (2, 'two')];
assert!(
  match ($rows) {
    vec[...$rest @ (int, string)] => $rest,
  }
  == $rows,
);

assert!(
  match (vec[vec[1, 2], vec[]]) {
    vec[...vec[...int]] => true,
    $_ => false,
  },
);

assert!(
  match (vec[dict['value' => 1]]) {
    vec[...dict['value' => int]] => true,
    $_ => false,
  },
);

newtype PatternDescriptorId = int;

$ids = dict['pair' => vec[(PatternDescriptorId(2), PatternDescriptorId(3))]];
assert!(matches_nested_dictionary::<PatternDescriptorId>($ids));
assert!(matches_nested_dictionary::<int>($ids));
assert!(
  !matches_nested_dictionary::<PatternDescriptorId>(dict[
    'pair' => vec[(2, 3)],
  ]),
);

$values = vec[1, 'two'];
assert!(matches_scalar_vector($values));
$values[] = false;
assert!(!matches_scalar_vector($values));

$work = Filesystem\canonicalize(
  Filesystem\create_temporary_directory(null, 'whim-pattern-descriptors-'),
);

File\write(
  $work . '/element.whim',
  'type LatePatternElement = int; function pattern_element_loaded(): void {}',
);

$loader = new Autoload\Autoloader()->withSymbolFile(
  'LatePatternElement',
  $work . '/element.whim',
);

Autoload\register($loader);

$matchesLate = fn(
  mixed $value,
): bool {
  return match ($value) {
    vec<vec<LatePatternElement>> => true,
    $_ => false,
  };
};

assert!($matchesLate(vec[]));
assert!($matchesLate(vec[vec[]]));
assert!(!Symbol\exists('LatePatternElement', false));
assert!(!$matchesLate(vec[vec['wrong']]));
assert!(Symbol\exists('pattern_element_loaded', false));
assert!($matchesLate(vec[vec[1, 2], vec[3]]));
assert!(!$matchesLate(vec[vec[1, 2], vec[false]]));

Autoload\unregister($loader);
Filesystem\delete_directory($work, true);
