use Whim\Unwind\TypeError;

require_once!('_diagnostics.whim');

assert!(5 is int);
assert!(!(5 is float));
assert!(5.0 is float);
assert!('x' is string);
assert!(null is null);
assert!(true is bool);
assert!(vec[1] is vec<_>);
assert!(dict[] is dict<_, _>);
assert!((1, 'a') is (int, string));
assert!(!((1, 'a') is (int, int)));
assert!(5 is int|string);
assert!('y' is int|string);
assert!(!(null is int|string));

interface Shape {}

class Circle implements Shape {}

class Square {}

$circle = new Circle();
$square = new Square();
assert!($circle is Shape);
assert!($circle is Circle);
assert!(!($square is Shape));
assert!(!($square is Missing));

assert!(5 as int == 5);
$assertion_value_19 = function(): void {
  $_ = 'text' as int;
};

$assertion_error_19 = null;
try {
  $assertion_value_19();
} catch (TypeError $assertion_caught_19) {
  $assertion_error_19 = $assertion_caught_19;
  assert!(
    Whim\Str\contains(
      $assertion_caught_19->getMessage(),
      'expected int, string given',
    ),
  );
}

assert!($assertion_error_19 is TypeError);

assert!('text' ?as int == null);

$status = 'active';
assert!($status is 'active');
assert!(5 is 5);
assert!(!(6 is 5));
assert!(true is true);

type BooleanShape<T> = dict[true => T, false => string];

function matches_boolean_shape<T>(mixed $value): bool {
  return $value is BooleanShape<T>;
}

$booleanShape = dict[true => 7, false => 'no'];
assert!(matches_boolean_shape::<int>($booleanShape));
assert!(!matches_boolean_shape::<string>($booleanShape));
assert!(!matches_boolean_shape::<int>(dict[1 => 7, 0 => 'no']));
assert!(!matches_boolean_shape::<int>(dict[true => 7]));
assert!(!matches_boolean_shape::<int>(dict[true => 7, false => 'no', 1 => 8]));
assert!($booleanShape as BooleanShape<int> == $booleanShape);
assert!(dict[1 => 7, 0 => 'no'] ?as BooleanShape<int> == null);
assert!(
  dict[
    true => 1,
    1 => 'int',
    '1' => false,
  ] is dict[true => int, 1 => string, '1' => bool],
);

assert!(
  dict[
    false => 1,
    0 => 'int',
    '0' => true,
  ] is dict[false => int, 0 => string, '0' => bool],
);

assert!(
  dict[true => 7, false => 'no'] is dict[true => int, ...<false, string>],
);

assert!(!(dict[true => 7, 0 => 'no'] is dict[true => int, ...<false, string>]));
assert!(dict[true => 7, 1 => 'one'] is dict[true => int, ...<int, string>]);
assert!(
  !(dict[true => 7, false => 'no'] is dict[true => int, ...<int, string>]),
);

assert!(dict[true => 7, false => 'no', 1 => null] is dict[true => int, ...]);
assert!(
  Whim\Type\id::<dict[true => int]>() != Whim\Type\id::<dict[false => int]>(),
);

assert!(
  Whim\Type\id::<dict[true => int]>() != Whim\Type\id::<dict[1 => int]>(),
);

function boolean_shape_bound<T: dict<bool, int>>(T $value): T {
  return $value;
}

assert!(
  boolean_shape_bound::<dict[true => int, false => int]>(dict[
    true => 1,
    false => 2,
  ]) == dict[true => 1, false => 2],
);

interface BooleanShapeSource {
  public function read(): array<true, int>;
}

class BooleanShapeImplementation implements BooleanShapeSource {
  public function read(): dict[true => 1] {
    return dict[true => 1];
  }
}

assert!(new BooleanShapeImplementation()->read() == dict[true => 1]);

class BooleanShapeHolder {
  public BooleanShape<int> $value = dict[true => 1, false => 'no'];
}

$booleanHolder = new BooleanShapeHolder();
$caughtBooleanWrite = false;
try {
  $booleanHolder->value[true] = 'wrong';
} catch (TypeError $error) {
  $caughtBooleanWrite = true;
}

assert!($caughtBooleanWrite);
assert!($booleanHolder->value == dict[true => 1, false => 'no']);
$booleanShape[true] = 'changed';
assert!(!matches_boolean_shape::<int>($booleanShape));
assert!(matches_boolean_shape::<string>($booleanShape));

interface Named {}

interface Aged {}

class Person implements Named, Aged {}

class Robot implements Named {}

assert!(new Person() is Named&Aged);
assert!(!(new Robot() is Named&Aged));

interface Foo {
  public function getValues(): array<mixed, mixed>;
}

interface Bar extends Foo {
  public function getValues(): array<string|int|bool, mixed>;
}

interface Baz extends Bar {
  public function getValues(): dict<string|int|bool, mixed>;
}

interface Qux extends Baz {
  public function getValues(): dict['foo' => int, 'bar' => string, ...];
}

interface Quux extends Qux {
  public function getValues(
  ): dict['foo' => int, 'bar' => 'hello', 'baz' => bool, ...<string
  | int
  | bool, mixed>];
}

interface Corge extends Quux {
  public function getValues(
  ): dict['foo' => 42, 'bar' => 'hello', 'baz' => bool, ...<int|bool, string>];
}

class MyClass implements Corge {
  public function getValues(
  ): dict['foo' => 42, 'bar' => 'hello', 'baz' => true, ...<int|bool, string>] {
    return dict['foo' => 42, 'bar' => 'hello', 'baz' => true, 1 => 'one'];
  }
}

class LiteralRestKey implements Corge {
  public function getValues(
  ): dict['foo' => 42, 'bar' => 'hello', 'baz' => bool, ...<1, string>] {
    return dict['foo' => 42, 'bar' => 'hello', 'baz' => true, 1 => 'one'];
  }
}

class NarrowRestKey implements Corge {
  public function getValues(
  ): dict['foo' => 42, 'bar' => 'hello', 'baz' => bool, ...<int, string>] {
    return dict['foo' => 42, 'bar' => 'hello', 'baz' => true, 1 => 'one'];
  }
}

class LiteralRestValue implements Corge {
  public function getValues(
  ): dict['foo' => 42, 'bar' => 'hello', 'baz' => bool, ...<int|bool, 'one'>] {
    return dict['foo' => 42, 'bar' => 'hello', 'baz' => true, 1 => 'one'];
  }
}

class RequiredRestEntry implements Corge {
  public function getValues(
  ): dict['foo' => 42, 'bar' => 'hello', 'baz' => bool, 1 => 'one', ...<int
  | bool, string>] {
    return dict['foo' => 42, 'bar' => 'hello', 'baz' => true, 1 => 'one'];
  }
}

class ClosedShape implements Corge {
  public function getValues(
  ): dict['foo' => 42, 'bar' => 'hello', 'baz' => true, 1 => 'one'] {
    return dict['foo' => 42, 'bar' => 'hello', 'baz' => true, 1 => 'one'];
  }
}

raises('_types/dict-shape-rest-widening.whim', 'return type is not covariant');
