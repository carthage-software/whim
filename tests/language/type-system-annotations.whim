use Whim\Unwind\CompilerError;
use Whim\Unwind\IncompatibleOperandsError;
use Whim\Unwind\LinkerError;
use Whim\Unwind\OutOfBoundsError;
use Whim\Unwind\ReadonlyError;
use Whim\Unwind\TypeError;
use Whim\Unwind\UninitializedPropertyError;

require_once!('_diagnostics.whim');

raises(
  '_type-system-annotations/classname-of-int.whim',
  '`classname<T>` requires an inner type that can contain a class-like type',
);

raises('_type-system-annotations/parent-without-parent.whim', 'has no parent');

$assertion_value_1 = function(): void {
  require!('_type-system-annotations/literal_mismatch.whim');
};

$assertion_error_1 = null;
try {
  $assertion_value_1();
} catch (CompilerError $assertion_caught_1) {
  $assertion_error_1 = $assertion_caught_1;
}

assert!($assertion_error_1 is CompilerError);

