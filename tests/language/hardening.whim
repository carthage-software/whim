use Whim\Autoload;

require_once!('_files.whim');
require_once!('_process.whim');

$s = '';
$i = 0;
while ($i < 2000) {
  $s .= 'ab';
  $i = $i + 1;
}

$snapshot = $s;
$j = 0;
while ($j < 2000) {
  $s .= 'cd';
  $j = $j + 1;
}

assert!(length!($snapshot) == 4000);
assert!(length!($s) == 8000);
$t = $s;
$t .= '!';
assert!(length!($s) == 8000);
assert!(length!($t) == 8001);

$doubled = 'abcdefghijklmnopqrstuvwxyz0123456789';
$doubling = 0;
while ($doubling < 6) {
  $doubled .= $doubled;
  $doubling = $doubling + 1;
}

assert!(length!($doubled) == 2304);

prints(
  'catchable-overflow',
  'depth exceeded gracefully' . "\n",
  dict['WHIM_CALL_DEPTH' => '512'],
);

function count_down(int $n): int {
  if ($n <= 0) {
    return 0;
  }

  return count_down($n - 1);
}

assert!(count_down(9000) == 0);
assert!(count_down(5) == 0);
assert!(count_down(1) == 0);

$nested = vec[];
$depth = 0;
while ($depth < 100000) {
  $nested = vec[$nested];
  $depth = $depth + 1;
}

$nested = null;
assert!($nested == null);
assert!($depth == 100000);

class Node {
  public mixed $peer = null;
}

$cycles = 0;
while ($cycles < 20000) {
  $a = new Node();
  $b = new Node();
  $a->peer = $b;
  $b->peer = $a;
  $cycles = $cycles + 1;
}

assert!($cycles == 20000);

require!('_hardening/switch-table.whim');

/** Sums the widest parameter list a declaration or call site may write. */
