/** Sums values that arrive through one collection argument. */
function total_of_values(vec $values): int {
  $sum = 0;
  foreach ($values as $value) {
    $sum = $sum + $value;
  }

  return $sum;
}

$values = vec[];
$index = 0;
while ($index < 250) {
  $values[] = $index;
  $index = $index + 1;
}

assert!(total_of_values($values) == 31125);

require!('_hardening/nested-finally.whim');

Autoload\register(
  new Autoload\Autoloader()->withSymbolFile(
    'Lazy\Probe',
    beside('_hardening/probe.whim'),
  ),
);

$unwound = 0;
$mismatched = 0;
$attempt = 0;
while ($attempt < 1000) {
  try {
    try {
      throw new Whim\Unwind\Error('inner', 0);
    } catch (Lazy\Probe $_) {
      $mismatched = $mismatched + 1;
    }
  } catch (Whim\Unwind\Error $_) {
    $unwound = $unwound + 1;
  }

  $attempt = $attempt + 1;
}

assert!($mismatched == 0);
assert!($unwound == 1000);
