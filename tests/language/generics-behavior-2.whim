interface UnionConsumer<in T> {
  public function consume(T $value): void;
}

class FooConsumer implements
  UnionConsumer<int>,
  UnionConsumer<string>,
  UnionConsumer<vec<string>> {
  public function consume(int|string|vec<string> $value): void {}
}

$consumer = new FooConsumer();
assert!($consumer is UnionConsumer<int>);
assert!($consumer is UnionConsumer<string>);
assert!($consumer is UnionConsumer<vec<string>>);
assert!($consumer is UnionConsumer<int|string|vec<string>>);

class StringOnlyConsumer implements UnionConsumer<string> {
  public function consume(string $value): void {}
}

class ChildUnionConsumer extends StringOnlyConsumer implements
  UnionConsumer<int> {
  public function consume(int|string $value): void {}
}

$childConsumer = new ChildUnionConsumer();
assert!($childConsumer is UnionConsumer<int>);
assert!($childConsumer is UnionConsumer<string>);
assert!($childConsumer is UnionConsumer<int|string>);

interface IntersectionProducer<out T> {
  public function produce(): T;
}

class EmptyProducer implements
  IntersectionProducer<int>,
  IntersectionProducer<string> {
  public function produce(): never {
    throw new Whim\Unwind\Error('no value');
  }
}

$producer = new EmptyProducer();
assert!($producer is IntersectionProducer<int>);
assert!($producer is IntersectionProducer<string>);

interface LinkMarker {}

class LinkMarked implements LinkMarker {}

class LinkBase<T: LinkMarker> {}

class LinkConcrete extends LinkBase<LinkMarked> {}

class LinkGeneric<U: LinkMarker> extends LinkBase<U> {}

assert!(new LinkConcrete() is LinkBase<LinkMarked>);
assert!(new LinkGeneric::<LinkMarked>() is LinkBase<LinkMarked>);

