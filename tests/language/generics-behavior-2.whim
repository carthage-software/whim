use Whim\Command;
use Whim\Env;
use Whim\File;
use Whim\Filesystem;
use Whim\Unwind\LinkerError;
use Whim\Unwind\TypeError;

class TransformBase {
  public function transform(int $value): int|string {
    return $value;
  }
}

class WiderInputNarrowerOutput extends TransformBase {
  public function transform(mixed $value): int {
    return 1;
  }
}

interface Maker<T> {
  public function make(): T;
}

class IntMaker implements Maker<int> {
  public function make(): int {
    return 1;
  }
}

interface ValueConsumer<T> {
  public function consume(T $value): mixed;
}

class IntValueConsumer implements ValueConsumer<int> {
  public function consume(mixed $value): mixed {
    return $value;
  }
}

assert!(new WiderInputNarrowerOutput()->transform('accepted') == 1);
assert!(new IntMaker()->make() == 1);
assert!(new IntValueConsumer()->consume('accepted') == 'accepted');

$work = Filesystem\create_temporary_directory(null, 'whim-test-');

File\write(
  $work . '/narrowed-parameter.whim',
  'class NarrowBase { public function transform(int $value): mixed { return $value; } }'
  . "\n\n"
  . 'class NarrowBroken extends NarrowBase {'
  . "\n"
  . '    public function transform(string $value): mixed { return $value; }'
  . "\n"
  . '}'
  . "\n",
);

$narrowedParameter = $work . '/narrowed-parameter.whim';
$assertion_value_4 = function() use ($narrowedParameter): void {
  require!($narrowedParameter);
};

$assertion_error_4 = null;
try {
  $assertion_value_4();
} catch (LinkerError $assertion_caught_4) {
  $assertion_error_4 = $assertion_caught_4;
  assert!(
    Whim\Str\contains(
      $assertion_caught_4->getMessage(),
      'parameter 1 is not contravariant',
    ),
  );
}

assert!($assertion_error_4 is LinkerError);

