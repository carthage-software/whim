}

assert!($assertion_error_20 is LinkerError);

type Deep<T> = vec<(T, dict<string, T>)>;

class AliasBox<T> {}

class IntAliasBox extends AliasBox<int> {}

class StringAliasBox extends AliasBox<string> {}

/** Accepts only class names that specialize AliasBox<int>. */
function class_name(classname<AliasBox<int>> $name): string {
  return $name;
}

$deep = vec[(1, dict['one' => 1])];
assert!($deep is Deep<int>);
$deep[] = (2, dict['two' => 'wrong']);
assert!(!($deep is Deep<int>));
assert!(class_name('AliasBox<int>') == 'AliasBox<int>');
assert!(class_name('IntAliasBox') == 'IntAliasBox');
$assertion_value_25 = function(): void {
  class_name('StringAliasBox');
};

$assertion_error_25 = null;
try {
  $assertion_value_25();
} catch (TypeError $assertion_caught_25) {
  $assertion_error_25 = $assertion_caught_25;
}

assert!($assertion_error_25 is TypeError);

$assertion_value_26 = function(): void {
  class_name('MissingAliasBox');
};

$assertion_error_26 = null;
try {
  $assertion_value_26();
} catch (TypeError $assertion_caught_26) {
  $assertion_error_26 = $assertion_caught_26;
}

assert!($assertion_error_26 is TypeError);

$wide = function(mixed $value): int {
  return 1;
};

assert!($wide is fn(int): int|string);
assert!(!($wide is fn(mixed): 1));

class WildBox<T> {
  public function __construct(public T $value) {}
}

class WildPair<A, B> {
  public function __construct(public A $first, public B $second) {}
}

$wildBox = new WildBox::<string>('x');
$wildPair = new WildPair::<string, int>('x', 1);
assert!($wildBox is WildBox);
assert!($wildBox is WildBox<_>);
assert!(!($wildBox is WildBox<mixed>));
assert!($wildPair is WildPair<_, int>);
assert!(!($wildPair is WildPair<_, string>));
assert!(('x', 1, false) is (string, int, _));
assert!(vec[1, 'x'] is vec<_>);
$wildCallable = fn(string $value): int => length!($value);
assert!($wildCallable is fn(_): int);

final class DeclaredPair<A, B> {
  public function __construct(public A $first, public B $second) {}
}

/** Projects the second slot through a wildcard first slot. */
function second_of<T>(DeclaredPair<_, T> $pair): T {
  return $pair->second;
}

/** Collects values through a wildcard key slot. */
function values_of<T>(array<_, T> $items): vec<T> {
  $result = vec[];
  foreach ($items as $item) {
    $result[] = $item;
  }

  return $result;
}

$declaredPair = new DeclaredPair::<string, int>('answer', 42);
assert!(second_of::<int>($declaredPair) == 42);
assert!(values_of::<int>(dict['one' => 1, 'two' => 2]) == vec[1, 2]);
assert!(values_of::<int>(vec[3, 4]) == vec[3, 4]);

final class AliasClient {
  public function request(): string {
    return 'ok';
  }
}

type LegacyClient = AliasClient;

$legacy = new LegacyClient();
assert!($legacy is AliasClient);
assert!($legacy is LegacyClient);
assert!($legacy->request() == 'ok');

final class QuadBox<A, B, C, D> {
  public function __construct(public C $value) {}
}

type Special<T> = QuadBox<int, string, T, (T, int)>;

$special = new Special::<float>(1.5);
assert!($special is QuadBox<int, string, float, (float, int)>);

assert!($special is Special<float>);
assert!($special->value == 1.5);

class ArityPair<A, B> {}

class ArityBox<T> {}

$arityPair = new ArityPair::<int, string>();
$assertion_value_46 = function() use ($arityPair): void {
  $_ = $arityPair is ArityPair<_>;
};

$assertion_error_46 = null;
try {
  $assertion_value_46();
} catch (TypeError $assertion_caught_46) {
  $assertion_error_46 = $assertion_caught_46;
  assert!(
    Whim\Str\contains(
      $assertion_caught_46->getMessage(),
      'expects exactly 2 type argument(s), 1 provided',
    ),
  );
}

assert!($assertion_error_46 is TypeError);

$arityBox = new ArityBox::<int>();
$assertion_value_47 = function() use ($arityBox): void {
  $_ = $arityBox ?as ArityBox<string, string, int>;
};

$assertion_error_47 = null;
try {
  $assertion_value_47();
} catch (TypeError $assertion_caught_47) {
  $assertion_error_47 = $assertion_caught_47;
  assert!(
    Whim\Str\contains(
      $assertion_caught_47->getMessage(),
      'expects at most 1 type argument(s), 3 provided',
    ),
  );
}

assert!($assertion_error_47 is TypeError);

File\write(
  $work . '/debug-render.whim',
  'class DebugBox<T> {'
  . "\n"
  . '    public function __construct(public T $value) {}'
  . "\n"
  . '}'
  . "\n\n"
  . 'function debug_id<T>(T $value): T { return $value; }'
  . "\n\n"
  . '$box = new DebugBox::<string>(\'x\');'
  . "\n"
  . 'debug!($box, debug_id::<int>(...));'
  . "\n",
);

$binary = Env\current_binary();
assert!($binary is string);
$debugRender = Command\run($binary, vec[$work . '/debug-render.whim']);
assert!($debugRender->isSuccess());
assert!(length!($debugRender->standardOutput) == 0);
assert!(
  $debugRender->standardError
  == '['
  . Filesystem\canonicalize($work . '/debug-render.whim')
  . ':8:1] DebugBox<string> {'
  . "\n"
  . '  public string $value = string(1) "x";'
  . "\n"
  . '},'
  . "\n"
  . 'fn(int): int {'
  . "\n"
  . '  target = debug_id;'
  . "\n"
  . '  presets(1) ['
  . "\n"
  . '    <hole 0>,'
  . "\n"
  . '  ];'
  . "\n"
  . '}'
  . "\n",
);

Filesystem\delete_directory($work, true);
