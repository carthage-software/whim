use Whim\Attribute\Attribute;
use Whim\Lint\{Allow, Deny, Forbid, Warn};
use Whim\Reflection;
use Whim\Unwind\ArgumentCountError;
use Whim\Unwind\Error;

#![Allow('no-debug-symbols')]
#![Warn(
  rule: 'no-redundant-variable',
  reason: 'Test fixture',
)]

#![Deny('no-self-assignment')]
#![Forbid('no-multi-assignments')]

#[Attribute(Attribute::TARGET_METHOD | Attribute::TARGET_FUNCTION)]
final class Deprecated {
  public function __construct(public readonly string $reason = '') {}
}

#[Deprecated('use send() instead')]
function deliver(): string {
  return 'delivered';
}

assert!(deliver() == 'delivered');
assert!(Attribute::TARGET_CLASS == 1);
assert!(Attribute::TARGET_FUNCTION == 2);
assert!(Attribute::TARGET_METHOD == 4);
assert!(Attribute::TARGET_PROPERTY == 8);
assert!(Attribute::TARGET_CLASS_CONSTANT == 16);
assert!(Attribute::TARGET_PARAMETER == 32);
assert!(Attribute::TARGET_TYPE_ALIAS == 128);
assert!(Attribute::TARGET_FILE == 1024);
assert!(Attribute::TARGET_ALL == 1983);
assert!(Attribute::IS_REPEATABLE == 64);

$assertion_value_27 = fn(): void {
  new Whim\Marker\SensitiveParameterValue();
};

$assertion_error_27 = null;
try {
  $assertion_value_27();
} catch (ArgumentCountError $assertion_caught_27) {
  $assertion_error_27 = $assertion_caught_27;
}

assert!($assertion_error_27 is ArgumentCountError);

assert!(new Whim\Marker\SensitiveParameterValue(null)->getValue() == null);

function login(
  string $user,
  #[Whim\Marker\SensitiveParameter] string $password,
): bool {
  throw new Error('denied', 0);
}

$denied = null;
$assertion_callable_29 = fn(): void {
  login('ada', 'hunter2');
};

try {
  $assertion_callable_29();
} catch (Error $assertion_caught_29) {
  $denied = $assertion_caught_29;
  assert!(Whim\Str\contains($assertion_caught_29->getMessage(), 'denied'));
}

assert!($denied is Error);

$deniedArguments = $denied->getTrace()[0]->arguments;
assert!($deniedArguments[0] == 'ada');
$wrappedPassword = $deniedArguments[1];
assert!($wrappedPassword is Whim\Marker\SensitiveParameterValue);

assert!($wrappedPassword->getValue() == 'hunter2');
assert!(!Whim\Str\contains($denied->toString(), 'hunter2'));

#[Allow('no-debug-symbols')]
#[Allow(
  rule: 'sensitive' . '-' . 'parameter',
  reason: 'Grammar token',
)]
#[Warn(
  reason: 'Test fixture',
  rule: 'no-redundant-variable',
)]
#[Deny('no-self-assignment', reason: 'Keep the check')]
#[Forbid('no-literal-password', 'Keep secrets out of source')]
function lint_attributes(): string {
  return 'checked';
}

assert!(lint_attributes() == 'checked');
$linted = Reflection\reflect_function('lint_attributes');
assert!($linted != null);
$file = $linted->getFile();
assert!(
  $file->getAttributes::<Allow>()[0]->newInstance()->rule == 'no-debug-symbols',
);

assert!(
  $file->getAttributes::<Warn>()[0]->newInstance()->reason == 'Test fixture',
);

assert!(
  $file->getAttributes::<Deny>()[0]->newInstance()->rule
  == 'no-self-assignment',
);

assert!(
  $file->getAttributes::<Forbid>()[0]->newInstance()->rule
  == 'no-multi-assignments',
);

$allowed = $linted->getAttributes::<Allow>();
assert!(length!($allowed) == 2);
assert!($allowed[0]->newInstance()->rule == 'no-debug-symbols');
assert!($allowed[0]->newInstance()->reason == null);
assert!($allowed[1]->newInstance()->rule == 'sensitive-parameter');
assert!($allowed[1]->newInstance()->reason == 'Grammar token');
assert!(
  $allowed[1]->getNamedArguments() == dict[
    'rule' => 'sensitive-parameter',
    'reason' => 'Grammar token',
  ],
);

assert!(
  $linted->getAttributes::<Warn>()[0]->newInstance()->rule
  == 'no-redundant-variable',
);

assert!(
  $linted->getAttributes::<Warn>()[0]->newInstance()->reason == 'Test fixture',
);

assert!(
  $linted->getAttributes::<Deny>()[0]->newInstance()->rule
  == 'no-self-assignment',
);

assert!(
  $linted->getAttributes::<Deny>()[0]->newInstance()->reason
  == 'Keep the check',
);

assert!(
  $linted->getAttributes::<Forbid>()[0]->newInstance()->rule
  == 'no-literal-password',
);

assert!(
  $linted->getAttributes::<Forbid>()[0]->newInstance()->reason
  == 'Keep secrets out of source',
);

foreach (vec[
  new Allow('no-debug-symbols'),
  new Warn('no-debug-symbols'),
  new Deny('no-debug-symbols'),
  new Forbid('no-debug-symbols'),
] as $control) {
  assert!($control->rule == 'no-debug-symbols');
  assert!($control->reason == null);
  $control->rule = 'no-self-assignment';
  assert!($control->rule == 'no-self-assignment');
  $definition = Reflection\reflect_class($control)?->getAttributeDefinition();
  assert!($definition != null);
  assert!($definition->isRepeatable());
  assert!(length!($definition->getTargets()) == 10);
}

class LintAttributeParameters {
  #[Allow(
    rule: 'no-insecure-comparison',
    reason: 'The token is not security-sensitive',
  )]
  private function hasToken(
    string $candidate,
    #[Allow(
      reason: 'This is not a security-sensitive parameter',
      rule: 'sensitive-parameter',
    )]
    string $token,
  ): bool {
    return $candidate == $token;
  }
}

$tokenMethod = Reflection\reflect_class('LintAttributeParameters')?->getMethod(
  'hasToken',
);

assert!($tokenMethod != null);
$methodAttribute = $tokenMethod->getAttributes::<Allow>()[0]->newInstance();
assert!($methodAttribute->rule == 'no-insecure-comparison');
assert!($methodAttribute->reason == 'The token is not security-sensitive');
$tokenParameter = $tokenMethod->getParameter('token');
assert!($tokenParameter != null);
$parameterAttribute = $tokenParameter->getAttributes::<
  Allow,
>()[0]->newInstance();

assert!($parameterAttribute->rule == 'sensitive-parameter');
assert!(
  $parameterAttribute->reason == 'This is not a security-sensitive parameter',
);
