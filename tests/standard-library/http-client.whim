  new Client\ConnectionMetadata($local, $peer, Message\ProtocolVersion::V11),
  false,
);

$coalescedH1 = new Client\DefaultClient(
  new Client\PooledConnector($gatedH1),
  new Client\Configuration(protocolVersions: vec[Message\ProtocolVersion::V11]),
);

$coalescedH1First = Async\spawn::<Transaction>(
