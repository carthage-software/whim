  $pushStream,
  new Client\ConnectionMetadata($local, $peer, Message\ProtocolVersion::V2),
  new H2\Configuration(),
)->exchange(
  Request::fromURL(
    Message\METHOD_GET,
    URL::from('https://example.com/document'),
  ),
  new Client\Configuration(),
);

