$uncappedMultiplexed = new CountingConnector(
  new Client\ConnectionMetadata($local, $peer, Message\ProtocolVersion::V2),
  true,
);

$uncappedMultiplexedClient = new Client\DefaultClient(
  new Client\PooledConnector($uncappedMultiplexed, 0, 0),
  new Client\Configuration(protocolVersions: vec[Message\ProtocolVersion::V2]),
);

$uncappedMultiplexedFirst = $uncappedMultiplexedClient->send(
  Request::fromURL(Message\METHOD_GET, URL::from('https://example.com/one')),
);

$uncappedMultiplexedSecond = $uncappedMultiplexedClient->send(
  Request::fromURL(Message\METHOD_GET, URL::from('https://example.com/two')),
);

assert!($uncappedMultiplexed->connections == 1);
$uncappedMultiplexedFirstBody = $uncappedMultiplexedFirst->response->body;
$uncappedMultiplexedSecondBody = $uncappedMultiplexedSecond->response->body;
assert!($uncappedMultiplexedFirstBody != null);
assert!($uncappedMultiplexedSecondBody != null);
discard!($uncappedMultiplexedFirstBody->readAll());
discard!($uncappedMultiplexedSecondBody->readAll());

$originLimited = new CountingConnector(
  new Client\ConnectionMetadata($local, $peer, Message\ProtocolVersion::V11),
);

$originLimitedPool = new Client\PooledConnector($originLimited, 10, 1);
$originLimitedConfiguration = new Client\Configuration(
  protocolVersions: vec[Message\ProtocolVersion::V11],
);

$originLimitedRequests = vec[
  Request::fromURL(Message\METHOD_GET, URL::from('http://example.com/one')),
  Request::fromURL(Message\METHOD_GET, URL::from('http://example.com/two')),
  Request::fromURL(Message\METHOD_GET, URL::from('http://example.com/three')),
];

$originLimitedTransactions = vec[];
foreach ($originLimitedRequests as $request) {
  $connection = $originLimitedPool->connect(
    Client\Origin::fromURL($request->url),
    $request,
    $originLimitedConfiguration,
  );

  $originLimitedTransactions[] = $connection->exchange(
    $request,
    $originLimitedConfiguration,
  );
}

assert!($originLimited->connections == 3);
foreach ($originLimitedTransactions as $transaction) {
  $body = $transaction->response->body;
  assert!($body != null);
  discard!($body->readAll());
}

assert!($originLimited->opened[0]->isClosed());
assert!($originLimited->opened[1]->isClosed());
assert!(!($originLimited->opened[2]->isClosed()));

$originLimitedRequest = Request::fromURL(
  Message\METHOD_GET,
  URL::from('http://example.com/four'),
);

$originLimitedConnection = $originLimitedPool->connect(
  Client\Origin::fromURL($originLimitedRequest->url),
  $originLimitedRequest,
  $originLimitedConfiguration,
);

$originLimitedTransaction = $originLimitedConnection->exchange(
  $originLimitedRequest,
  $originLimitedConfiguration,
);

$originLimitedBody = $originLimitedTransaction->response->body;
assert!($originLimitedBody != null);
discard!($originLimitedBody->readAll());
assert!($originLimited->connections == 3);

$globallyLimited = new CountingConnector(
  new Client\ConnectionMetadata($local, $peer, Message\ProtocolVersion::V11),
);

$globallyLimitedPool = new Client\PooledConnector($globallyLimited, 2, 2);
$globallyLimitedConfiguration = new Client\Configuration(
  protocolVersions: vec[Message\ProtocolVersion::V11],
);

$globallyLimitedRequests = vec[
  Request::fromURL(Message\METHOD_GET, URL::from('http://one.example/a')),
  Request::fromURL(Message\METHOD_GET, URL::from('http://two.example/b')),
  Request::fromURL(Message\METHOD_GET, URL::from('http://three.example/c')),
];

$globallyLimitedTransactions = vec[];
foreach ($globallyLimitedRequests as $request) {
  $connection = $globallyLimitedPool->connect(
    Client\Origin::fromURL($request->url),
    $request,
    $globallyLimitedConfiguration,
  );

  $globallyLimitedTransactions[] = $connection->exchange(
    $request,
    $globallyLimitedConfiguration,
  );
}

foreach ($globallyLimitedTransactions as $transaction) {
  $body = $transaction->response->body;
  assert!($body != null);
  discard!($body->readAll());
}

assert!($globallyLimited->opened[0]->isClosed());
assert!(!($globallyLimited->opened[1]->isClosed()));
assert!(!($globallyLimited->opened[2]->isClosed()));
