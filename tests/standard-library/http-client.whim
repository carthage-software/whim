$counting = new CountingConnector(
  new Client\ConnectionMetadata($local, $peer, Message\ProtocolVersion::V11),
);

$pooled = new Client\DefaultClient(new Client\PooledConnector($counting));
$firstPooled = $pooled->send(
  Request::fromURL(Message\METHOD_GET, URL::from('http://example.com/one')),
);

$firstPooledBody = $firstPooled->response->body;
assert!($firstPooledBody != null);
assert!(!($firstPooledBody->reachedEndOfDataSource()));

$secondPooled = $pooled->send(
  Request::fromURL(Message\METHOD_GET, URL::from('http://example.com/two')),
);

assert!($counting->connections == 2);
assert!($firstPooledBody->readAll() == 'response-1');

$thirdPooled = $pooled->send(
  Request::fromURL(Message\METHOD_GET, URL::from('http://example.com/three')),
);

assert!($counting->connections == 2);
assert!($counting->opened[0]->exchanges == 2);
$secondPooledBody = $secondPooled->response->body;
assert!($secondPooledBody != null);
$_ = $secondPooledBody->readAll();
$thirdPooledBody = $thirdPooled->response->body;
assert!($thirdPooledBody != null);
$_ = $thirdPooledBody->readAll();

