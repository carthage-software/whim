$stream = new ScriptedStream(
  vec[
    "HTTP/1.1 103 Early Hints\r\nLink: </style.css>; rel=preload\r\n\r\n",
    "HTTP/1.1 200 OK\r\nContent-Length: 5\r\nX-Test: yes\r\n\r\nhello",
  ],
  $local,
  $peer,
);

$h1 = new Client\_Private\H1Connection(
  $stream,
  new Client\ConnectionMetadata($local, $peer, Message\ProtocolVersion::V11),
);

$result = $h1->exchange(
  Request::fromURL(
    Message\METHOD_GET,
    URL::from('http://example.com/path?q=1'),
  ),
  new Client\Configuration(),
);

assert!(length!($result->informational) == 1);
assert!($result->informational[0]->status == Message\STATUS_EARLY_HINTS);

assert!($result->response->headers->get('x-test') == 'yes');
$responseBody = $result->response->body;
assert!($responseBody != null);
assert!($responseBody->readAll() == 'hello');
assert!(!($stream->isClosed()));
assert!(
  $stream->written
  == "GET /path?q=1 HTTP/1.1\r\nHost: example.com\r\nContent-Length: 0\r\n\r\n",
);

