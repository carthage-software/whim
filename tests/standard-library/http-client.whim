$flaky = new FlakyClient(2);
$retried = new Client\RetryClient($flaky, backoff: Duration::zero())->send(
  Request::fromURL(
    Message\METHOD_PUT,
    URL::from('https://example.com/resource'),
    body: new Whim\IO\MemoryHandle('repeat me'),
  ),
);

assert!($retried->response->status == Message\STATUS_OK);
assert!($flaky->attempts == 3);
assert!($flaky->requestBodies == vec['repeat me', 'repeat me', 'repeat me']);

