$gated = new GatedMultiplexedConnector(
  new Client\ConnectionMetadata($local, $peer, Message\ProtocolVersion::V2),
);

$coalesced = new Client\DefaultClient(
  new Client\PooledConnector($gated),
  new Client\Configuration(protocolVersions: vec[Message\ProtocolVersion::V2]),
);

$coalescedFirst = Async\spawn::<Transaction>(
  fn(): Transaction => (
    $coalesced->send(
      Request::fromURL(
        Message\METHOD_GET,
        URL::from('https://example.com/one'),
      ),
    )
  ),
);

$coalescedSecond = Async\spawn::<Transaction>(
  fn(): Transaction => (
    $coalesced->send(
      Request::fromURL(
        Message\METHOD_GET,
        URL::from('https://example.com/two'),
      ),
    )
  ),
);

Async\later();
assert!($gated->connections == 1);
$gated->release();
$coalescedFirstBody = $coalescedFirst->await()->response->body;
$coalescedSecondBody = $coalescedSecond->await()->response->body;
assert!($coalescedFirstBody != null);
assert!($coalescedSecondBody != null);
discard!($coalescedFirstBody->readAll());
discard!($coalescedSecondBody->readAll());
assert!($gated->connections == 1);

