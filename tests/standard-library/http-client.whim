    $assertion_value_42();
  } catch (Client\ProtocolException $assertion_caught_42) {
    $assertion_error_42 = $assertion_caught_42;
  }

  assert!($assertion_error_42 is Client\ProtocolException);

  assert!($invalidFramingStream->isClosed());
}

$reuseStream = new ScriptedStream(
  vec[
    "HTTP/1.1 200 OK\r\nContent-Length: 5\r\n\r\nfirst"
    . "HTTP/1.1 200 OK\r\nContent-Length: 6\r\n\r\nsecond",
  ],
  $local,
  $peer,
);

$reusedH1 = new Client\_Private\H1Connection(
  $reuseStream,
  new Client\ConnectionMetadata($local, $peer, Message\ProtocolVersion::V11),
);

$firstReuse = $reusedH1->exchange(
  Request::fromURL(Message\METHOD_GET, URL::from('http://example.com/first')),
  new Client\Configuration(),
);

assert!(!($reusedH1->isReusable()));
$assertion_value_45 = fn(): Transaction => (
