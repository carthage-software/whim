$expectStream = new ScriptedStream(
  vec[
    "HTTP/1.1 103 Early Hints\r\nLink: </upload.css>; rel=preload\r\n\r\n",
    "HTTP/1.1 100 Continue\r\n\r\n",
    "HTTP/1.1 200 OK\r\nContent-Length: 2\r\n\r\nok",
  ],
  $local,
  $peer,
);

$expectTrailers = new Async\Deferred::<Message\FieldMap>();
$expectTrailers->complete(
  Message\FieldMap::from(vec[('X-Checksum', 'abc123')]),
);

$expectResult = new Client\_Private\H1Connection(
  $expectStream,
  new Client\ConnectionMetadata($local, $peer, Message\ProtocolVersion::V11),
)->exchange(
  Request::fromURL(
    Message\METHOD_POST,
    URL::from('http://example.com/expect'),
    headers: Message\FieldMap::from(vec[('Expect', '100-continue')]),
    body: new Whim\IO\MemoryHandle('payload'),
    trailers: $expectTrailers->getFuture(),
  ),
  new Client\Configuration(),
);

assert!(length!($expectResult->informational) == 2);
assert!($expectResult->informational[0]->status == Message\STATUS_EARLY_HINTS);

assert!($expectResult->informational[1]->status == Message\STATUS_CONTINUE);

assert!($expectResult->response->status == Message\STATUS_OK);
assert!(Str\contains($expectStream->written, "Transfer-Encoding: chunked\r\n"));
assert!(Str\contains($expectStream->written, "7\r\npayload\r\n"));
assert!(Str\contains($expectStream->written, "X-Checksum: abc123\r\n"));

