$resetServer = TCP\listen(new InternetEndpoint(Address::v4('127.0.0.1'), 0));
$resetServerTask = Async\spawn::<null>(function() use ($resetServer): null {
  $stream = $resetServer->accept();
  $protocol = new H2\ServerConnection(
    new H2\Configuration(
      settings: dict[H2\Setting::InitialWindowSize->value => 0],
    ),
  );

  $streamId = null;
  while ($streamId == null) {
    foreach ($protocol->receive($stream->read(16384)) as $event) {
      if ($event is H2\Event\RequestHeadersReceived) {
        $streamId = $event[1];
      }
    }

    $outbound = $protocol->takeOutboundBytes();
    if ($outbound != '') {
      $stream->writeAll($outbound);
    }
  }

  $protocol->resetStream($streamId, H2\ErrorCode::Cancel->value);
  $stream->writeAll($protocol->takeOutboundBytes());
  Async\sleep(Duration::fromMilliseconds(100));
  $stream->close();
  return null;
});

$resetClient = new Client\DefaultClient(
  configuration: new Client\Configuration(
    protocolVersions: vec[Message\ProtocolVersion::V2],
  ),
);

$resetBody = Str\join('', vec['0123456789abcdef'; 8192]);
$resetFailure = null;
try {
  discard!(
    $resetClient->send(
      Request::fromURL(
        Message\METHOD_POST,
        URL::from(
          'http://127.0.0.1:'
          . $resetServer->getLocalEndpoint()->port
          . '/reset',
        ),
        body: new Whim\IO\MemoryHandle($resetBody),
      ),
      cancellation: new Async\TimeoutCancellationToken(
        Duration::fromSeconds(2),
      ),
    ),
  );
} catch (Whim\Unwind\Throwable $error) {
  $resetFailure = $error;
}

$resetServerTask->await();
$resetServer->close();
assert!($resetFailure is Client\ProtocolException);

$earlyH2Server = TCP\listen(new InternetEndpoint(Address::v4('127.0.0.1'), 0));

$earlyH2ServerTask = Async\spawn::<null>(function() use ($earlyH2Server): null {
  $stream = $earlyH2Server->accept();
  $protocol = new H2\ServerConnection(
    new H2\Configuration(
      settings: dict[H2\Setting::InitialWindowSize->value => 0],
    ),
  );

  $streamId = null;
  while ($streamId == null) {
    foreach ($protocol->receive($stream->read(16384)) as $event) {
      if ($event is H2\Event\RequestHeadersReceived) {
        $streamId = $event[1];
      }
    }

    $outbound = $protocol->takeOutboundBytes();
    if ($outbound != '') {
      $stream->writeAll($outbound);
    }
  }

  $protocol->sendHeaders($streamId, vec[(':status', '413', false)]);

  $protocol->sendData($streamId, 'rejected', true);
  $protocol->resetStream($streamId, H2\ErrorCode::NoError->value);
  $stream->writeAll($protocol->takeOutboundBytes());
  Async\sleep(Duration::fromMilliseconds(100));
  $stream->close();
  return null;
});

$earlyH2Client = new Client\DefaultClient(
  configuration: new Client\Configuration(
    protocolVersions: vec[Message\ProtocolVersion::V2],
  ),
);

$earlyH2Result = $earlyH2Client->send(
  Request::fromURL(
    Message\METHOD_POST,
    URL::from(
      'http://127.0.0.1:' . $earlyH2Server->getLocalEndpoint()->port . '/early',
    ),
    body: new Whim\IO\MemoryHandle(Str\join('', vec['0123456789abcdef'; 8192])),
  ),
  cancellation: new Async\TimeoutCancellationToken(Duration::fromSeconds(2)),
);

assert!($earlyH2Result->response->status == 413);
$earlyH2Body = $earlyH2Result->response->body;
assert!($earlyH2Body != null);
assert!($earlyH2Body->readAll() == 'rejected');
$earlyH2ServerTask->await();
$earlyH2Server->close();

$certificatePem = File\read(directory!() . '/fixtures/tls/certificate.pem');
$privateKeyPem = File\read(directory!() . '/fixtures/tls/private-key.pem');
$certificate = TLS\Certificate::from($certificatePem);
$identity = TLS\Identity::from($certificatePem, $privateKeyPem);
$h2TcpServer = TCP\listen(new InternetEndpoint(Address::v4('127.0.0.1'), 0));

$h2TlsServer = TLS\listen::<InternetEndpoint>(
  $h2TcpServer,
  new TLS\ServerConfiguration($identity, alpnProtocols: vec['h2']),
);

$h2ResponseConsumed = new Async\Deferred::<null>();
$h2ServerTask = Async\spawn::<null>(
  function() use ($h2TlsServer, $h2ResponseConsumed): null {
    $stream = $h2TlsServer->accept();
    $protocol = new H2\ServerConnection();
    $streamId = null;
    while ($streamId == null) {
      foreach ($protocol->receive($stream->read(16384)) as $event) {
        if ($event is H2\Event\RequestHeadersReceived) {
          $streamId = $event[1];
        }
      }

      $outbound = $protocol->takeOutboundBytes();
      if ($outbound != '') {
        $stream->writeAll($outbound);
      }
    }

    $protocol->sendHeaders(
      $streamId,
      vec[(':status', '200', false), ('x-negotiated', 'h2', false)],
    );

    $protocol->sendData($streamId, 'negotiated h2', true);
    $stream->writeAll($protocol->takeOutboundBytes());
    $h2ResponseConsumed->getFuture()->await(
      new Async\TimeoutCancellationToken(Duration::fromSeconds(2)),
    );

    return null;
  },
);

$h2Client = new Client\DefaultClient(
  configuration: new Client\Configuration(
    tls: new TLS\ClientConfiguration(
      useSystemRoots: false,
      trustedRoots: vec[$certificate],
    ),
    protocolVersions: vec[
      Message\ProtocolVersion::V2,
      Message\ProtocolVersion::V11,
    ],
  ),
);

$h2Result = $h2Client->send(
  Request::fromURL(
    Message\METHOD_GET,
    URL::from(
      'https://localhost:' . $h2TcpServer->getLocalEndpoint()->port . '/h2',
    ),
  ),
);

assert!($h2Result->response->protocolVersion == Message\ProtocolVersion::V2);

assert!($h2Result->response->headers->get('x-negotiated') == 'h2');
$h2NegotiatedBody = $h2Result->response->body;
assert!($h2NegotiatedBody != null);
assert!($h2NegotiatedBody->readAll() == 'negotiated h2');
$h2ResponseConsumed->complete(null);
$h2ServerTask->await();
$h2TlsServer->close();

$streamingTcpServer = TCP\listen(
  new InternetEndpoint(Address::v4('127.0.0.1'), 0),
);

$streamingTlsServer = TLS\listen::<InternetEndpoint>(
  $streamingTcpServer,
  new TLS\ServerConfiguration($identity, alpnProtocols: vec['h2']),
);

$streamingHeadersSent = new Async\Deferred::<null>();
$streamingBodyAllowed = new Async\Deferred::<null>();
$streamingResponseConsumed = new Async\Deferred::<null>();
$streamingServerTask = Async\spawn::<null>(
  function() use (
    $streamingTlsServer,
    $streamingHeadersSent,
    $streamingBodyAllowed,
    $streamingResponseConsumed,
  ): null {
    $stream = $streamingTlsServer->accept();
    $protocol = new H2\ServerConnection();
    $streamId = null;
    while ($streamId == null) {
      foreach ($protocol->receive($stream->read(16384)) as $event) {
        if ($event is H2\Event\RequestHeadersReceived) {
          $streamId = $event[1];
        }
      }

      $outbound = $protocol->takeOutboundBytes();
      if ($outbound != '') {
        $stream->writeAll($outbound);
      }
    }

    $protocol->sendHeaders($streamId, vec[(':status', '200', false)]);

    $stream->writeAll($protocol->takeOutboundBytes());
    $streamingHeadersSent->complete(null);
    $streamingBodyAllowed->getFuture()->await();
    $protocol->sendData($streamId, 'streamed h2');
    $protocol->sendHeaders(
      $streamId,
      vec[('x-stream-trailer', 'h2', false)],
      true,
    );

    $stream->writeAll($protocol->takeOutboundBytes());
    $streamingResponseConsumed->getFuture()->await(
      new Async\TimeoutCancellationToken(Duration::fromSeconds(2)),
    );

    return null;
  },
);

$streamingClient = new Client\DefaultClient(
  configuration: new Client\Configuration(
    tls: new TLS\ClientConfiguration(
      useSystemRoots: false,
      trustedRoots: vec[$certificate],
    ),
    protocolVersions: vec[Message\ProtocolVersion::V2],
  ),
);

$streamingResponse = new Async\Deferred::<Transaction>();
$streamingClientTask = Async\spawn::<null>(
  function() use (
    $streamingClient,
    $streamingTcpServer,
    $streamingResponse,
  ): null {
    $streamingResponse->complete(
      $streamingClient->send(
        Request::fromURL(
          Message\METHOD_GET,
          URL::from(
            'https://localhost:'
            . $streamingTcpServer->getLocalEndpoint()->port
            . '/stream',
          ),
        ),
      ),
    );

    return null;
  },
);

$streamingHeadersSent->getFuture()->await();
Async\sleep(Duration::fromMilliseconds(10));
assert!($streamingResponse->isComplete());
$streamingTransaction = $streamingResponse->getFuture()->await();
$streamingBodyAllowed->complete(null);
$streamingBody = $streamingTransaction->response->body;
assert!($streamingBody != null);
assert!($streamingBody->readAll() == 'streamed h2');
$streamingTrailers = $streamingTransaction->response->trailers;
assert!($streamingTrailers != null);
assert!($streamingTrailers->await()->get('x-stream-trailer') == 'h2');
$streamingResponseConsumed->complete(null);

$streamingClientTask->await();
$streamingServerTask->await();
$streamingTlsServer->close();

$multiplexTcpServer = TCP\listen(
  new InternetEndpoint(Address::v4('127.0.0.1'), 0),
);

$multiplexTlsServer = TLS\listen::<InternetEndpoint>(
  $multiplexTcpServer,
  new TLS\ServerConfiguration($identity, alpnProtocols: vec['h2']),
);

$firstRequestReceived = new Async\Deferred::<null>();
$multiplexResponsesConsumed = new Async\Deferred::<null>();
$multiplexServerTask = Async\spawn::<null>(
  function() use (
    $multiplexTlsServer,
    $firstRequestReceived,
    $multiplexResponsesConsumed,
  ): null {
    $stream = $multiplexTlsServer->accept();
    $protocol = new H2\ServerConnection();
    $streams = vec[];
    while (length!($streams) < 2) {
      foreach ($protocol->receive($stream->read(16384)) as $event) {
        if ($event is H2\Event\RequestHeadersReceived) {
          $streams[] = $event[1];
          if (length!($streams) == 1) {
            $firstRequestReceived->complete(null);
          }
        }
      }

      $outbound = $protocol->takeOutboundBytes();
      if ($outbound != '') {
        $stream->writeAll($outbound);
      }
    }

    $protocol->sendHeaders($streams[1], vec[(':status', '200', false)]);

    $protocol->sendData($streams[1], 'second', true);
    $protocol->sendHeaders($streams[0], vec[(':status', '200', false)]);

    $protocol->sendData($streams[0], 'first', true);
    $stream->writeAll($protocol->takeOutboundBytes());
    $multiplexResponsesConsumed->getFuture()->await(
      new Async\TimeoutCancellationToken(Duration::fromSeconds(2)),
    );

    return null;
  },
);

$multiplexClient = new Client\DefaultClient(
  configuration: new Client\Configuration(
    tls: new TLS\ClientConfiguration(
      useSystemRoots: false,
      trustedRoots: vec[$certificate],
    ),
    protocolVersions: vec[Message\ProtocolVersion::V2],
  ),
);

$multiplexURL =
  'https://localhost:' . $multiplexTcpServer->getLocalEndpoint()->port;

$firstMultiplexed = Async\spawn::<Transaction>(
  fn(): Transaction => (
    $multiplexClient->send(
      Request::fromURL(Message\METHOD_GET, URL::from($multiplexURL . '/first')),
    )
  ),
);

$firstRequestReceived->getFuture()->await();
$secondMultiplexed = Async\spawn::<Transaction>(
  fn(): Transaction => (
    $multiplexClient->send(
      Request::fromURL(
        Message\METHOD_GET,
        URL::from($multiplexURL . '/second'),
      ),
    )
  ),
);

$firstMultiplexedBody = $firstMultiplexed->await()->response->body;
$secondMultiplexedBody = $secondMultiplexed->await()->response->body;
assert!($firstMultiplexedBody != null);
assert!($secondMultiplexedBody != null);
assert!($firstMultiplexedBody->readAll() == 'first');
assert!($secondMultiplexedBody->readAll() == 'second');
$multiplexResponsesConsumed->complete(null);
$multiplexServerTask->await();
$multiplexTlsServer->close();
$assertion_value_100 = fn(): Client\Origin => (
  Client\Origin::fromURL(URL::from('ftp://example.com/file'))
);

$assertion_error_100 = null;
try {
  $assertion_value_100();
} catch (Client\RequestException $assertion_caught_100) {
  $assertion_error_100 = $assertion_caught_100;
}

assert!($assertion_error_100 is Client\RequestException);

$redirectBody = new Whim\IO\MemoryHandle('discard me');
$redirectTarget = new ScriptedClient(vec[
  new Response(
    Message\STATUS_FOUND,
    headers: Message\FieldMap::from(vec[('location', '../next?ok=1')]),
    body: $redirectBody,
  ),
  new Response(Message\STATUS_OK),
]);

$redirect = new Client\RedirectClient($redirectTarget);
$redirected = $redirect->send(
  Request::fromURL(
    Message\METHOD_POST,
    URL::from('https://example.com/old/path'),
    headers: Message\FieldMap::from(vec[
      ('authorization', 'Bearer secret'),
      ('content-length', '7'),
      ('content-type', 'text/plain'),
    ]),
    body: new Whim\IO\MemoryHandle('payload'),
  ),
);

assert!($redirected->response->status == Message\STATUS_OK);
assert!($redirectBody->reachedEndOfDataSource());
assert!(length!($redirectTarget->requests) == 2);
assert!($redirectTarget->requests[1]->method == Message\METHOD_GET);
assert!($redirectTarget->requests[1]->body == null);
assert!($redirectTarget->requests[1]->headers->get('content-length') == null);

assert!(
  $redirectTarget->requests[1]->headers->get('authorization')
  == 'Bearer secret',
);

assert!(
  $redirectTarget->requests[1]->headers->get('referer')
  == 'https://example.com/old/path',
);

assert!(
  $redirectTarget->requests[1]->url?->toString()
  == 'https://example.com/next?ok=1',
);

foreach (vec[
  Message\STATUS_MOVED_PERMANENTLY,
  Message\STATUS_FOUND,
] as $status) {
  $preserved = new ScriptedClient(vec[
    new Response(
      $status,
      headers: Message\FieldMap::from(vec[
        ('location', 'https://example.com/next'),
      ]),
    ),
    new Response(Message\STATUS_OK),
  ]);

  $result = new Client\RedirectClient($preserved)->send(
    Request::fromURL(
      Message\METHOD_PUT,
      URL::from('https://example.com/start'),
      body: new Whim\IO\MemoryHandle('preserved'),
    ),
  );

  assert!($result->response->status == Message\STATUS_OK);
  assert!($preserved->requests[1]->method == Message\METHOD_PUT);
  assert!($preserved->requestBodies == vec['preserved', 'preserved']);
}

$crossOrigin = new ScriptedClient(vec[
  new Response(
    Message\STATUS_TEMPORARY_REDIRECT,
    headers: Message\FieldMap::from(vec[
      ('location', 'https://other.example/next'),
    ]),
  ),
  new Response(Message\STATUS_OK),
]);

$replayed = new Client\RedirectClient($crossOrigin)->send(
  Request::fromURL(
    Message\METHOD_PUT,
    URL::from('https://example.com/start'),
    headers: Message\FieldMap::from(vec[
      ('authorization', 'Bearer secret'),
      ('cookie', 'session=yes'),
      ('host', 'example.com'),
      ('proxy-authorization', 'Proxy secret'),
    ]),
    body: new Whim\IO\MemoryHandle('repeatable'),
  ),
);

assert!($replayed->response->status == Message\STATUS_OK);
assert!($crossOrigin->requestBodies == vec['repeatable', 'repeatable']);

assert!($crossOrigin->requests[1]->method == Message\METHOD_PUT);
assert!($crossOrigin->requests[1]->headers->get('authorization') == null);

assert!($crossOrigin->requests[1]->headers->get('cookie') == null);
assert!($crossOrigin->requests[1]->headers->get('host') == null);
assert!($crossOrigin->requests[1]->headers->get('proxy-authorization') == null);

