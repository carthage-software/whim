$pushed = $pushedFuture->await();
assert!(length!($pushed) == 1);
assert!(
  $pushed[0]->request->url?->toString() == 'https://example.com/style.css',
);

assert!($pushed[0]->request->headers->get('accept') == 'text/css');
assert!($pushed[0]->response->headers->get('content-type') == 'text/css');

$pushedBody = $pushed[0]->response->body;
assert!($pushedBody != null);
assert!($pushedBody->readAll() == 'body{}');

