  "HTTP/1.1 103 Early Hints\r\nTransfer-Encoding: chunked\r\n\r\n",
  "HTTP/1.1 204 No Content\r\nContent-Length: 1\r\n\r\nx",
  "HTTP/1.1 205 Reset Content\r\nContent-Length: 1\r\n\r\nx",
] as $invalidFraming) {
