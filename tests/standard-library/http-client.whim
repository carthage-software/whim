$pushWireServer->sendPushPromise(
  $pushParentId,
  2,
  vec[
    (':method', 'GET', false),
    (':scheme', 'https', false),
    (':authority', 'example.com', false),
    (':path', '/style.css', false),
    ('accept', 'text/css', false),
  ],
);

$pushWireServer->sendHeaders(
  2,
  vec[(':status', '200', false), ('content-type', 'text/css', false)],
);

$pushWireServer->sendData(2, 'body{}', true);
$pushWireServer->sendHeaders(
  $pushParentId,
  vec[(':status', '204', false)],
  true,
);

