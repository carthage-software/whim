final class FakeConnection implements Client\Connection {
  private bool $closed = false;
  public null|Request $request = null;

  public function __construct(
    private Client\ConnectionMetadata $metadata,
    private Response $response,
  ) {}

  public function getMetadata(): Client\ConnectionMetadata {
    return $this->metadata;
  }

  public function isReusable(): bool {
    return !$this->closed;
  }

  public function isClosed(): bool {
    return $this->closed;
  }

  public function close(): void {
    $this->closed = true;
  }

  public function exchange(
    Request $request,
    Client\Configuration $configuration,
    null|CancellationToken $cancellation = null,
  ): Transaction {
    $this->request = $request;
    return new Transaction(vec[], null, $this->response);
  }
}

final class MetadataRecorder {
  public null|Client\ConnectionMetadata $value = null;
}

final class FakeConnector implements Client\Connector {
  public null|Client\Origin $origin = null;
  public null|Request $request = null;

  public function __construct(private FakeConnection $connection) {}

  public function connect(
    Client\Origin $origin,
    Request $request,
    Client\Configuration $configuration,
    null|CancellationToken $cancellation = null,
  ): Client\Connection {
    $this->origin = $origin;
    $this->request = $request;
    return $this->connection;
  }
}

class ReusableConnection implements Client\Connection {
  private bool $closed = false;
  public int $exchanges = 0;
  public bool $failNext = false;

  public function __construct(private Client\ConnectionMetadata $metadata) {}

  public function getMetadata(): Client\ConnectionMetadata {
    return $this->metadata;
  }

  public function isReusable(): bool {
    return !$this->closed;
  }

  public function isClosed(): bool {
    return $this->closed;
  }

  public function close(): void {
    $this->closed = true;
  }

  public function exchange(
    Request $request,
    Client\Configuration $configuration,
    null|CancellationToken $cancellation = null,
  ): Transaction {
    $this->exchanges++;
    if ($this->failNext) {
      $this->failNext = false;
      throw new Client\ProtocolException('one exchange failed');
    }

    return new Transaction(
      vec[],
      null,
      new Response(
        Message\STATUS_OK,
        body: new Whim\IO\MemoryHandle('response-' . $this->exchanges),
      ),
    );
  }
}

final class ReusableMultiplexedConnection extends ReusableConnection implements
  Client\MultiplexedConnection {}

final class CountingConnector implements Client\Connector {
  public int $connections = 0;
  public vec<ReusableConnection> $opened = vec[];

  public function __construct(
    private Client\ConnectionMetadata $metadata,
    private bool $multiplexed = false,
  ) {}

  public function connect(
    Client\Origin $origin,
    Request $request,
    Client\Configuration $configuration,
    null|CancellationToken $cancellation = null,
  ): Client\Connection {
    $this->connections++;
    $connection = match ($this->multiplexed) {
      true => new ReusableMultiplexedConnection($this->metadata),
      false => new ReusableConnection($this->metadata),
    };

    $this->opened[] = $connection;
    return $connection;
  }
}

final class GatedMultiplexedConnector implements Client\Connector {
  public int $connections = 0;
  private Async\Deferred<null> $gate;

  public function __construct(
    private Client\ConnectionMetadata $metadata,
    private bool $multiplexed = true,
  ) {
    $this->gate = new Async\Deferred::<null>();
  }

  public function connect(
    Client\Origin $origin,
    Request $request,
    Client\Configuration $configuration,
    null|CancellationToken $cancellation = null,
  ): Client\Connection {
    $this->connections++;
    $this->gate->getFuture()->await($cancellation);
    return match ($this->multiplexed) {
      true => new ReusableMultiplexedConnection($this->metadata),
      false => new ReusableConnection($this->metadata),
    };
  }

  public function release(): void {
    $this->gate->complete(null);
  }
}

function abandon_response(Client\Client $client): void {
  $transaction = $client->send(
    Request::fromURL(Message\METHOD_GET, URL::from('http://example.com/one')),
  );
}

function abandon_h1_response(Client\_Private\H1Connection $connection): void {
  discard!(
    $connection->exchange(
      Request::fromURL(
        Message\METHOD_GET,
        URL::from('http://example.com/abandoned'),
      ),
      new Client\Configuration(),
    ),
  );
}

final class ScriptedClient implements Client\Client {
  public vec<Request> $requests = vec[];
  public vec<string> $requestBodies = vec[];
  private int $responseIndex = 0;

  public function __construct(private vec<Response> $responses) {}

  public function send(
    Request $request,
    Client\SendConfiguration $configuration = new Client\SendConfiguration(),
    null|CancellationToken $cancellation = null,
  ): Transaction {
    $this->requests[] = $request;
    if ($request->body != null) {
      $this->requestBodies[] = $request->body->readAll(
        cancellation: $cancellation,
      );
    }

    $response = $this->responses[$this->responseIndex];
    $this->responseIndex++;
    return new Transaction(vec[], null, $response);
  }
}

final class FlakyClient implements Client\Client {
  public int $attempts = 0;
  public vec<string> $requestBodies = vec[];

  public function __construct(private int $failures) {}

  public function send(
    Request $request,
    Client\SendConfiguration $configuration = new Client\SendConfiguration(),
    null|CancellationToken $cancellation = null,
  ): Transaction {
    $this->attempts++;
    if ($request->body != null) {
      $this->requestBodies[] = $request->body->readAll(
        cancellation: $cancellation,
      );
    }

    if ($this->attempts <= $this->failures) {
      throw new NetworkException('temporary transport failure');
    }

    return new Transaction(vec[], null, new Response(Message\STATUS_OK));
  }
}

final class IOFlakyClient implements Client\Client {
  public int $attempts = 0;

  public function __construct(
    private int $failures,
    private bool $transport = true,
  ) {}

  public function send(
    Request $request,
    Client\SendConfiguration $configuration = new Client\SendConfiguration(),
    null|CancellationToken $cancellation = null,
  ): Transaction {
    $this->attempts++;
    if ($this->attempts <= $this->failures) {
      if ($this->transport) {
        throw new Whim\IO\TransportException('temporary IO failure');
      }

      throw new Whim\IO\Exception('non-transport IO failure');
    }

    return new Transaction(vec[], null, new Response(Message\STATUS_OK));
  }
}

final class FailingResponseBody implements Whim\IO\ReadHandle {
  public function waitUntilReadable(
    null|CancellationToken $cancellation = null,
  ): void {}

  public function reachedEndOfDataSource(): bool {
    return false;
  }

  public function tryRead(null|int $maxBytes = null): string {
    throw new Whim\IO\TransportException('the response transport failed');
  }
}

final class HeaderMiddleware implements Client\Middleware {
  public function process(
    Client\Connection $connection,
    Request $request,
    Client\Configuration $configuration,
    Client\Handler $next,
    null|CancellationToken $cancellation = null,
  ): Transaction {
    return $next->handle(
      $connection,
      $request->withHeader('X-Middleware', 'yes'),
      $configuration,
      $cancellation,
    );
  }
}

final class CookieHandler implements Client\Handler {
  public vec<Request> $requests = vec[];
  private int $index = 0;

  public function __construct(private vec<Response> $responses) {}

  public function handle(
    Client\Connection $connection,
    Request $request,
    Client\Configuration $configuration,
    null|CancellationToken $cancellation = null,
  ): Transaction {
    $this->requests[] = $request;
    $response = $this->responses[$this->index];
    $this->index++;
    return new Transaction(vec[], null, $response);
  }
}

final class ScriptedStream implements Stream<InternetEndpoint> {
  private int $chunk = 0;
  private int $offset = 0;
  private bool $closed = false;
  public string $written = '';

  public function __construct(
    private vec<string> $chunks,
    private InternetEndpoint $local,
    private InternetEndpoint $peer,
  ) {}

  public function getLocalEndpoint(): InternetEndpoint {
    return $this->local;
  }

  public function getPeerEndpoint(): InternetEndpoint {
    return $this->peer;
  }

  public function shutdown(
    ShutdownDirection $direction = ShutdownDirection::Write,
  ): void {}

  public function waitUntilReadable(
    null|CancellationToken $cancellation = null,
  ): void {}

  public function waitUntilWritable(
    null|CancellationToken $cancellation = null,
  ): void {}

  public function reachedEndOfDataSource(): bool {
    return $this->chunk >= length!($this->chunks);
  }

  public function tryRead(null|int $maxBytes = null): string {
    if ($this->reachedEndOfDataSource()) {
      return '';
    }

    $data = $this->chunks[$this->chunk];
    $available = length!($data) - $this->offset;
    $length = $available;
    if ($maxBytes != null && $maxBytes >= 0 && $maxBytes < $length) {
      $length = $maxBytes;
    }

    $result = Str\slice($data, $this->offset, $length);
    $this->offset += $length;
    if ($this->offset == length!($data)) {
      $this->chunk++;
      $this->offset = 0;
    }

    return $result;
  }

  public function read(
    null|int $maxBytes = null,
    null|CancellationToken $cancellation = null,
  ): string {
    return $this->tryRead($maxBytes);
  }

  public function tryWrite(string $bytes): int {
    $this->written .= $bytes;
    return length!($bytes);
  }

  public function write(
    string $bytes,
    null|CancellationToken $cancellation = null,
  ): int {
    return $this->tryWrite($bytes);
  }

  public function isClosed(): bool {
    return $this->closed;
  }

  public function close(): void {
    $this->closed = true;
  }
}

$local = new InternetEndpoint(Address::v4('127.0.0.1'), 40000);
$peer = new InternetEndpoint(Address::v4('203.0.113.10'), 443);
$metadata = new Client\ConnectionMetadata(
  $local,
  $peer,
  Message\ProtocolVersion::V2,
);

$connection = new FakeConnection($metadata, new Response(Message\STATUS_OK));
$connector = new FakeConnector($connection);
$client = new Client\DefaultClient(
  $connector,
  new Client\Configuration(baseURL: URL::from('https://example.com/api/')),
  vec[new HeaderMiddleware()],
);

$observed = new MetadataRecorder();
$transaction = $client->send(
  Request::fromParts(Message\METHOD_GET, 'users?id=1'),
  new Client\SendConfiguration(
    onConnection: function(
      Client\ConnectionMetadata $value,
    ) use ($observed): void {
      $observed->value = $value;
    },
  ),
);

assert!($transaction->response->status == Message\STATUS_OK);
assert!($observed->value == $metadata);
assert!($connection->request?->headers->get('X-Middleware') == 'yes');

$cookieJar = new CookieJar();
$cookieHandler = new CookieHandler(vec[
  new Response(
    Message\STATUS_OK,
    headers: Message\FieldMap::from(vec[
      ('Set-Cookie', 'sid=one; Path=/; HttpOnly'),
      ('Set-Cookie', 'theme=dark; Domain=.example.com; Path=/'),
      ('Set-Cookie', 'scoped=deep; Path=/account'),
      ('Set-Cookie', 'secret=value; Path=/; Secure'),
      ('Set-Cookie', 'ignored=value; Domain=invalid.example'),
    ]),
  ),
  new Response(Message\STATUS_OK),
  new Response(Message\STATUS_OK),
  new Response(Message\STATUS_OK),
  new Response(
    Message\STATUS_OK,
    headers: Message\FieldMap::from(vec[
      ('Set-Cookie', 'sid=gone; Path=/; Max-Age=0'),
    ]),
  ),
  new Response(Message\STATUS_OK),
]);

$cookieConfiguration = new Client\Configuration();
discard!(
  $cookieJar->process(
    $connection,
    Request::fromURL(
      Message\METHOD_GET,
      URL::from('https://example.com/login'),
    ),
    $cookieConfiguration,
    $cookieHandler,
  ),
);

assert!($cookieJar->count() == 4);

discard!(
  $cookieJar->process(
    $connection,
    Request::fromURL(
      Message\METHOD_GET,
      URL::from('https://example.com/account/settings'),
    ),
    $cookieConfiguration,
    $cookieHandler,
  ),
);

assert!(
  $cookieHandler->requests[1]->headers->get('Cookie')
  == 'scoped=deep; sid=one; theme=dark; secret=value',
);

discard!(
  $cookieJar->process(
    $connection,
    Request::fromURL(Message\METHOD_GET, URL::from('http://example.com/')),
    $cookieConfiguration,
    $cookieHandler,
  ),
);

assert!(
  $cookieHandler->requests[2]->headers->get('Cookie') == 'sid=one; theme=dark',
);

discard!(
  $cookieJar->process(
    $connection,
    Request::fromURL(
      Message\METHOD_GET,
      URL::from('https://sub.example.com/'),
      headers: Message\FieldMap::from(vec[
        ('Cookie', 'manual=yes; theme=manual'),
      ]),
    ),
    $cookieConfiguration,
    $cookieHandler,
  ),
);

assert!(
  $cookieHandler->requests[3]->headers->get('Cookie')
  == 'manual=yes; theme=manual',
);

discard!(
  $cookieJar->process(
    $connection,
    Request::fromURL(Message\METHOD_GET, URL::from('https://example.com/')),
    $cookieConfiguration,
    $cookieHandler,
  ),
);

assert!($cookieJar->count() == 3);

discard!(
  $cookieJar->process(
    $connection,
    Request::fromURL(Message\METHOD_GET, URL::from('https://example.com/')),
    $cookieConfiguration,
    $cookieHandler,
  ),
);

assert!(
  $cookieHandler->requests[5]->headers->get('Cookie')
  == 'theme=dark; secret=value',
);

$cookieJar->clear();
assert!($cookieJar->count() == 0);

assert!($connector->origin?->scheme == 'https');
assert!($connector->origin?->port == 443);
assert!(
  $connector->request?->url?->toString()
  == 'https://example.com/api/users?id=1',
);

$configuration = new Client\Configuration();
$overridden = $configuration->withOverrides(
  new Client\SendConfiguration(maximumResponseBodySize: 1234),
);

assert!($overridden->maximumResponseBodySize == 1234);
assert!($overridden->maximumResponseHeaderSize == 8192);
assert!($overridden->maximumInformationalResponses == 16);
assert!($overridden->h2 is H2\Configuration);
assert!($overridden->tls is TLS\ClientConfiguration);

$informationalOverride = $configuration->withOverrides(
  new Client\SendConfiguration(maximumInformationalResponses: 2),
);

assert!($informationalOverride->maximumInformationalResponses == 2);

$protocolURL = URL::from('https://example.com/');
$protocolConfiguration = new Client\Configuration(
  protocolVersions: vec[
    Message\ProtocolVersion::V2,
    Message\ProtocolVersion::V11,
  ],
);

assert!(
  Client\_Private\resolve_protocol_versions(
    Request::fromURL(Message\METHOD_GET, $protocolURL),
    $protocolConfiguration,
  ) == vec[Message\ProtocolVersion::V2, Message\ProtocolVersion::V11],
);

assert!(
  Client\_Private\resolve_protocol_versions(
    Request::fromURL(
      Message\METHOD_GET,
      $protocolURL,
      Message\ProtocolVersion::V2,
    ),
    $protocolConfiguration,
  ) == vec[Message\ProtocolVersion::V2],
);

