use Whim\Comparison\Ordering;
use Whim\Dict;
use Whim\Vec;

assert!(
  Dict\from_iterable::<int, string>(vec['a', 'b']) == dict[0 => 'a', 1 => 'b'],
);

assert!(
  Dict\from_entries::<string, int>(vec[('x', 1), ('y', 2)]) == dict[
    'x' => 1,
    'y' => 2,
  ],
);

$assertion_value_3 = fn(): dict<string|int|bool, mixed> => (
  Whim\_Private\dict_from_entries(vec[(vec[], 1)])
);

$assertion_error_3 = null;
try {
  $assertion_value_3();
} catch (Whim\Unwind\TypeError $assertion_caught_3) {
  $assertion_error_3 = $assertion_caught_3;
}

assert!($assertion_error_3 is Whim\Unwind\TypeError);

$merged = Dict\merge::<string, int>(
  dict['a' => 1, 'b' => 2],
  vec[dict['b' => 20, 'c' => 30]],
);

assert!($merged == dict['a' => 1, 'b' => 20, 'c' => 30]);
assert!(Dict\merge::<string, int>(dict['a' => 1]) == dict['a' => 1]);

assert!(
  Dict\flip::<string, int>(dict['a' => 1, 'b' => 2]) == dict[
    1 => 'a',
    2 => 'b',
  ],
);

assert!(
  Dict\flatten::<string, int>(vec[
    dict['a' => 1],
    dict['b' => 2, 'a' => 10],
  ]) == dict['a' => 10, 'b' => 2],
);

assert!(
  Dict\count_values::<string>(vec['x', 'y', 'x', 'x']) == dict[
    'x' => 3,
    'y' => 1,
  ],
);

$sorted = Dict\sort::<string, int>(dict['a' => 3, 'b' => 1, 'c' => 2]);
assert!(Vec\keys::<string>($sorted) == vec['b', 'c', 'a']);
$descending = Dict\sort::<string, int>(
  dict['a' => 1, 'b' => 3, 'c' => 2],
  fn(int $left, int $right): Ordering => Ordering::from($right <=> $left),
);

assert!(Vec\keys::<string>($descending) == vec['b', 'c', 'a']);
assert!(length!(Dict\sort::<string, int>(dict[])) == 0);

assert!(
  Dict\map::<int, int, int>(
    dict[1 => 2, 3 => 4],
    fn(int $v): int => $v * 10,
  ) == dict[1 => 20, 3 => 40],
);

assert!(
  Dict\filter::<int, int>(
    dict[1 => 1, 2 => 2, 3 => 3],
    fn(int $v): bool => $v != 2,
  ) == dict[1 => 1, 3 => 3],
);

$mapped = Dict\map::<string, int, string>(
  dict['a' => 1, 'b' => 2],
  fn(int $value): string => 'v=' . $value,
);

$assertion_value_14 = $mapped;
assert!($assertion_value_14 is dict<string, string>);
assert!($assertion_value_14 == dict['a' => 'v=1', 'b' => 'v=2']);

assert!(
  Dict\map_keys::<string, int, int>(
    dict['a' => 1, 'b' => 2],
    fn(string $key): int => length!($key),
  ) is dict<int, int>,
);

assert!(
  Dict\filter_nulls::<string, int>(dict[
    'a' => 1,
    'b' => null,
    'c' => 3,
  ]) == dict['a' => 1, 'c' => 3],
);

$grouped = Dict\group_by::<string, string>(
  vec['ant', 'ape', 'bear'],
  fn(
    string $value,
  ): Whim\Option\Option<string> => new Whim\Option\Some::<string>($value[0]),
);

assert!($grouped is dict<string, vec<string>>);
assert!($grouped['a'] == vec['ant', 'ape']);

$nullableMapped = Dict\map_nonnull::<string, int, null>(
  dict['present' => 1],
  fn(
    int $value,
  ): Whim\Option\Option<null> => new Whim\Option\Some::<null>(null),
);

$assertion_value_19 = $nullableMapped;
assert!($assertion_value_19 is dict<string, null>);
assert!(length!($assertion_value_19) == 1);

assert!($nullableMapped['present'] == null);

assert!(
  Dict\take::<string, int>(dict['a' => 1, 'b' => 2], 1) == dict['a' => 1],
);

assert!(
  Dict\merge::<string, int>(
    dict['a' => 1],
    vec[dict['b' => 2], dict['a' => 3]],
  ) == dict['a' => 3, 'b' => 2],
);

assert!(
  Dict\diff::<string, int>(
    dict['a' => 1, 'b' => 2, 'c' => 3],
    dict['x' => 2],
  ) == dict['a' => 1, 'c' => 3],
);

assert!(
  Dict\intersect_by_key::<string, int>(
    dict['a' => 1, 'b' => 2],
    dict['b' => 'ignored'],
  ) == dict['b' => 2],
);

assert!(
  Dict\sort::<string, int>(dict['a' => 3, 'b' => 1, 'c' => 2]) == dict[
    'b' => 1,
    'c' => 2,
    'a' => 3,
  ],
);

assert!(
  Dict\sort_by::<string, string, int>(
    dict['a' => 'cc', 'b' => 'a', 'c' => 'bb', 'd' => 'dd'],
    fn(string $value): int => length!($value),
  ) == dict['b' => 'a', 'a' => 'cc', 'c' => 'bb', 'd' => 'dd'],
);

assert!(
  Dict\sort_by_key::<string, int>(dict['c' => 3, 'a' => 1, 'b' => 2]) == dict[
    'a' => 1,
    'b' => 2,
    'c' => 3,
  ],
);

$assertion_value_26 = fn(): dict<string, int> => (
  Dict\associate::<string, int>(vec['a'], vec[1, 2])
);

$assertion_error_26 = null;
try {
  $assertion_value_26();
} catch (Whim\Unwind\LogicException $assertion_caught_26) {
  $assertion_error_26 = $assertion_caught_26;
}

assert!($assertion_error_26 is Whim\Unwind\LogicException);

final class DictTestIterator implements Whim\Iterate\Iterator<string, int> {
  private int $offset = 0;

  public function next(): null|(string, int) {
    $entry = match ($this->offset) {
      0 => ('a', 1),
      1 => ('b', 2),
      $_ => null,
    };

    $this->offset++;

    return $entry;
  }
}

final class DictTestToIterator implements Whim\Iterate\ToIterator<string, int> {
  public function toIterator(): Whim\Iterate\Iterator<string, int> {
    return new DictTestIterator();
  }
}

assert!(
  Dict\from_iterable::<string, int>(new DictTestToIterator()) == dict[
    'a' => 1,
    'b' => 2,
  ],
);

assert!(
  Dict\map::<string, int, int>(
    new DictTestToIterator(),
    fn(int $value): int => $value * 2,
  ) == dict['a' => 2, 'b' => 4],
);

assert!(
  Dict\filter_with_key::<string, int>(
    new DictTestToIterator(),
    fn(string $key, int $_): bool => $key == 'b',
  ) == dict['b' => 2],
);

assert!(
  Dict\diff::<string, int>(
    new DictTestToIterator(),
    new DictTestIterator(),
  ) == dict[],
);

assert!(
  Dict\equal::<string, int>(new DictTestIterator(), dict['a' => 1, 'b' => 2]),
);

assert!(
  Dict\select_keys::<string, int>(
    new DictTestIterator(),
    vec['b', 'a'],
  ) == dict['b' => 2, 'a' => 1],
);
