assert!($assertion_error_72 is Whim\Unwind\InvalidArgumentException);

$assertion_value_73 = fn(): int => (
  Whim\Math\from_base('9223372036854775808', 10)
);

$assertion_error_73 = null;
try {
  $assertion_value_73();
} catch (Whim\Unwind\OverflowException $assertion_caught_73) {
  $assertion_error_73 = $assertion_caught_73;
