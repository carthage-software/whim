assert!(Whim\Math\round(100.0, 307) == 100.0);
assert!(Whim\Math\round(1.5, 400) == 1.5);
assert!(
  Whim\Math\mean(vec[Whim\Math\FLOAT_MAX, Whim\Math\FLOAT_MAX])
  == Whim\Math\FLOAT_MAX,
);

assert!(
  Whim\Math\median(vec[Whim\Math\FLOAT_MAX, Whim\Math\FLOAT_MAX])
  == Whim\Math\FLOAT_MAX,
);

assert!(Whim\Math\median(vec[Whim\Math\INT_MIN, Whim\Math\INT_MAX]) == -0.5);

assert!(
  Whim\Math\min(vec[Whim\Math\INT_MAX, 9_223_372_036_854_776_000.0])
  == Whim\Math\INT_MAX,
);

assert!(
  Whim\Math\max(vec[Whim\Math\INT_MAX, 9_223_372_036_854_776_000.0])
  == 9_223_372_036_854_776_000.0,
);

assert!(Whim\Math\INT53_MAX == 9_007_199_254_740_991);
assert!(Whim\Math\INT53_MIN == -9_007_199_254_740_991);

$divisionError = null;
$assertion_callable_89 = fn(): int => Whim\Math\div(1, 0);
try {
  $assertion_callable_89();
} catch (Whim\Unwind\DivisionByZeroError $assertion_caught_89) {
  $divisionError = $assertion_caught_89;
}

assert!($divisionError is Whim\Unwind\DivisionByZeroError);

assert!($divisionError is Whim\Unwind\Error);
assert!(!($divisionError is Whim\Unwind\Exception));

$assertion_value_92 = function(): void {
  Whim\Float\is_finite(1.0);
};

$assertion_error_92 = null;
try {
  $assertion_value_92();
} catch (Whim\Unwind\DiscardedResultError $assertion_caught_92) {
  $assertion_error_92 = $assertion_caught_92;
}

assert!($assertion_error_92 is Whim\Unwind\DiscardedResultError);

$assertion_value_93 = function(): void {
  Whim\Float\from_bits(0);
};

$assertion_error_93 = null;
try {
  $assertion_value_93();
} catch (Whim\Unwind\DiscardedResultError $assertion_caught_93) {
