  $assertion_value_71();
} catch (Whim\Unwind\InvalidArgumentException $assertion_caught_71) {
  $assertion_error_71 = $assertion_caught_71;
}

assert!($assertion_error_71 is Whim\Unwind\InvalidArgumentException);

$assertion_value_72 = fn(): string => (
  Whim\Math\base_convert(Str\repeat('9', 32) . 'z', 10, 16)
);

$assertion_error_72 = null;
try {
  $assertion_value_72();
} catch (Whim\Unwind\InvalidArgumentException $assertion_caught_72) {
  $assertion_error_72 = $assertion_caught_72;
