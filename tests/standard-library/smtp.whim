$listener = TCP\listen(new InternetEndpoint(Address::v4('127.0.0.1'), 0));
$endpoint = $listener->getLocalEndpoint();
$server = Async\spawn::<(string, string)>(
  function() use ($listener): (string, string) {
    return (
      smtp_receive_data_message($listener),
      smtp_receive_data_message($listener),
    );
  },
);

$transport = new DefaultTransport(
  new TransportConfiguration(
    host: $endpoint->address,
    port: $endpoint->port,
    security: Security::Plaintext,
    localHostname: 'client.example',
    pipelining: false,
    chunking: false,
  ),
);

$report = $transport->send(
  Envelope::fromParts(
    Mailbox::from('sender@example.com'),
    vec[Mailbox::from('receiver@example.com')],
  ),
  Message::create(
    new RawPart(Headers::default(), new MemoryHandle(".hello\r\nworld")),
  ),
);

assert!($report->hasRejections() == false);

$report = $transport->send(
  Envelope::fromParts(
    Mailbox::from('sender@example.com'),
    vec[Mailbox::from('receiver@example.com')],
  ),
  Message::create(
    new RawPart(Headers::default(), new MemoryHandle('second message')),
  ),
);

assert!($report->hasRejections() == false);
$transport->close();
($payload, $secondPayload) = $server->await();
$listener->close();
assert!(Str\contains($payload, "\r\n\r\n..hello\r\nworld") == true);
assert!(Str\contains($secondPayload, "\r\n\r\nsecond message") == true);

$listener = TCP\listen(new InternetEndpoint(Address::v4('127.0.0.1'), 0));
$endpoint = $listener->getLocalEndpoint();
$server = Async\spawn::<string>(function() use ($listener): string {
  $stream = $listener->accept();
  $reader = new Reader($stream);
  $stream->writeAll("220 smtp.example ESMTP ready\r\n");
  $commands = ($reader->readLine() as string) . "\n";
  $stream->writeAll("250-smtp.example\r\n250-PIPELINING\r\n250 CHUNKING\r\n");

  $round = 0;
  while ($round < 3) {
    if ($round > 0) {
      $noop = $reader->readLine() as string;
      assert!($noop == 'NOOP');
      $commands .= $noop . "\n";
      $stream->writeAll("250 2.0.0 connection alive\r\n");
    }

    $commands .= ($reader->readLine() as string) . "\n";
    $commands .= ($reader->readLine() as string) . "\n";

    if ($round == 2) {
      $stream->writeAll(
        "250 2.1.0 sender accepted\r\n550 5.1.1 recipient rejected\r\n",
      );

      $commands .= ($reader->readLine() as string) . "\n";
      $stream->writeAll("250 2.0.0 reset\r\n");
      $round++;
      continue;
    }

    $stream->writeAll(
      "250 2.1.0 sender accepted\r\n250 2.1.5 recipient accepted\r\n",
    );

    $payload = '';
    $last = false;
    while (!$last) {
      $line = $reader->readLine() as string;
      $commands .= $line . "\n";
      $parts = Str\split($line, ' ');
      $size = parse_decimal($parts[1]);
      assert!($size != null);
      $payload .= $reader->readFixedSize($size);
      $last = length!($parts) == 3 && $parts[2] == 'LAST';
      $stream->writeAll("250 2.0.0 queued\r\n");
    }

    $commands .= ($reader->readLine() as string) . "\n";
    $stream->writeAll("250 2.0.0 reset\r\n");
    $round++;
  }

  $stream->close();
  return $commands;
});

$transport = new DefaultTransport(
  new TransportConfiguration(
    host: $endpoint->address,
    port: $endpoint->port,
    security: Security::Plaintext,
    localHostname: 'client.example',
    allowPartialSuccess: true,
  ),
);

$envelope = Envelope::fromParts(
  Mailbox::from('sender@example.com'),
  vec[Mailbox::from('receiver@example.com')],
);

$message = Message::create(
  new RawPart(Headers::default(), new MemoryHandle('hello')),
);

assert!($transport->send($envelope, $message)->hasRejections() == false);

$message = Message::create(
  new RawPart(Headers::default(), new MemoryHandle('hello')),
);

assert!($transport->send($envelope, $message)->hasRejections() == false);

$message = Message::create(
  new RawPart(Headers::default(), new MemoryHandle('rejected')),
);

$rejectedReport = $transport->send($envelope, $message);
assert!($rejectedReport->hasRejections() == true);
assert!(length!($rejectedReport->rejectedRecipients) == 1);
assert!($rejectedReport->rejectedRecipients[0][1]->code == 550);

$transport->close();
$commands = $server->await();
assert!(Str\starts_with($commands, "EHLO client.example\n") == true);
assert!(Str\contains($commands, 'BDAT ') == true);
assert!(Str\contains($commands, " LAST\nRSET\n") == true);
$listener->close();
