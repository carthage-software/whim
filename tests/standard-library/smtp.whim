$transportConfiguration = new TransportConfiguration();
assert!($transportConfiguration->security == Security::StartTls);
assert!($transportConfiguration->port == null);
assert!($transportConfiguration->maximumIdleConnections == 1);
assert!(new DeliveryReport()->hasRejections() == false);

$extensionDuplex = new ScriptedDuplex(
  "250-smtp.example\r\n"
  . "250-SMTPUTF8\r\n"
  . "250-DSN\r\n"
  . "250-REQUIRETLS\r\n"
  . "250-MT-PRIORITY\r\n"
  . "250-DELIVERBY\r\n"
  . "250 FUTURERELEASE\r\n",
);

$extensionConnection = new Connection($extensionDuplex);
assert!($extensionConnection->ehlo('client.example')->code == 250);
$envelope = Envelope::fromParts(
  Mailbox::from('ü@täst.de'),
  vec[Mailbox::from('receiver@example.com')],
);

assert!(
  Client\_Private\mail_from_command(
    $extensionConnection,
    $envelope,
    $sendConfiguration,
  )->toString()
  == 'MAIL FROM:<ü@xn--tst-qla.de>'
  . ' SMTPUTF8 RET=HDRS ENVID=message-1 REQUIRETLS'
  . ' MT-PRIORITY=4 BY=600;R HOLDFOR=7200',
);

assert!(
  Client\_Private\recipient_command(
    $extensionConnection,
    $envelope->recipients[0],
    $sendConfiguration,
  )->toString()
  == 'RCPT TO:<receiver@example.com> NOTIFY=FAILURE,DELAY',
);

assert!(Client\_Private\encode_xtext("a+b=c\n") == 'a+2Bb+3Dc+0A');

