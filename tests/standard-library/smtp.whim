final class ScriptedDuplex implements ReadHandle, WriteHandle {
  private MemoryHandle $input;
  public string $output = '';

  public function __construct(string $input) {
    $this->input = new MemoryHandle($input);
  }

  public function waitUntilReadable(
    null|CancellationToken $cancellation = null,
  ): void {
    $this->input->waitUntilReadable($cancellation);
  }

  public function reachedEndOfDataSource(): bool {
    return $this->input->reachedEndOfDataSource();
  }

  public function tryRead(null|int $maxBytes = null): string {
    return $this->input->tryRead($maxBytes);
  }

  public function waitUntilWritable(
    null|CancellationToken $cancellation = null,
  ): void {}

  public function tryWrite(string $bytes): int {
    $this->output .= $bytes;
    return length!($bytes);
  }

  public function write(
    string $bytes,
    null|CancellationToken $cancellation = null,
  ): int {
    return $this->tryWrite($bytes);
  }
}

function smtp_receive_data_message(Listener $listener): string {
  $stream = $listener->accept();
  $reader = new Reader($stream);
  $stream->writeAll("220 smtp.example ESMTP ready\r\n");

  assert!($reader->readLine() == 'EHLO client.example');
  $stream->writeAll("250 smtp.example\r\n");

  assert!($reader->readLine() == 'MAIL FROM:<sender@example.com>');
  $stream->writeAll("250 2.1.0 sender accepted\r\n");

  assert!($reader->readLine() == 'RCPT TO:<receiver@example.com>');
  $stream->writeAll("250 2.1.5 recipient accepted\r\n");

  assert!($reader->readLine() == 'DATA');
  $stream->writeAll("354 send message\r\n");

  $payload = $reader->readUntilBounded("\r\n.\r\n", 65536);
  assert!($payload != null);
  $stream->writeAll("250 2.0.0 queued\r\n");

  assert!($reader->readLine() == 'RSET');
  $stream->writeAll("250 2.0.0 reset\r\n");
  $stream->close();
  return $payload;
}

$command = Command::from('mail from:<sender@example.com>');
assert!($command->verb == 'MAIL');
assert!($command->argument == 'from:<sender@example.com>');
assert!($command->toString() == 'MAIL from:<sender@example.com>');

$assertion_value_9 = fn(): Command => (
  Command::from("DATA\r\nRCPT TO:<victim@example.com>")
);

$assertion_error_9 = null;
try {
  $assertion_value_9();
} catch (InvalidArgumentException $assertion_caught_9) {
  $assertion_error_9 = $assertion_caught_9;
}

assert!($assertion_error_9 is InvalidArgumentException);

$status = EnhancedStatusCode::from('5.1.1');
assert!($status->class == 5);
assert!($status->subject == 1);
assert!($status->detail == 1);
assert!($status->isPermanentFailure() == true);
assert!($status->toString() == '5.1.1');
assert!(EnhancedStatusCode::parse('5.1000.1') == null);

$success = new Reply(250, EnhancedStatusCode::from('2.1.0'), 'accepted');
assert!($success->isPositiveCompletion() == true);
assert!($success->toString() == '250 2.1.0 accepted');

$intermediate = new Reply(354, null, 'continue');
assert!($intermediate->isPositiveIntermediate() == true);
assert!($intermediate->isPositiveCompletion() == false);

$duplex = new ScriptedDuplex(
  "220 smtp.example ESMTP ready\r\n"
  . "250-smtp.example\r\n"
  . "250-SIZE 1048576\r\n"
  . "250 AUTH PLAIN LOGIN\r\n"
  . "250 2.0.0 reset\r\n",
);

$connection = new Connection($duplex);
assert!($connection->readGreeting()->code == 220);
assert!($connection->ehlo('client.example')->code == 250);
assert!($connection->supportsCapability('size') == true);
assert!($connection->capability('AUTH') == 'PLAIN LOGIN');
assert!($connection->maximumMessageSize() == 1048576);
assert!(
  $connection->sendCommand('RSET')->enhancedStatus?->toString() == '2.0.0',
);

assert!($duplex->output == "EHLO client.example\r\nRSET\r\n");

$malformed = new Connection(new ScriptedDuplex("250-first\r\n251 final\r\n"));

$assertion_value_27 = fn(): Reply => $malformed->readReply();
$assertion_error_27 = null;
try {
  $assertion_value_27();
} catch (ProtocolException $assertion_caught_27) {
  $assertion_error_27 = $assertion_caught_27;
}

assert!($assertion_error_27 is ProtocolException);

$stuffed = new DotStuffingReadHandle(
  new MemoryHandle(".first\r\n..second\r\nlast"),
);

assert!($stuffed->readAll() == "..first\r\n...second\r\nlast\r\n.\r\n");

$plainDuplex = new ScriptedDuplex(
  "250-smtp.example\r\n" . "250 AUTH PLAIN\r\n" . "235 2.7.0 authenticated\r\n",
);

$plainConnection = new Connection($plainDuplex);
assert!($plainConnection->ehlo('client.example')->code == 250);
new PlainAuthenticator('user', 'secret')->authenticate($plainConnection);
assert!(
  $plainDuplex->output
  == "EHLO client.example\r\nAUTH PLAIN AHVzZXIAc2VjcmV0\r\n",
);

$noAuthenticationConnection = new Connection(
  new ScriptedDuplex("250 smtp.example\r\n"),
);

discard!($noAuthenticationConnection->ehlo('client.example'));
assert!($noAuthenticationConnection->capability('AUTH') == null);
$assertion_value_32 = function() use ($noAuthenticationConnection): void {
  new PlainAuthenticator('user', 'secret')->authenticate(
    $noAuthenticationConnection,
  );
};

$assertion_error_32 = null;
try {
  $assertion_value_32();
} catch (AuthenticationException $assertion_caught_32) {
  $assertion_error_32 = $assertion_caught_32;
}

assert!($assertion_error_32 is AuthenticationException);

$loginDuplex = new ScriptedDuplex(
  "250-smtp.example\r\n"
  . "250 AUTH LOGIN\r\n"
  . "334 VXNlcm5hbWU6\r\n"
  . "334 UGFzc3dvcmQ6\r\n"
  . "235 2.7.0 authenticated\r\n",
);

$loginConnection = new Connection($loginDuplex);
assert!($loginConnection->ehlo('client.example')->code == 250);
new LoginAuthenticator('user', 'secret')->authenticate($loginConnection);
assert!(
  $loginDuplex->output
  == "EHLO client.example\r\n"
  . "AUTH LOGIN\r\n"
  . "dXNlcg==\r\n"
  . "c2VjcmV0\r\n",
);

$xoauthDuplex = new ScriptedDuplex(
  "250-smtp.example\r\n"
  . "250 AUTH XOAUTH2\r\n"
  . "235 2.7.0 authenticated\r\n",
);

$xoauthConnection = new Connection($xoauthDuplex);
assert!($xoauthConnection->ehlo('client.example')->code == 250);
new XOAuth2Authenticator('user', 'token')->authenticate($xoauthConnection);
assert!(
  $xoauthDuplex->output
  == "EHLO client.example\r\n"
  . 'AUTH XOAUTH2 '
  . Base64\encode("user=user\x01auth=Bearer token\x01\x01")
  . "\r\n",
);

$cramDuplex = new ScriptedDuplex(
  "250-smtp.example\r\n"
