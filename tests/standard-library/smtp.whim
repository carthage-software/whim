$sendConfiguration = new SendConfiguration(
  DeliveryStatusReturn::Headers,
  'message-1',
  vec[DeliveryStatusNotification::Failure, DeliveryStatusNotification::Delay],
  true,
  Priority::Urgent,
  DeliverBy::after(Duration::fromMinutes(10)),
  FutureRelease::after(Duration::fromHours(2)),
);

assert!(
  $sendConfiguration->deliveryStatusReturn == DeliveryStatusReturn::Headers,
);

assert!($sendConfiguration->deliverBy?->deadline->seconds == 600);
assert!($sendConfiguration->futureRelease?->delay?->seconds == 7200);
