use Whim\Binary;
use Whim\IO\MemoryHandle;
use Whim\Math;
use Whim\Unwind\OverflowException;
use Whim\Unwind\UnderflowException;

$big = Binary\Endianness::Big;
$little = Binary\Endianness::Little;
assert!(Binary\Endianness::default() == $big);

assert!(Binary\encode_u8(0xab) == "\xab");
assert!(Binary\decode_u8("\xab") == 0xab);
assert!(Binary\encode_i8(-2) == "\xfe");
assert!(Binary\decode_i8("\xfe") == -2);

assert!(Binary\encode_u16(0x1234, $big) == "\x12\x34");
assert!(Binary\encode_u16(0x1234, $little) == "\x34\x12");
assert!(Binary\decode_u16("\x12\x34", $big) == 0x1234);
assert!(Binary\decode_u16("\x34\x12", $little) == 0x1234);
assert!(Binary\encode_i16(-2, $big) == "\xff\xfe");
assert!(Binary\decode_i16("\xfe\xff", $little) == -2);

assert!(Binary\encode_u32(0x12345678, $big) == "\x12\x34\x56\x78");
assert!(Binary\encode_u32(0x12345678, $little) == "\x78\x56\x34\x12");

assert!(Binary\decode_u32("\x12\x34\x56\x78", $big) == 0x12345678);
assert!(Binary\decode_u32("\x78\x56\x34\x12", $little) == 0x12345678);

assert!(Binary\encode_i32(-2, $big) == "\xff\xff\xff\xfe");
assert!(Binary\decode_i32("\xfe\xff\xff\xff", $little) == -2);

$u64 = 81_985_529_216_486_895;
$u64Big = "\x01\x23\x45\x67\x89\xab\xcd\xef";
$u64Little = "\xef\xcd\xab\x89\x67\x45\x23\x01";
assert!(Binary\encode_u64($u64, $big) == $u64Big);
assert!(Binary\encode_u64($u64, $little) == $u64Little);
assert!(Binary\decode_u64($u64Big, $big) == $u64);
assert!(Binary\decode_u64($u64Little, $little) == $u64);
assert!(Binary\encode_i64(-2, $big) == "\xff\xff\xff\xff\xff\xff\xff\xfe");

assert!(Binary\decode_i64("\xfe\xff\xff\xff\xff\xff\xff\xff", $little) == -2);

$f32Big = "\x3f\xc0\x00\x00";
$f32Little = "\x00\x00\xc0\x3f";
assert!(Binary\encode_f32(1.5, $big) == $f32Big);
assert!(Binary\encode_f32(1.5, $little) == $f32Little);
assert!(Binary\decode_f32($f32Big, $big) == 1.5);
assert!(Binary\decode_f32($f32Little, $little) == 1.5);

$f64Big = "\x3f\xf8\x00\x00\x00\x00\x00\x00";
$f64Little = "\x00\x00\x00\x00\x00\x00\xf8\x3f";
assert!(Binary\encode_f64(1.5, $big) == $f64Big);
assert!(Binary\encode_f64(1.5, $little) == $f64Little);
assert!(Binary\decode_f64($f64Big, $big) == 1.5);
assert!(Binary\decode_f64($f64Little, $little) == 1.5);
assert!(Whim\Float\is_nan(Binary\decode_f32(Binary\encode_f32(Math\NAN))));

assert!(Whim\Float\is_nan(Binary\decode_f64(Binary\encode_f64(Math\NAN))));

$writer = Binary\MemoryWriter::default()
  ->u8(7)
  ->i16(-2)
  ->u32(0x12345678, $little)
  ->f32(1.5)
  ->u8PrefixedBytes('cat')
  ->u16PrefixedBytes('hello');

$encoded = $writer->toString();
$reader = new Binary\MemoryReader($encoded);
assert!($reader->cursor() == 0);
assert!($reader->length() == length!($encoded));
assert!($reader->remaining() == length!($encoded));
assert!(!($reader->isConsumed()));
assert!($reader->u8() == 7);
assert!($reader->i16() == -2);
assert!($reader->u32($little) == 0x12345678);
assert!($reader->f32() == 1.5);
assert!($reader->u8PrefixedBytes() == 'cat');
assert!($reader->u16PrefixedBytes() == 'hello');
assert!($reader->remaining() == 0);
assert!($reader->isConsumed());

$skipReader = new Binary\MemoryReader('abcdef');
$skipReader->skip(2);
assert!($skipReader->cursor() == 2);
assert!($skipReader->bytes(2) == 'cd');

$memory = new MemoryHandle();
$handleWriter = new Binary\HandleWriter($memory, $little);
discard!($handleWriter->u16(0x1234)->f64(1.5)->bytes('ok'));
discard!($memory->seek(0));

$handleReader = new Binary\HandleReader($memory, $little);
assert!($handleReader->u16() == 0x1234);
assert!($handleReader->f64() == 1.5);
$handleReader->skip(1);
assert!($handleReader->bytes(1) == 'k');
assert!($handleReader->isConsumed());

$assertion_value_52 = fn(): int => Binary\decode_u32("\x00\x01");
$assertion_error_52 = null;
try {
  $assertion_value_52();
} catch (UnderflowException $assertion_caught_52) {
  $assertion_error_52 = $assertion_caught_52;
}

assert!($assertion_error_52 is UnderflowException);

$assertion_value_53 = fn(): int => (
  Binary\decode_u64("\xff\xff\xff\xff\xff\xff\xff\xff")
);

$assertion_error_53 = null;
try {
  $assertion_value_53();
} catch (OverflowException $assertion_caught_53) {
  $assertion_error_53 = $assertion_caught_53;
}

assert!($assertion_error_53 is OverflowException);
