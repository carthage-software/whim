use Whim\Async;
use Whim\Async\CancellationToken;
use Whim\Async\CancelledException;
use Whim\Filesystem;
use Whim\IP\Address;
use Whim\IP\Family;
use Whim\Network\InternetEndpoint;
use Whim\Network\NetworkException;
use Whim\Network\UnixEndpoint;
use Whim\TCP;
use Whim\UDP;
use Whim\Unix;

final class ResolutionCancellationToken implements CancellationToken {
  private bool $cancelled = false;

  public function isCancellationRequested(): bool {
    return $this->cancelled;
  }

  public function throwIfCancellationRequested(): void {
    if ($this->cancelled) {
      throw new CancelledException('the operation was cancelled');
    }
  }

  public function register(fn(): void $callback): int {
    $this->cancelled = true;
    $callback();
    return 0;
  }

  public function unregister(int $id): void {}
}

$resolutionCancellation = null;
try {
  Whim\Network\_Private\resolve_host_addresses(
    'localhost',
    new ResolutionCancellationToken(),
  );
} catch (CancelledException $error) {
  $resolutionCancellation = $error;
}

assert!($resolutionCancellation is CancelledException);

$ipv4 = new InternetEndpoint(Address::v4('127.0.0.1'), 8080);
assert!($ipv4->toString() == '127.0.0.1:8080');

$ipv6 = new InternetEndpoint(Address::v6('::1'), 443);
assert!($ipv6->toString() == '[::1]:443');
assert!(
  new UnixEndpoint('/tmp/example.sock')->toString() == '/tmp/example.sock',
);

assert!(new UnixEndpoint(null)->toString() == '<anonymous>');

$listener = TCP\listen();
$tcpEndpoint = $listener->getLocalEndpoint();
$server = Async\spawn::<null>(fn(): null {
  $stream = $listener->accept();
  assert!($stream->readFixedSize(4) == 'ping');
  $stream->writeAll('pong');
  $stream->shutdown();
  $stream->close();

  return null;
});

$client = TCP\connect($tcpEndpoint->address, $tcpEndpoint->port);
$client->writeAll('ping');
assert!($client->readFixedSize(4) == 'pong');
assert!($client->getLocalEndpoint() is InternetEndpoint);
assert!(
  $client->getPeerEndpoint()->address->toString() == $tcpEndpoint->address->toString(),
);

assert!($client->getPeerEndpoint()->port == $tcpEndpoint->port);
$client->close();
$server->await();
$listener->close();

($left, $right) = Unix\pair();
$left->writeAll('pair');
assert!($right->readFixedSize(4) == 'pair');
assert!($left->getLocalEndpoint()->path == null);
$left->close();
$right->close();

$directory = Filesystem\create_temporary_directory(null, 'whim-network-');
$socketPath = $directory . '/socket';
$unixListener = Unix\listen($socketPath);
$unixServer = Async\spawn::<null>(fn(): null {
  $stream = $unixListener->accept();
  assert!($stream->readFixedSize(5) == 'hello');
  $stream->writeAll('world');
  $stream->close();

  return null;
});

$unixClient = Unix\connect($socketPath);
$unixClient->writeAll('hello');
assert!($unixClient->readFixedSize(5) == 'world');
$unixClient->close();
$unixServer->await();
$unixListener->close();
Filesystem\delete_file($socketPath);
Filesystem\delete_directory($directory);

$receiver = UDP\bind(new InternetEndpoint(Address::v4('127.0.0.1'), 0));

$sender = UDP\bind(new InternetEndpoint(Address::v4('127.0.0.1'), 0));

$senderEndpoint = $sender->getLocalEndpoint();
$receiverEndpoint = $receiver->getLocalEndpoint();
$metadata = new UDP\SendMetadata(
  $senderEndpoint->address,
  UDP\ExplicitCongestion::CapableTransport1,
);

assert!($sender->sendTo('datagram', $receiverEndpoint, $metadata) == 8);

$datagram = $receiver->receive(64);
assert!($datagram->bytes == 'datagram');
assert!(
  $datagram->peer->address->toString() == $senderEndpoint->address->toString(),
);

assert!($datagram->peer->port == $senderEndpoint->port);
assert!(
  $datagram->local->address->toString() == $receiverEndpoint->address->toString(),
);

assert!($datagram->local->port == $receiverEndpoint->port);
assert!(
  $datagram->explicitCongestion == UDP\ExplicitCongestion::CapableTransport1,
);

assert!($datagram->interfaceIndex >= 0);
assert!(!($datagram->truncated));

discard!($sender->sendTo('truncated', $receiverEndpoint));
$truncated = $receiver->receive(3);
assert!($truncated->bytes == 'tru');
assert!($truncated->truncated);

$connected = $sender->connect($receiverEndpoint);
assert!($sender->isClosed());
assert!(
  $connected->getPeerEndpoint()->address->toString() == $receiverEndpoint->address->toString(),
);

assert!($connected->getPeerEndpoint()->port == $receiverEndpoint->port);

assert!($connected->send('connected') == 9);
$connectedDatagram = $receiver->receive(64);
assert!($connectedDatagram->bytes == 'connected');

$connectedMetadata = new UDP\SendMetadata(
  $connected->getLocalEndpoint()->address,
  UDP\ExplicitCongestion::CapableTransport0,
);

assert!($connected->send('metadata', $connectedMetadata) == 8);
$metadataDatagram = $receiver->receive(64);
assert!($metadataDatagram->bytes == 'metadata');
assert!(
  $metadataDatagram->explicitCongestion
  == UDP\ExplicitCongestion::CapableTransport0,
);

discard!($receiver->sendTo('reply', $connected->getLocalEndpoint()));
assert!($connected->receive(64)->bytes == 'reply');
$connected->close();
$receiver->close();

foreach (vec[
  (
    Address::v4('0.0.0.0'),
    Address::v4('127.0.0.1'),
    Address::v4('127.0.0.1'),
    true,
  ),
  (Address::v6('::'), Address::v6('::1'), Address::v6('::1'), true),
  (
    Address::v6('::'),
    Address::v6('::ffff:127.0.0.1'),
    Address::v6('::ffff:127.0.0.1'),
    false,
  ),
  (
    Address::v6('::'),
    Address::v6('::ffff:127.0.0.1'),
    Address::v6('::'),
    false,
  ),
] as ($wildcard, $loopback, $senderBinding, $onlyIPv6)) {
  $configuration = new UDP\BindConfiguration(onlyIPv6: $onlyIPv6);
  $receiver = UDP\bind(new InternetEndpoint($wildcard, 0), $configuration);
  $sender = UDP\bind(new InternetEndpoint($senderBinding, 0), $configuration);
  $destination = new InternetEndpoint(
    $loopback,
    $receiver->getLocalEndpoint()->port,
  );

  $metadata = new UDP\SendMetadata(
    $loopback,
    UDP\ExplicitCongestion::CapableTransport1,
  );

  assert!($sender->sendTo('wildcard', $destination, $metadata) == 8);
  $datagram = $receiver->receive(64);
  assert!('wildcard' == $datagram->bytes);
  assert!($datagram->local->address->toString() == $loopback->toString());
  assert!($datagram->interfaceIndex > 0);
  assert!(
    UDP\ExplicitCongestion::CapableTransport1 == $datagram->explicitCongestion,
  );

  $interface = match ($loopback->family) {
    Family::V4 => 0,
    Family::V6 => $datagram->interfaceIndex,
  };

  $reply = new UDP\SendMetadata(
    $datagram->local->address,
    UDP\ExplicitCongestion::CapableTransport0,
    $interface,
  );

  assert!($receiver->sendTo('reply', $datagram->peer, $reply) == 5);
  $received = $sender->receive(64);
  assert!('reply' == $received->bytes);
  assert!(
    $received
      ->peer
      ->address
      ->toIPv4Mapped()
      ->toString() == $loopback->toIPv4Mapped()->toString(),
  );

  if (operating_system!() != 'freebsd' || !$senderBinding->isIPv4Mapped()) {
    assert!($received->interfaceIndex > 0);
    assert!(
      UDP\ExplicitCongestion::CapableTransport0
      == $received->explicitCongestion,
    );
  }

  if ('freebsd' == operating_system!() && Family::V4 == $loopback->family) {
    $rejected = false;
    try {
      discard!(
        $sender->sendTo(
          'interface',
          $destination,
          new UDP\SendMetadata(
            $loopback,
            interfaceIndex: $datagram->interfaceIndex,
          ),
        ),
      );
    } catch (NetworkException $_) {
      $rejected = true;
    }

    assert!($rejected);
  }

  if (operating_system!() == 'windows') {
    $unsupported = false;
    try {
      discard!(
        $sender->sendTo(
          'congestion',
          $destination,
          new UDP\SendMetadata(
            $loopback,
            UDP\ExplicitCongestion::CongestionExperienced,
          ),
        ),
      );
    } catch (Whim\Unwind\UnsupportedPlatformException $_) {
      $unsupported = true;
    }

    assert!($unsupported);
  }

  $receiver->close();
  $sender->close();
}
