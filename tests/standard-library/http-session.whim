use Whim\Async;
use Whim\Async\CancellationToken;
use Whim\Async\CancelledException;
use Whim\Async\SignalCancellationToken;
use Whim\Database\SQLite\Connector as SQLiteConnector;
use Whim\Filesystem;
use Whim\HTTP\Message\FieldMap;
use Whim\HTTP\Message\ProtocolVersion;
use Whim\HTTP\Message\Request;
use Whim\HTTP\Message\Response;
use Whim\HTTP\Server\Context;
use Whim\HTTP\Server\Handler\FunctionHandler;
use Whim\HTTP\Server\Middleware\Session as SessionMiddleware;
use Whim\HTTP\Session\Configuration;
use Whim\HTTP\Session\ConflictException;
use Whim\HTTP\Session\Session;
use Whim\HTTP\Session\Storage\DatabaseStore;
use Whim\HTTP\Session\Storage\MemoryStore;
use Whim\HTTP\Session\UnavailableItemException;
use Whim\IP\Address;
use Whim\Network\Endpoint;
use Whim\Network\InternetEndpoint;
use Whim\Refine\NonEmptyString;
use Whim\Str;
use Whim\Time\Duration;
use Whim\Unwind\InvalidArgumentException;

final class HTTPSessionTestContext implements Context\Context {
  public dict<string, string> $parameters = dict[];
  private null|Session $session = null;

  public function __construct(
    public readonly ProtocolVersion $protocolVersion,
    public readonly Endpoint $localEndpoint,
    public readonly Endpoint $peerEndpoint,
  ) {}

  public function getSession(): null|Session {
    return $this->session;
  }

  public function setSession(Session $session): void {
    $this->session = $session;
  }

  public function onResponseComplete(fn(): void $callback): void {}
}

function http_session_test_context(): HTTPSessionTestContext {
  $local = new InternetEndpoint(Address::v4('127.0.0.1'), 8080u);
  $peer = new InternetEndpoint(Address::v4('127.0.0.2'), 60_000u);
  return new HTTPSessionTestContext(ProtocolVersion::V11, $local, $peer);
}

function http_session_identifier(Response $response): NonEmptyString {
  $value = $response->headers->get('Set-Cookie') as string;
  $pair = Str\split($value, ';', 2u)[0];
  return Str\split($pair, '=', 2u)[1] as NonEmptyString;
}

function http_session_request(null|string $identifier = null): Request {
  $headers = match ($identifier) {
    null => FieldMap::default(),
    $identifier @ string => FieldMap::from(vec[
      ('Cookie', '__session=' . $identifier),
    ]),
  };

  return Request::fromParts('GET', headers: $headers);
}

function http_session_conflict(fn(): void $operation): void {
  try {
    $operation();
  } catch (ConflictException $_) {
    return;
  }

  panic!('expected a session conflict');
}

$session = new Session(dict['nullable' => null]);
assert!($session->contains('nullable'));
assert!($session->get('nullable') == null);
assert!($session->toIterator()->next() == ('nullable', null));
assert!(!($session->isDirty()));
$assertion_value_5 = fn(): Whim\Json\Value => $session->get('missing');
$assertion_error_5 = null;
try {
  $assertion_value_5();
} catch (UnavailableItemException $assertion_caught_5) {
  $assertion_error_5 = $assertion_caught_5;
}

assert!($assertion_error_5 is UnavailableItemException);

$session->set('name', 'Whim');
assert!($session->get('name') == 'Whim');
assert!($session->isDirty());
$session->remove('name');
assert!(!($session->contains('name')));

$session->regenerateIdentifier();
assert!($session->isIdentifierRegenerationRequested());
$session->destroy();
assert!($session->toDict() == dict[]);
assert!($session->isDestroyed());

$configuration = new Configuration();
assert!($configuration->cookie->name == '__session');
assert!($configuration->cookie->secure);
assert!($configuration->cookie->httpOnly);
assert!(!($configuration->rollingExpiration));
$assertion_value_16 = fn(): Configuration => (
  new Configuration(idleTimeout: Duration::zero())
);

$assertion_error_16 = null;
try {
  $assertion_value_16();
} catch (InvalidArgumentException $assertion_caught_16) {
  $assertion_error_16 = $assertion_caught_16;
}

assert!($assertion_error_16 is InvalidArgumentException);

$store = new MemoryStore();
$cancellation = new SignalCancellationToken();
$ttl = Duration::fromMinutes(5);
$store->create('identifier', dict['count' => 1], $ttl);
$record = $store->load('identifier');
assert!(!($record == null));
assert!($record?->data == dict['count' => 1]);
assert!($record?->revision == 0u);

$store->replace('identifier', 0u, dict['count' => 2], $ttl, $cancellation);

assert!($store->load('identifier', $cancellation)?->revision == 1u);
assert!($store->load('identifier', $cancellation)?->data == dict['count' => 2]);

$assertion_value_22 = fn(): void {
  $store->replace('identifier', 0u, dict[], $ttl, $cancellation);
};

$assertion_error_22 = null;
try {
  $assertion_value_22();
} catch (ConflictException $assertion_caught_22) {
  $assertion_error_22 = $assertion_caught_22;
}

assert!($assertion_error_22 is ConflictException);

$conflictingMiddleware = new SessionMiddleware(
  $store,
  new Configuration(rollingExpiration: true),
);

$assertion_value_23 = fn(): Response {
  return $conflictingMiddleware->handle(
    http_session_test_context(),
    http_session_request('identifier'),
    new FunctionHandler(
      fn(
        Context\Context $_context,
        Request $_request,
        CancellationToken $_cancellation,
      ): Response {
        $store->replace('identifier', 1u, dict['external' => true], $ttl);
        return new Response(200);
      },
    ),
    $cancellation,
  );
};

$assertion_error_23 = null;
try {
  $assertion_value_23();
} catch (ConflictException $assertion_caught_23) {
  $assertion_error_23 = $assertion_caught_23;
}

assert!($assertion_error_23 is ConflictException);

$store->delete('identifier', $cancellation);
assert!($store->load('identifier', $cancellation) == null);

$middlewareStore = new MemoryStore();
$middleware = new SessionMiddleware($middlewareStore);
$context = http_session_test_context();
$response = $middleware->handle(
  $context,
  http_session_request(),
  new FunctionHandler(
    fn(
      Context\Context $context,
      Request $_request,
      CancellationToken $_cancellation,
    ): Response {
      $session = $context->getSession() as Session;
      assert!($session->toDict() == dict[]);
      $session->set('account', 42);
      return new Response(204);
    },
  ),
  new SignalCancellationToken(),
);

$identifier = http_session_identifier($response);
assert!(length!($identifier) == 64u);
assert!($middlewareStore->load($identifier)?->data == dict['account' => 42]);

$context = http_session_test_context();
$response = $middleware->handle(
  $context,
  http_session_request($identifier),
  new FunctionHandler(
    fn(
      Context\Context $context,
      Request $_request,
      CancellationToken $_cancellation,
    ): Response {
      $session = $context->getSession() as Session;
      assert!($session->get('account') == 42);
      $session->set('account', 84);
      return new Response(200);
    },
  ),
  new SignalCancellationToken(),
);

assert!(!($response->headers->has('Set-Cookie')));
assert!($middlewareStore->load($identifier)?->data == dict['account' => 84]);

$context = http_session_test_context();
$response = $middleware->handle(
  $context,
  http_session_request($identifier),
  new FunctionHandler(
    fn(
      Context\Context $context,
      Request $_request,
      CancellationToken $_cancellation,
    ): Response {
      ($context->getSession() as Session)->regenerateIdentifier();
      return new Response(204);
    },
  ),
  new SignalCancellationToken(),
);

$freshIdentifier = http_session_identifier($response);
assert!(!($freshIdentifier == $identifier));
assert!($middlewareStore->load($identifier) == null);
assert!(
  $middlewareStore->load($freshIdentifier)?->data == dict['account' => 84],
);

$context = http_session_test_context();
$response = $middleware->handle(
  $context,
  http_session_request($freshIdentifier),
  new FunctionHandler(
    fn(
      Context\Context $context,
      Request $_request,
      CancellationToken $_cancellation,
    ): Response {
      ($context->getSession() as Session)->destroy();
      return new Response(204);
    },
  ),
  new SignalCancellationToken(),
);

assert!($middlewareStore->load($freshIdentifier) == null);
assert!(
  Str\search(
    $response->headers->get('Set-Cookie') as string,
    'Max-Age=0',
  ) is uint,
);

$context = http_session_test_context();
$response = $middleware->handle(
  $context,
  http_session_request(),
  new FunctionHandler(
    fn(
      Context\Context $_context,
      Request $_request,
      CancellationToken $_cancellation,
    ): Response => new Response(204),
  ),
  new SignalCancellationToken(),
);

assert!(!($response->headers->has('Set-Cookie')));
assert!(http_session_test_context()->getSession() == null);

$directory = Filesystem\create_temporary_directory(null, 'whim-session-store-');

$databaseStore = new DatabaseStore(
  new SQLiteConnector($directory . '/sessions.sqlite'),
);

$databaseStore->create('database', dict['count' => 1], $ttl, $cancellation);
assert!(
  $databaseStore->load('database', $cancellation)?->data == dict['count' => 1],
);

assert!($databaseStore->load('database')?->revision == 0u);

$databaseStore->replace(
  'database',
  0u,
  dict['count' => 2, 'nullable' => null],
  $ttl,
);

assert!($databaseStore->load('database')?->revision == 1u);
assert!(
  $databaseStore->load('database')?->data == dict[
    'count' => 2,
    'nullable' => null,
  ],
);

$assertion_value_42 = fn(): void {
  $databaseStore->replace('database', 0u, dict[], $ttl);
};

$assertion_error_42 = null;
try {
  $assertion_value_42();
} catch (ConflictException $assertion_caught_42) {
  $assertion_error_42 = $assertion_caught_42;
}

assert!($assertion_error_42 is ConflictException);

$assertion_value_43 = fn(): void {
  $databaseStore->create('database', dict[], $ttl);
};

$assertion_error_43 = null;
try {
  $assertion_value_43();
} catch (ConflictException $assertion_caught_43) {
  $assertion_error_43 = $assertion_caught_43;
}

assert!($assertion_error_43 is ConflictException);

$databaseStore->delete('database');
assert!($databaseStore->load('database') == null);

$databaseStore->create(
  'expired',
  dict['stale' => true],
  Duration::nanosecond(),
);

assert!($databaseStore->load('expired') == null);
$databaseStore->create('expired', dict['fresh' => true], $ttl);
assert!($databaseStore->load('expired')?->data == dict['fresh' => true]);

foreach (vec[new MemoryStore(), $databaseStore] as $rotationStore) {
  $rotationStore->create('source', dict['account' => 42], $ttl);
  $rotationStore->create('taken', dict['account' => 84], $ttl);
  foreach (vec[
    ('source', 0u, 'taken'),
    ('source', 1u, 'fresh'),
    ('missing', 0u, 'fresh'),
    ('source', 0u, 'source'),
  ] as ($source, $revision, $destination)) {
    http_session_conflict(fn(): void {
      $rotationStore->rotate($source, $revision, $destination, dict[], $ttl);
    });

    assert!(dict['account' => 42] == $rotationStore->load('source')?->data);
    assert!(0u == $rotationStore->load('source')?->revision);
    assert!(dict['account' => 84] == $rotationStore->load('taken')?->data);
    assert!(null == $rotationStore->load('fresh'));
  }

  $rotationStore->create('expired-source', dict[], Duration::nanosecond());
  http_session_conflict(fn(): void {
    $rotationStore->rotate('expired-source', 0u, 'fresh', dict[], $ttl);
  });

  assert!(null == $rotationStore->load('fresh'));
  $rotationStore->replace('source', 0u, dict['account' => 43], $ttl);
  $rotationStore->rotate('source', 1u, 'fresh', dict['account' => 44], $ttl);
  assert!(null == $rotationStore->load('source'));
  assert!(dict['account' => 44] == $rotationStore->load('fresh')?->data);
  assert!(0u == $rotationStore->load('fresh')?->revision);

  $rotationStore->create('expired-target', dict[], Duration::nanosecond());
  $rotationStore->rotate('fresh', 0u, 'expired-target', dict[], $ttl);
  assert!(null == $rotationStore->load('fresh'));
  assert!(dict[] == $rotationStore->load('expired-target')?->data);

  $cancelled = new SignalCancellationToken();
  $cancelled->cancel();
  $caught = null;
  try {
    $rotationStore->rotate('taken', 0u, 'fresh', dict[], $ttl, $cancelled);
  } catch (CancelledException $error) {
    $caught = $error;
  }

  assert!($caught is CancelledException);
  assert!(dict['account' => 84] == $rotationStore->load('taken')?->data);
  assert!(null == $rotationStore->load('fresh'));

  $rotationStore->create('contended', dict['account' => 42], $ttl);
  $rotations = vec[];
  foreach (vec['first', 'second'] as $destination) {
    $rotations[] = Async\spawn::<bool>(fn(): bool {
      try {
        $rotationStore->rotate('contended', 0u, $destination, dict[], $ttl);
        return true;
      } catch (ConflictException $_) {
        return false;
      }
    });
  }

  $winners = 0u;
  foreach ($rotations as $rotation) {
    if ($rotation->await()) {
      $winners++;
    }
  }

  assert!(1u == $winners);
  assert!(null == $rotationStore->load('contended'));
  assert!(
    (null != $rotationStore->load('first'))
    != (null != $rotationStore->load('second')),
  );

  $rotationMiddleware = new SessionMiddleware($rotationStore);
  foreach (vec['delete', 'replace', 'rotate'] as $operation) {
    $rotationStore->create('rotation', dict['account' => 42], $ttl);
    http_session_conflict(fn(): void {
      $rotationMiddleware->handle(
        http_session_test_context(),
        http_session_request('rotation'),
        new FunctionHandler(fn(Context\Context $context): Response {
          ($context->getSession() as Session)->regenerateIdentifier();
          if ('delete' == $operation) {
            $rotationStore->delete('rotation');
          } else if ('replace' == $operation) {
            $rotationStore->replace(
              'rotation',
              0u,
              dict['account' => 84],
              $ttl,
            );
          } else {
            $rotationStore->rotate(
              'rotation',
              0u,
              'winner',
              dict['account' => 84],
              $ttl,
            );
          }

          return new Response(204);
        }),
        $cancellation,
      );
    });

    assert!(
      $rotationStore->load('rotation')?->data == match ($operation) {
        'delete' | 'rotate' => null,
        'replace' => dict['account' => 84],
      },
    );

    $rotationStore->delete('rotation');
  }

  assert!(dict['account' => 84] == $rotationStore->load('winner')?->data);
  foreach (vec[null, 'unknown'] as $identifier) {
    $response = $rotationMiddleware->handle(
      http_session_test_context(),
      http_session_request($identifier),
      new FunctionHandler(fn(Context\Context $context): Response {
        $session = $context->getSession() as Session;
        $session->set('account', 42);
        $session->regenerateIdentifier();
        return new Response(204);
      }),
      $cancellation,
    );

    $fresh = http_session_identifier($response);
    assert!(dict['account' => 42] == $rotationStore->load($fresh)?->data);
    assert!(0u == $rotationStore->load($fresh)?->revision);
  }
}

Filesystem\delete_directory($directory, true);
