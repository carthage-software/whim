use Whim\Password;
use Whim\Password\Argon2id;
use Whim\Password\Argon2i;
use Whim\Password\Bcrypt;
use Whim\Str;

$bcrypt = new Bcrypt(cost: 4);
$hash = Password\hash('correct horse battery staple', $bcrypt);
assert!(Str\starts_with($hash, '$2b$04$'));
assert!(Password\verify('correct horse battery staple', $hash));

assert!(!(Password\verify('correct horse battery stable', $hash)));

assert!(!(Password\needs_rehash($hash, $bcrypt)));
assert!(Password\needs_rehash($hash, new Bcrypt(cost: 5)));

assert!(
  Password\verify(
    'rasmuslerdorf',
    '$2y$10$.vGA1O9wmRjrwAVXD98HNOgsNpDczlqm3Jq7KnEd1rVAGv3Fykk1a',
  ),
);

$argon2id = new Argon2id(
  memoryCost: 8192,
  timeCost: 1,
  parallelism: 1,
);

$hash = Password\hash('correct horse battery staple', $argon2id);
assert!(Str\starts_with($hash, '$argon2id$v=19$m=8192,t=1,p=1$'));

assert!(Password\verify('correct horse battery staple', $hash));

assert!(!(Password\verify('wrong', $hash)));
assert!(!(Password\needs_rehash($hash, $argon2id)));
assert!(
  Password\needs_rehash(
    $hash,
    new Argon2id(
      memoryCost: 16384,
      timeCost: 1,
      parallelism: 1,
    ),
  ),
);

assert!(Password\needs_rehash($hash, new Bcrypt(cost: 4)));

$argon2i = new Argon2i(
  memoryCost: 8192,
  timeCost: 1,
  parallelism: 1,
);

$other = Password\hash('correct horse battery staple', $argon2i);
assert!(Str\starts_with($other, '$argon2i$v=19$m=8192,t=1,p=1$'));

assert!(Password\verify('correct horse battery staple', $other));

assert!(Password\needs_rehash($other, $argon2id));
assert!(!(Password\needs_rehash($other, $argon2i)));

assert!(!(Password\verify('anything', 'not a hash at all')));
assert!(!(Password\verify('anything', '')));
assert!(Password\needs_rehash('not a hash at all', $bcrypt));
assert!(Password\needs_rehash('', $argon2id));

$overlong = Str\pad_left('', 73, 'p');
$rejected = null;
$assertion_callable_21 = fn(): string => Password\hash($overlong, $bcrypt);
try {
  $assertion_callable_21();
} catch (Whim\Unwind\InvalidArgumentException $assertion_caught_21) {
  $rejected = $assertion_caught_21;
}

assert!($rejected is Whim\Unwind\InvalidArgumentException);

assert!(
  $rejected->getMessage()
  == 'bcrypt reads at most 72 password bytes; hash a digest of longer input instead',
);

$redactedFrames = 0;
foreach ($rejected->getTrace() as $frame) {
  if ($frame->function != 'Whim\Password\hash') {
    continue;
  }

  assert!($frame->arguments[0] is Whim\Marker\SensitiveParameterValue);

  $redactedFrames++;
}

assert!($redactedFrames == 1);

$long = Password\hash($overlong, $argon2id);
assert!(Password\verify($overlong, $long));
