  FieldMap::from(vec[('Bad Name', 'value')])
);

$assertion_error_39 = null;
try {
  $assertion_value_39();
} catch (InvalidArgumentException $assertion_caught_39) {
  $assertion_error_39 = $assertion_caught_39;
}

assert!($assertion_error_39 is InvalidArgumentException);

$assertion_value_40 = fn(): FieldMap => (
  FieldMap::from(vec[('Good-Name', "value\r\ninjected")])
);

$assertion_error_40 = null;
try {
  $assertion_value_40();
} catch (InvalidArgumentException $assertion_caught_40) {
