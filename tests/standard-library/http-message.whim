$url = URL::from('https://example.com/search?q=whim#section');
$request = Request::fromURL(Message\METHOD_GET, $url, headers: $fields);
assert!($request->method == 'GET');
assert!($request->requestTarget == '/search?q=whim');
assert!($request->url == $url);
assert!($request->protocolVersion == ProtocolVersion::V11);
assert!($request->body == null);
assert!($request->trailers == null);

$parsedRequest = Request::fromPartsUnsafe(
  Message\METHOD_GET,
  '/parsed',
  URL::from('https://example.com/parsed'),
  ProtocolVersion::V11,
  $fields,
);

assert!($parsedRequest->requestTarget == '/parsed');
assert!($parsedRequest->headers == $fields);

$custom = $request->withMethod('CUSTOM')->withRequestTarget('*');
assert!($custom->method == 'CUSTOM');
assert!($custom->requestTarget == '*');

$withoutURL = $custom->withURL(null);
assert!($withoutURL->url == null);
assert!($withoutURL->requestTarget == '*');

$changedURL = $custom->withURL(URL::from('https://example.net/new'));
assert!($changedURL->requestTarget == '/new');

$body = new MemoryHandle('body');
$withBody = $request->withBody($body);
assert!($withBody->body is MemoryHandle);
assert!($request->body == null);

$changedRequest = $request
  ->withHeader('Content-Type', 'application/json')
  ->withAddedHeader('X-Test', 'one')
  ->withProtocolVersion(ProtocolVersion::V2);

assert!($changedRequest->headers->get('content-type') == 'application/json');

assert!($changedRequest->headers->get('x-test') == 'one');
assert!($changedRequest->protocolVersion == ProtocolVersion::V2);

$assertion_value_59 = fn(): Request => $request->withMethod('bad method');
$assertion_error_59 = null;
try {
  $assertion_value_59();
} catch (InvalidArgumentException $assertion_caught_59) {
  $assertion_error_59 = $assertion_caught_59;
}

assert!($assertion_error_59 is InvalidArgumentException);

$assertion_value_60 = fn(): Request => (
  $request->withRequestTarget('/bad#fragment')
);

$assertion_error_60 = null;
try {
  $assertion_value_60();
} catch (InvalidArgumentException $assertion_caught_60) {
  $assertion_error_60 = $assertion_caught_60;
}

assert!($assertion_error_60 is InvalidArgumentException);

$response = new Response(Message\STATUS_CREATED, headers: $fields);
assert!($response->status == 201);
assert!($response->headers == $fields);

$changedResponse = $response
  ->withStatus(Message\STATUS_NO_CONTENT)
  ->withProtocolVersion(ProtocolVersion::V2)
  ->withoutHeader('Set-Cookie');

assert!($changedResponse->status == 204);
assert!($changedResponse->protocolVersion == ProtocolVersion::V2);
assert!(!($changedResponse->headers->has('set-cookie')));
assert!($response->status == 201);

$assertion_value_67 = fn(): Response => new Response(99);
$assertion_error_67 = null;
try {
  $assertion_value_67();
} catch (TypeError $assertion_caught_67) {
  $assertion_error_67 = $assertion_caught_67;
}

assert!($assertion_error_67 is TypeError);
assert!(Message\reason_phrase(Message\STATUS_OK) == 'OK');
assert!(Message\reason_phrase(Message\STATUS_IM_A_TEAPOT) == "I'm a Teapot");

assert!(Message\reason_phrase(599) == null);

$jsonResponse = Message\Response\json(new JsonResponseBody());
assert!($jsonResponse->status == Message\STATUS_OK);
assert!($jsonResponse->headers->get('Content-Type') == 'application/json');

assert!($jsonResponse->headers->get('Content-Length') == '18');
assert!($jsonResponse->body != null);
assert!($jsonResponse->body->readAll() == '{"converted":true}');

$textResponse = Message\Response\text(
  new PrintableResponseBody(),
  Message\STATUS_CREATED,
  FieldMap::from(vec[('X-Test', 'present')]),
);

assert!($textResponse->status == Message\STATUS_CREATED);
assert!(
  $textResponse->headers->get('Content-Type') == 'text/plain; charset=utf-8',
);

assert!($textResponse->headers->get('Content-Length') == '9');
assert!($textResponse->headers->get('X-Test') == 'present');
assert!($textResponse->body != null);
assert!($textResponse->body->readAll() == 'converted');

$htmlResponse = Message\Response\html('<strong>Whim</strong>');
assert!(
  $htmlResponse->headers->get('Content-Type') == 'text/html; charset=utf-8',
);

$emptyResponse = Message\Response\empty(Message\STATUS_NOT_FOUND);
assert!($emptyResponse->status == Message\STATUS_NOT_FOUND);
assert!($emptyResponse->body == null);

$redirectResponse = Message\Response\redirect('/next');
assert!($redirectResponse->status == Message\STATUS_FOUND);
assert!($redirectResponse->headers->get('Location') == '/next');

$seeOtherResponse = Message\Response\see_other(
  URI::from('/complete?source=form'),
);

assert!($seeOtherResponse->status == Message\STATUS_SEE_OTHER);
assert!($seeOtherResponse->headers->get('Location') == '/complete?source=form');

$temporaryRedirect = Message\Response\temporary_redirect(
  URL::from('https://example.com/temporary'),
);

assert!($temporaryRedirect->status == Message\STATUS_TEMPORARY_REDIRECT);

$permanentRedirect = Message\Response\permanent_redirect('/permanent');
assert!($permanentRedirect->status == Message\STATUS_PERMANENT_REDIRECT);

$assertion_value_89 = fn(): Response => (
  Message\Response\redirect("/bad\r\nLocation: /injected")
);

$assertion_error_89 = null;
try {
  $assertion_value_89();
} catch (InvalidArgumentException $assertion_caught_89) {
  $assertion_error_89 = $assertion_caught_89;
}

assert!($assertion_error_89 is InvalidArgumentException);

$informational = new Response(
  Message\STATUS_EARLY_HINTS,
  headers: FieldMap::from(vec[('Link', '</style.css>; rel=preload')]),
);

$pushedRequest = Request::fromURL(
  Message\METHOD_GET,
  URL::from('https://example.com/style.css'),
  protocolVersion: ProtocolVersion::V2,
);

$pushedResponse = new Response(
  Message\STATUS_OK,
  protocolVersion: ProtocolVersion::V2,
);

$pushed = new Deferred::<vec<Exchange>>();
$pushed->complete(vec[new Exchange($pushedRequest, $pushedResponse)]);

$transaction = new Transaction(
  vec[$informational],
  $pushed->getFuture(),
  $response,
);

assert!($transaction->informational == vec[$informational]);
assert!($transaction->response == $response);
$pushes = $transaction->pushed;
assert!($pushes != null);
$pushes = $pushes->await();
assert!(length!($pushes) == 1);
assert!($pushes[0]->request == $pushedRequest);
assert!($pushes[0]->response == $pushedResponse);

$simpleTransaction = new Transaction(vec[], null, $response);
assert!($simpleTransaction->pushed == null);
