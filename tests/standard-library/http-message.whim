use Whim\Async\Deferred;
use Whim\HTTP\Cookie;
use Whim\HTTP\Cookie\Collection;
use Whim\HTTP\Cookie\SameSite;
use Whim\HTTP\Cookie\SetCookie;
use Whim\HTTP\Message;
use Whim\HTTP\Message\Exchange;
use Whim\HTTP\Message\FieldMap;
use Whim\HTTP\Message\ProtocolVersion;
use Whim\HTTP\Message\Request;
use Whim\HTTP\Message\Response;
use Whim\HTTP\Message\Transaction;
use Whim\IO\MemoryHandle;
use Whim\Json;
use Whim\Json\ToJson;
use Whim\Json\Value as JsonValue;
use Whim\Convert\ToString;
use Whim\Unwind\InvalidArgumentException;
use Whim\Unwind\TypeError;
use Whim\URI\URI;
use Whim\URL\URL;

final readonly class PrintableResponseBody implements ToString {
  public function toString(): string {
    return 'converted';
  }
}

final readonly class JsonResponseBody implements ToJson {
  public function toJson(): JsonValue {
    return dict['converted' => true];
  }
}

assert!(ProtocolVersion::V10->value == 'HTTP/1.0');
assert!(ProtocolVersion::V11->value == 'HTTP/1.1');
assert!(ProtocolVersion::V2->value == 'HTTP/2');
assert!(ProtocolVersion::V3->value == 'HTTP/3');

$fields = FieldMap::from(vec[
  ('Content-Type', 'text/plain'),
  ('Set-Cookie', 'session=one'),
  ('set-cookie', 'theme=dark'),
]);

assert!($fields->count() == 3);
assert!(!($fields->isEmpty()));
assert!($fields->has('content-type'));
assert!($fields->has('CONTENT-TYPE'));
assert!($fields->get('Content-Type') == 'text/plain');
assert!($fields->get('missing') == null);
assert!($fields->getAll('SET-COOKIE') == vec['session=one', 'theme=dark']);

assert!(
  $fields->toVec() == vec[
    ('Content-Type', 'text/plain'),
    ('Set-Cookie', 'session=one'),
    ('set-cookie', 'theme=dark'),
  ],
);

$iterated = vec[];
foreach ($fields as $index => $field) {
  $iterated[] = ($index, $field);
}

assert!(
  $iterated == vec[
    (0, ('Content-Type', 'text/plain')),
    (1, ('Set-Cookie', 'session=one')),
    (2, ('set-cookie', 'theme=dark')),
  ],
);

$replaced = $fields->with('SET-cookie', 'only=one');
assert!(
  $replaced->toVec() == vec[
    ('Content-Type', 'text/plain'),
    ('SET-cookie', 'only=one'),
  ],
);

$added = $replaced->withAdded('Set-Cookie', 'second=two');
assert!($added->getAll('set-cookie') == vec['only=one', 'second=two']);

assert!(
  $added->without('SET-COOKIE')->toVec() == vec[('Content-Type', 'text/plain')],
);

$cookies = Collection::fromHeaders(
  FieldMap::from(vec[
    ('Cookie', 'SID=first; theme=dark'),
    ('cookie', 'SID=second; ignored; sid=lower'),
  ]),
);

assert!($cookies->has('SID'));
assert!($cookies->has('sid'));
assert!($cookies->get('SID') == 'first');
assert!($cookies->getAll('SID') == vec['first', 'second']);
assert!($cookies->get('missing') == null);
assert!($cookies->toString() == 'SID=first; theme=dark; SID=second; sid=lower');

$sessionCookie = SetCookie::fromParts(
  'session',
  'abc123',
  expires: Whim\Time\SystemTime::fromUnixTimestamp(784_111_777),
  maxAge: 3_600,
  path: '/',
  secure: true,
  httpOnly: true,
  sameSite: SameSite::Lax,
);

assert!(
  $sessionCookie->toString()
  == 'session=abc123; Expires=Sun, 06 Nov 1994 08:49:37 GMT; Max-Age=3600; Path=/; Secure; HttpOnly; SameSite=Lax',
);

$parsedCookie = SetCookie::parse(
  'session=parsed; Expires=Sun, 06 Nov 1994 08:49:37 GMT; Max-Age=120; '
  . 'Domain=.Example.COM; Path=/account; Secure; HttpOnly; SameSite=Strict',
);

assert!($parsedCookie is SetCookie);
assert!($parsedCookie?->name == 'session');
assert!($parsedCookie?->value == 'parsed');
assert!($parsedCookie?->expires?->seconds == 784_111_777);
assert!($parsedCookie?->maxAge == 120);
assert!($parsedCookie?->domain == 'example.com');
assert!($parsedCookie?->path == '/account');
assert!($parsedCookie?->secure);
assert!($parsedCookie?->httpOnly);
assert!($parsedCookie?->sameSite == SameSite::Strict);
assert!(SetCookie::parse('broken') == null);
assert!(SetCookie::parse('session=x; SameSite=None') == null);

$cookieResponse = Cookie\add(new Response(Message\STATUS_OK), $sessionCookie);
assert!(
  $cookieResponse->headers->getAll('Set-Cookie') == vec[
    $sessionCookie->toString(),
  ],
);

$assertion_value_37 = fn(): SetCookie => (
  SetCookie::fromParts('session', 'value', sameSite: SameSite::None)
);

$assertion_error_37 = null;
try {
  $assertion_value_37();
} catch (InvalidArgumentException $assertion_caught_37) {
  $assertion_error_37 = $assertion_caught_37;
}

assert!($assertion_error_37 is InvalidArgumentException);

$assertion_value_38 = fn(): SetCookie => (
  SetCookie::fromParts('__Host-session', 'value')
);

$assertion_error_38 = null;
try {
  $assertion_value_38();
} catch (InvalidArgumentException $assertion_caught_38) {
  $assertion_error_38 = $assertion_caught_38;
}

assert!($assertion_error_38 is InvalidArgumentException);

